       PROCEDURE DIVISION USING  BASE,
                                 SCREEN-PRINT-PARMS,
                                 PASS-SPOOL-PRT-NO,
                                 VIEW-COMAREA,
                                 MAIN-ARGUMENT-VALUES,
                                 SAVE-POINQ-AREA,
                                 LANGUAGE-PARMS.

       PO-INQUIRY SECTION 01.
       BEGIN-HERE.
           OPEN INPUT DPODATAITM-I, DPOITEM-I, DREQD-I, MPLTINFO-I,
               MSTORERM-I.
           OPEN I-O DISPLAY-FILE.

           PERFORM  1-HOUSEKEEPING THRU 1-H-X.
           PERFORM  6-DETERMINE-PO-TYPE  THRU
                    6-DETERMINE-PO-TYPE-X.

           CLOSE DPODATAITM-I, DPOITEM-I, DREQD-I, MSTORERM-I,
                 DISPLAY-FILE.
           GOBACK.

       1-HOUSEKEEPING.
           MOVE  66 TO LANG-SETNUM.
           MOVE 130 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO BCSF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  38 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CSF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  39 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO BSF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  40 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  41 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO BS-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  42 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO S-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  48 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO BCF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  49 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO BC-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  67 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  68 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO C-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  69 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO BF-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  70 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO B-REVIEW-MSG-TEXT.
           MOVE  16 TO LANG-SETNUM.
           MOVE  74 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO F-REVIEW-MSG-TEXT.
           MOVE   9 TO LANG-SETNUM.
           MOVE   1 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO NOT-FOUND-ITEM-MSG.
           MOVE   3 TO LANG-SETNUM.
           MOVE  21 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO NOT-FOUND-CORPCODE-MSG.
           MOVE   9 TO LANG-SETNUM.
           MOVE   2 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CAPACITY-EXCEEDED-MSG-TEXT.
           MOVE  55 TO LANG-SETNUM.
           MOVE  13 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CLASS-LIT.
           MOVE  04 TO LANG-SETNUM.
           MOVE  08 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO DEPT-LIT.
           MOVE  55 TO LANG-SETNUM.
           MOVE  15 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO EXPENSE-NW-LIT.
           MOVE  18 TO LANG-SETNUM.
           MOVE  38 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO REQ-NO-LIT.
           MOVE  19 TO LANG-SETNUM.
           MOVE  23 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO STD-INST-LIT.
           MOVE  14 TO LANG-SETNUM.
           MOVE  47 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO PRIMARY-LIT.
           MOVE  19 TO LANG-SETNUM.
           MOVE  25 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SECONDARY-LIT.
           MOVE  55 TO LANG-SETNUM.
           MOVE  23 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO UNIT-VALUE-LIT.
           MOVE  13 TO LANG-SETNUM.
           MOVE  46 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO MASTER-STOCK-LIT.

      ***********************************************************
      *    READ OF PCPO RECORD IN MPLTINFO IS DONE SO THAT      *
      *    PROGRAM CAN DECIDE WHETHER COMPANY AND PRIME ARE TO  *
      *    APPEAR ON THE ITEM SCREEN                            *
      ***********************************************************
028100     MOVE "PCPO"                   TO   PLT-ARG.
           MOVE 0 TO COND-WORD.
           MOVE PLT-ARG TO PLTINFOKEY OF MPLTINFO-REC-I.
           READ MPLTINFO-I INTO BUF-MPLTINFO
               INVALID KEY MOVE 17 TO COND-WORD.
           IF FILE-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD NOT = 0
               MOVE "N"                  TO   SAVE-PCPO-SW
           ELSE
           MOVE MPLTINFO-PCPO-SW         TO   SAVE-PCPO-SW.

      *------- CHECK TO SEE IF COMPLIANCE REQMTS NEED TO BE DISPLAYED.
           MOVE "MCFPCS7000"   TO  CHKOBJ-FILE-NAME.
           CALL "CCHKOBJ" USING    CHKOBJ-FILE-NAME,
                                   CHKOBJ-RETURN-STATUS.
           IF CHKOBJ-RETURN-STATUS  = "00"
               MOVE "Y"        TO  PRINT-DCOMPL-SW
           ELSE
               MOVE "N"        TO  PRINT-DCOMPL-SW.

       1-H-X.
           EXIT.

      ************************************************************
      ************************************************************
      *                    B L O W U P                           *
      *     CHECK FOR IMAGE, VIEW, OR SPOOL ERROR.  CLOSE        *
      *     FILES, GET OUT OF BLOCK MODE, AND DISPLAY            *
      *     APPROPRIATE ERROR MESSAGE ON SCREEN.                 *
      *                                                          *
      *     ALSO APPENDS THE ERROR MESSAGE TO A FILE CALLED      *
      *     BLOWUP.PUB.  TO READ THIS FILE, RUN "XBLPRT.OBJECT". *
      *                                                          *
      *         |||  PROGRAM IS ABORTED IN TBLOWUP  |||          *
      ************************************************************
      ************************************************************
       2-BLOWUP.
           MOVE "TPOINQI"        TO BU-PGM-NAME.
           MOVE VEN-ARG          TO BU-DISPLAY-FLD (1).
           MOVE PO-ARG           TO BU-DISPLAY-FLD (2).
           MOVE SAVE-ITEM-NUMBER TO BU-DISPLAY-FLD (3).
           MOVE REQ-ARG          TO BU-DISPLAY-FLD (4).
           IF FILE-STATUS NUMERIC
               MOVE FILE-STATUS TO COND-WORD.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS,  BU-DISPLAY-MSG,
                 BU-DISPLAY-FLDS.
       2-BLOWUP-X.
           EXIT.


       6-DETERMINE-PO-TYPE.
      **************************************************
      **  DETERMINE IF PO IS CODED OR NON-CODED.      **
      **************************************************

           IF SAVE-ITEM-NUMBER EQUAL ZERO
               MOVE "N"  TO  REQUEST-ITEM-SW
           ELSE
               MOVE "Y"  TO  REQUEST-ITEM-SW.

           IF SAVE-CORPCODE-MAIN EQUAL SPACE
               MOVE "N"  TO  REQUEST-CORPCODE-SW
           ELSE
               MOVE "Y"  TO  REQUEST-CORPCODE-SW.

      *****************************************************
      *                                                   *
      *    GET THE JCW  'PRICE'.                          *
      *    IF THE 'PRICE' JCW IS FOUND AND IS SET TO '1'  *
      *    THEN THE USER CAN SEE PRICING INFO.            *
      *                                                   *
      *****************************************************

      *******************************************
      **  ACCEPT LOCAL DATA AREA FOR JCW-ITONLY
      *******************************************

           ACCEPT MC-LOCAL-DATA-AREA FROM LOCAL-DATA-AREA.

      ********* 19JUN91 REPLACED THE FOLLOWING IF STMT.
      ********* SHOWING PRICE/COST BECOMES THE DEFAULT. DAP.
      ***  IF JCW-PRICE-258 = "1"
      ***      MOVE "Y"  TO PRICE-CAPABILITY-SW
      ***  ELSE
      ***      MOVE "N"    TO PRICE-CAPABILITY-SW.

           IF JCW-PRICE-258 = "0"
               MOVE "N"  TO PRICE-CAPABILITY-SW
           ELSE
               MOVE "Y"  TO PRICE-CAPABILITY-SW.

           MOVE PO-ARG                  TO BUILD-PO-KEY-VALUE.

           PERFORM 61-CHECK-FOR-MEMO-Z.

           PERFORM  61-PO-ITEMS  THRU  61-PO-ITEMS-X.

       6-DETERMINE-PO-TYPE-X.
           EXIT.


       61-CHECK-FOR-MEMO-Z.
           MOVE SPACE                   TO Z-BILL-STATUS.
           MOVE B-PO-NO                 TO PO-ARRAY.
           PERFORM 611-FIND-M VARYING PO-INDEX FROM 7 BY -1 UNTIL
             PO-INDEX = 0 OR MEMO-Z-BILL.

       611-FIND-M.
           IF PO-CHAR (PO-INDEX) = "M"
               MOVE "1" TO Z-BILL-STATUS
           ELSE
               IF PO-CHAR (PO-INDEX) NOT = SPACE
                   SET PO-INDEX TO 1.

       61-PO-ITEMS.
           MOVE "FPOINQSI"      TO  VIEW-NFNAME.

           MOVE SPACE              TO  DE-BUFFER1.
           MOVE SAVE-COMPANY       TO  DE1-CCD.
           MOVE B-PO-NO            TO  DE1-PO.
           MOVE B-PO-RLSE          TO  DE1-RLSE.
           MOVE "N"                TO  CONTINUED-SCREEN.
           MOVE SPACES             TO  SAVE-CONT-DSET,
                                       SAVE-ITEM-SEQ,
                                       ITEM-ADDRESS-TABLE.
           MOVE ZERO               TO  PAGE-SUB,
                                       LINE-SUB.

      **************************************************
      **  GET DPOITEM FOR PRICE, QTY, AND DATE DATA.  **
      **************************************************

           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           START DPOITEM-I KEY = PORCVNO OF DPOITEM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *            ***  PURCHASE ORDER CONTAINS NO ITEMS  ***
                   MOVE  16 TO LANG-SETNUM
                   MOVE  56 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO DE1-ITEM-LINE (3)
                   GO TO  61-WRITE-MSG-LINE
               ELSE
                   MOVE "FIND DPOITEM*61-PI"  TO  BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       61-GET-DPOITEM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPOITEM-I NEXT INTO BUF-DPOITEM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.

           IF COND-WORD EQUAL ZERO
               IF PAGE-SUB GREATER THAN 999
                   MOVE "N"  TO  REQUEST-ITEM-SW
                   ADD 1  TO  PAGE-SUB
                   MOVE CAPACITY-EXCEEDED-MSG  TO  DE1-ITEM-LINE (3)
                   GO TO  61-WRITE-MSG-LINE
               ELSE
                   ADD 1                TO  PAGE-SUB
                   MOVE ITM-NUMBER      TO  ITEM-ADDRESS (PAGE-SUB)
                   IF REQUEST-ITEM-SW EQUAL "Y"
                       IF ITM-NUMBER EQUAL SAVE-ITEM-NUMBER
                           MOVE "N"  TO  REQUEST-ITEM-SW
                       ELSE
                           IF ITM-NUMBER GREATER THAN SAVE-ITEM-NUMBER
                               MOVE SAVE-ITEM-NUMBER  TO  NF-ITEM-NUMBER
                               MOVE NOT-FOUND-ITEM-MSG
                                             TO  DE1-ITEM-LINE (3)
                               MOVE "N"  TO  REQUEST-ITEM-SW
                               MOVE "Y" TO ANOTHER-ITEM-SW
                               SUBTRACT 1 FROM PAGE-SUB
                               GO TO  61-WRITE-MSG-LINE-CONT
                           ELSE
                               GO TO  61-GET-DPOITEM-LOOP
                   ELSE
                       IF REQUEST-CORPCODE-SW EQUAL "Y"
                           IF ITM-CORP-CODE EQUAL SAVE-CORPCODE-MAIN
                               MOVE "N"  TO  REQUEST-CORPCODE-SW
                           ELSE
                               GO TO  61-GET-DPOITEM-LOOP
                       ELSE
                           NEXT SENTENCE
               ELSE
                   IF COND-WORD EQUAL 15
                       IF REQUEST-ITEM-SW EQUAL "Y"
                           MOVE SAVE-ITEM-NUMBER  TO  NF-ITEM-NUMBER
                           MOVE NOT-FOUND-ITEM-MSG
                                         TO  DE1-ITEM-LINE (3)
                           MOVE "N"  TO  REQUEST-ITEM-SW
                           ADD 1  TO  PAGE-SUB
                           GO TO  61-WRITE-MSG-LINE
                       ELSE
                           IF REQUEST-CORPCODE-SW EQUAL "Y"
                               MOVE SAVE-CORPCODE-MAIN  TO  NF-CORPCODE
                               MOVE NOT-FOUND-CORPCODE-MSG
                                             TO  DE1-ITEM-LINE (3)
                               MOVE "N"  TO  REQUEST-CORPCODE-SW
                               ADD 1  TO  PAGE-SUB
                               GO TO  61-WRITE-MSG-LINE
                           ELSE
                               GO TO  61-WRITE-MSG-LINE
                   ELSE
                       MOVE "GET5 DPOITEM*61-GDL" TO BU-DISPLAY-MSG
                       GO TO 2-BLOWUP.

       61-GATHER-ITEM-DATA.
           MOVE 1 TO LINE-SUB.
           MOVE SPACES  TO  DE1-ITEM-TABLE.
           MOVE "N"  TO  CONTINUED-SCREEN.
           MOVE SPACE  TO  ITEM-DETAIL.
           MOVE SPACE  TO  AR-COMP-2, AR-PRIME-2,
                           AR-SUB, AR-SUB-2,
                           AR-SUB-DETL, AR-SUB-DETL,
                           AR-ADDL-DATA, AR-ADDL-DATA-2,
                           AR-CHAT-NO,
                           AR-REQ-NO, AR-REQ-NO-2,
                           STD-INSTS-LIST-OUT.

           IF PAGE-SUB GREATER THAN 999
               MOVE "N" TO ANOTHER-ITEM-SW
               MOVE CAPACITY-EXCEEDED-MSG  TO  DE1-ITEM-LINE (3)
               GO TO  61-WRITE-MSG-LINE-CONT.

           IF ITM-CLASS = SPACES
               MOVE "***"               TO  AR-SUB
                                            AR-SUB-2
           ELSE
               MOVE ITM-CLASS           TO  AR-SUB
                                            AR-SUB-2.
           IF ITM-SUB-DETL = SPACES
               MOVE "****"              TO  AR-SUB-DETL
                                            AR-SUB-DETL-2
           ELSE
               MOVE ITM-SUB-DETL        TO  AR-SUB-DETL
                                            AR-SUB-DETL-2.
           IF ITM-ADDL-DATA = SPACES
               MOVE "*********"         TO  AR-ADDL-DATA
                                            AR-ADDL-DATA-2
           ELSE
               MOVE ITM-ADDL-DATA       TO  AR-ADDL-DATA
                                            AR-ADDL-DATA-2.
           IF ITM-CHAT-NO = SPACES
               MOVE "******"            TO  AR-CHAT-NO
           ELSE
           MOVE ITM-CHAT-NO             TO  AR-CHAT-NO.

           IF SAVE-PCPO-SW = "Y"
               MOVE ITM-COMPANY         TO  AR-COMP-2
               MOVE ITM-PRIME           TO  AR-PRIME-2.
           MOVE ITM-NUMBER              TO  DE1-ITEM-NUMBER.
           IF ITM-CORP-CODE = "NON-STR"
               MOVE SPACES              TO  CODE-ARG
               MOVE "NC"                TO  DE1-CORP-CODE
           ELSE
               MOVE ITM-CORP-CODE       TO  DE1-CORP-CODE,
                                            CODE-ARG.
           MOVE ITM-TAX-CODE            TO  DE1-TAX-CODE.
           IF ITM-CORP-CODE = "NON-STR"
               MOVE SPACES              TO  DE1-LANGUAGE-TYPE
           ELSE
               IF ITM-SECOND-DESC-INDIC = "X"
                   MOVE SECONDARY-LIT   TO  DE1-LANGUAGE-TYPE
               ELSE
                   MOVE PRIMARY-LIT     TO  DE1-LANGUAGE-TYPE.

           IF ITM-MASTER-STOCK = SPACES
               MOVE SPACES              TO  DE1-MASTER-STOCK-LIT,
                                            DE1-MASTER-STOCK
           ELSE
               MOVE MASTER-STOCK-LIT    TO  DE1-MASTER-STOCK-LIT
               MOVE ITM-MASTER-STOCK    TO  DE1-MASTER-STOCK.

           MOVE ITM-UNIT-PRICE     TO  DE1-ITEM-PRICE.
           IF DE1-ITEM-PRICE-D34  = "00"
               MOVE SPACES         TO  DE1-ITEM-PRICE-D34.

           MOVE ITM-PRICE-UM       TO  DE1-ITEM-PRICE-UM.

           IF PRICE-ALLOWED
               NEXT SENTENCE
           ELSE
               MOVE SPACES         TO  DE1-ITEM-PRICE-X,
                                       DE1-ITEM-PRICE-UM.

           IF NOT A-KELLY-PLANT
             MOVE ITM-QTY-ORD      TO  DE1-ITEM-QTY-ORD
           ELSE
             MOVE ITM-KELLY-PO-QTY TO  DE1-ITEM-QTY-ORD.
           IF DE1-ITEM-QTY-D12 = "00"   AND
              DE1-ITEM-QTY-D34 = "00"
               MOVE SPACES         TO  DE1-ITEM-QTY-DEC-DIG
           ELSE
               IF DE1-ITEM-QTY-D34 = "00"
                   MOVE SPACES     TO  DE1-ITEM-QTY-D34.

           IF NOT A-KELLY-PLANT
             MOVE ITM-UM             TO  DE1-ORD-UM
           ELSE
             MOVE ITM-KELLY-PO-UM    TO  DE1-ORD-UM.

           IF A-KELLY-PLANT
               IF ITM-QTY-ORD = ZERO OR ITM-KELLY-PO-QTY = ZERO
                   MOVE 1 TO KELLY-CF
               ELSE
                   DIVIDE ITM-QTY-ORD BY ITM-KELLY-PO-QTY
                     GIVING KELLY-CF ROUNDED.
           IF NOT A-KELLY-PLANT
               MOVE ITM-QTY-DLVR       TO  DE1-ITEM-QTY-DLV
           ELSE
               DIVIDE ITM-QTY-DLVR BY KELLY-CF
                 GIVING CHECK-QTY ROUNDED
               MOVE CHECK-QTY          TO  DE1-ITEM-QTY-DLV.
           IF DE1-ITEM-DLV-D12 = "00"   AND
              DE1-ITEM-DLV-D34 = "00"
               MOVE SPACES         TO  DE1-ITEM-DLV-DEC-DIG
           ELSE
               IF DE1-ITEM-DLV-D34 = "00"
                   MOVE SPACES     TO  DE1-ITEM-DLV-D34.

           IF NOT A-KELLY-PLANT
               MOVE ITM-QTY-STORED     TO  DE1-ITEM-QTY-STR
           ELSE
               DIVIDE ITM-QTY-STORED BY KELLY-CF
                 GIVING CHECK-QTY ROUNDED
               MOVE CHECK-QTY          TO  DE1-ITEM-QTY-STR.
           IF DE1-ITEM-STR-D12 = "00"   AND
              DE1-ITEM-STR-D34 = "00"
               MOVE SPACES         TO  DE1-ITEM-STR-DEC-DIG
           ELSE
               IF DE1-ITEM-STR-D34 = "00"
                   MOVE SPACES     TO  DE1-ITEM-STR-D34.

           IF ITM-DATE-RCVD EQUAL SPACE
               MOVE SPACE          TO  DE1-DATE-DLVR
           ELSE
               MOVE 4 TO DATE-MODE
               MOVE ITM-DATE-RCVD TO DATE-VALIDATE-IN
               CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
               MOVE DATE-SLASH-OUT TO DATE-WS
               MOVE DISPLAY-DATE TO DE1-DATE-DLVR.

           IF ITM-DATE-STORED EQUAL SPACE
               MOVE SPACE              TO  DE1-DATE-STOR
           ELSE
               MOVE 4 TO DATE-MODE
               MOVE ITM-DATE-STORED TO DATE-VALIDATE-IN
               CALL "TDATECK2" USING DATE-CHECK-AREA, LANGUAGE-PARMS
               MOVE DATE-SLASH-OUT TO DATE-WS
               MOVE DISPLAY-DATE TO DE1-DATE-STOR.

           MOVE ITEM-DETAIL         TO  DE1-ITEM-LINE (LINE-SUB).

      ***********************************************
      **  IF THIS IS A NON-CODED ITEM THEN SKIP
      **  LOGIC FOR 'CDESC'
      **  SINCE THIS DOESN'T APPLY TO NON-CODED ITEMS
      ***********************************************

           IF ITM-CORP-CODE = "NON-STR"
               GO TO 61-FIND-DPODATAITM.


       61-FIND-DDESC.
      **************************************************
      **  CALL CDESC FOR DESCRIPTION LINES.           **
      **************************************************

           IF ITM-SECOND-DESC-INDIC  =  "X"
               MOVE "S"                 TO  CDESC-LANGUAGE-OPTION
           ELSE
               MOVE "P"                 TO  CDESC-LANGUAGE-OPTION.
           CALL "CDESC" USING RET-CODE,
                              BASE,
                              STATUS-AREA,
                              BU-DISPLAY-MSG,
                              CODE-ARG,
                              CDESC-DATA.
           IF BU-DISPLAY-MSG-1  NOT = SPACES
               MOVE CODE-ARG            TO  BU-DISPLAY-FLD (5)
               GO TO 2-BLOWUP.

           IF CDESC-LINES-GOT  =  0
               ADD 1  TO  LINE-SUB
      *       *** NO DESCRIPTION ON FILE ***
               MOVE  14 TO LANG-SETNUM
               MOVE   3 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO DE1-ITEM-LINE (LINE-SUB)
               GO TO  61-FIND-DPODATAITM.

           MOVE ZEROS                   TO  DESC-SUB.

       61-GET-DESC-LOOP.
           ADD 1                        TO  DESC-SUB.
           IF DESC-SUB > CDESC-LINES-GOT
               GO TO 61-FIND-DPODATAITM.

           ADD 1  TO  LINE-SUB.

           IF LINE-SUB GREATER THAN 9
               MOVE "D"     TO  SAVE-CONT-DSET
               GO TO  61-WRITE-MSG-LINE
           ELSE
               MOVE CDESC (DESC-SUB)    TO  DE1-ITEM-LINE (LINE-SUB)
               GO TO  61-GET-DESC-LOOP.

       61-FIND-DPODATAITM.
      **************************************************
      **  GET DPODATAITM FOR DESC/COMMENT LINES.      **
      **************************************************

           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-I.
           START DPODATAITM-I KEY = PORCVNO OF DPODATAITM-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
      *************GO TO 61-PRINT-ITEM-VALUE
                   GO TO 61-PRINT-DCOMPL
               ELSE
                   MOVE "FIND DPODATAITM * 61-FD"  TO  BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

       61-GET-DPODATAITM-LOOP.
           MOVE 0 TO COND-WORD.
           READ DPODATAITM-I NEXT INTO BUF-DPODATAITM
               AT END MOVE 15 TO COND-WORD.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE 15 TO COND-WORD
               ELSE
                   MOVE 99 TO COND-WORD.
           IF PORCVNO OF DPODATAITM-REC-I NOT = PO-ARG
               MOVE 15 TO COND-WORD.
      *    CALL DBGET USING BASE,
      *                        DSET-DPODATAITM,
      *                        MODE5,
      *                        STATUS-AREA,
      *                        ALL-ITEMS,
      *                        BUF-DPODATAITM,
      *                        PO-ARG.
           IF COND-WORD EQUAL ZERO
               NEXT SENTENCE
           ELSE
               IF COND-WORD EQUAL 15
      *************GO TO  61-PRINT-ITEM-VALUE
                   GO TO  61-PRINT-DCOMPL
               ELSE
                   MOVE "GET5 DPODATAITM *61-GDL"  TO  BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.

           IF DATAITM-ITEM-NO EQUAL DE1-ITEM-NUMBER
               NEXT SENTENCE
           ELSE
           IF DATAITM-ITEM-NO  >  DE1-ITEM-NUMBER
      *********GO TO  61-PRINT-ITEM-VALUE
               GO TO  61-PRINT-DCOMPL
           ELSE
               GO TO  61-GET-DPODATAITM-LOOP.

           ADD 1      TO  LINE-SUB.

           IF LINE-SUB GREATER THAN 9
               MOVE "I"     TO  SAVE-CONT-DSET
               MOVE DATAITM-LINE TO SAVE-ITEM-SEQ
               GO TO  61-WRITE-MSG-LINE
           ELSE
               MOVE DATAITM-INFO  TO  DE1-ITEM-LINE (LINE-SUB)
               GO TO  61-GET-DPODATAITM-LOOP.

       61-PRINT-DCOMPL.
           IF PRINT-DCOMPL-SW = "Y"
               MOVE CODE-ARG       TO  CCRQDESC-CODE
               MOVE SPACES         TO  CCRQDESC-LINES
               CALL "CCRQDESC" USING CCRQDESC-PARMS
           ELSE
               GO TO 61-PRINT-ITEM-VALUE.
           IF CCRQDESC-LINES = SPACES
               GO TO 61-PRINT-ITEM-VALUE.
           MOVE 0                       TO  DCOMPL-SUB.

       61-DCOMPL-LOOP.
           ADD 1                        TO  DCOMPL-SUB.
           IF DCOMPL-SUB > 6 OR CCRQDESC-LINE (DCOMPL-SUB) = SPACES
               GO TO 61-PRINT-ITEM-VALUE.

           ADD 1  TO  LINE-SUB.

           IF LINE-SUB > 9
               MOVE "C"     TO  SAVE-CONT-DSET
               SUBTRACT 1   FROM DCOMPL-SUB
               GO TO  61-WRITE-MSG-LINE
           ELSE
               MOVE CCRQDESC-LINE (DCOMPL-SUB)
                                        TO  DE1-ITEM-LINE (LINE-SUB)
               GO TO  61-DCOMPL-LOOP.

       61-PRINT-ITEM-VALUE.
           IF MEMO-Z-BILL  AND  PRICE-ALLOWED
               ADD 1                    TO  LINE-SUB
               IF LINE-SUB > 9
                   MOVE "Z"             TO  SAVE-CONT-DSET
                   GO TO 61-WRITE-MSG-LINE
               ELSE
                   MOVE ITM-ZBILL-VALUE TO  DE1-ITEM-UNIT-VALUE
                   MOVE UNIT-VALUE-AREA TO  DE1-ITEM-LINE (LINE-SUB).

       61-PRINT-STD-INSTS.
           IF ITM-STD-INST = SPACES
               NEXT SENTENCE
           ELSE
               ADD 1                    TO  LINE-SUB
               IF LINE-SUB > 9
                   MOVE "S"             TO  SAVE-CONT-DSET
                   GO TO 61-WRITE-MSG-LINE
               ELSE
                   MOVE ITM-STD-INST    TO  STD-INST-TABLE
                   PERFORM 611-LOAD-STD-INSTS  THRU  611-LSI-X
                       VARYING INST-SUB FROM 1 BY 1
                           UNTIL INST-SUB > 4
                   MOVE STANDARD-INST-DATA TO DE1-ITEM-LINE (LINE-SUB).

      **********************************
      **  IF ITEM IS NON-CODED
      **  SKIP GET OF MSTORERM FOR CLASS
      **********************************

           IF ITM-CORP-CODE = "NON-STR"
               GO TO 61-FIND-REQ.

      *61-GET-MSTORERM.
      *    IF AR-SUB = "***"
      *        NEXT SENTENCE
      *    ELSE
      *        GO TO 61-FIND-REQ.

      **************************************************
      **  GET MSTORERM FOR STR CLASS IN ACCTING LINE. **
      **************************************************

      *    CALL "DBGET" USING  BASE,
      *                        DSET-MSTORERM,
      *                        MODE7,
      *                        STATUS-AREA,
      *                        ALL-ITEMS,
      *                        BUF-MSTORERM,
      *                        CODE-ARG.
      *    IF COND-WORD NOT EQUAL ZERO
      *        MOVE "GET7 MSTORERM*61-GM" TO BU-DISPLAY-MSG
      *        GO TO 2-BLOWUP.
      *
      *    IF STR-CLASS EQUAL SPACE
      *        MOVE "***"      TO  AR-SUB
      *    ELSE
      *        MOVE STR-CLASS  TO  AR-SUB.

      ****************************************************
      *    FIND REQ NUMBER AND MOVE TO ACCTING LINE      *
      ****************************************************
       61-FIND-REQ.
           PERFORM 63-FIND-REQ THRU 63-EXIT.

       61-PRINT-ACCTG-LINE.
           ADD 1  TO  LINE-SUB.

           IF LINE-SUB GREATER THAN 9
               MOVE "A"     TO  SAVE-CONT-DSET
               GO TO  61-WRITE-MSG-LINE.

           IF SAVE-PCPO-SW = "Y"
               MOVE ACCTING-REQ-DATA-2 TO DE1-ITEM-LINE (LINE-SUB)
           ELSE
           MOVE ACCTING-REQ-DATA       TO DE1-ITEM-LINE (LINE-SUB).

       61-WRITE-MSG-LINE.
           IF CONTINUED-SCREEN = "Y"
               GO TO 61-WRITE-MSG-LINE-CONT.
           MOVE "N" TO ANOTHER-ITEM-SW.
           READ DPOITEM-I NEXT
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE SPACES TO PORCVNO OF DPOITEM-REC-I
               ELSE
                   MOVE "READ DPOITEM *61-WML" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF PORCVNO OF DPOITEM-REC-I NOT = PO-ARG
               NEXT SENTENCE
           ELSE
               MOVE "Y" TO ANOTHER-ITEM-SW
               ADD 1 TO PAGE-SUB
               MOVE ITEMNO OF DPOITEM-REC-I TO ITEM-ADDRESS (PAGE-SUB)
               SUBTRACT 1 FROM PAGE-SUB.

       61-WRITE-MSG-LINE-CONT.
           IF LINE-SUB GREATER THAN 9
               IF PAGE-SUB GREATER THAN 1
                   IF ANOTHER-ITEM-SW = "Y"
                       IF CONTINUED-SCREEN EQUAL "Y"
                           MOVE BCSF-REVIEW-MSG  TO  DE1-MSG-LINE
                       ELSE
                           MOVE BCF-REVIEW-MSG  TO  DE1-MSG-LINE
                   ELSE
                       MOVE BC-REVIEW-MSG  TO  DE1-MSG-LINE
               ELSE
                   IF ANOTHER-ITEM-SW = "Y"
                       IF CONTINUED-SCREEN EQUAL "Y"
                           MOVE CSF-REVIEW-MSG  TO  DE1-MSG-LINE
                       ELSE
                           MOVE CF-REVIEW-MSG  TO  DE1-MSG-LINE
                   ELSE
                       MOVE C-REVIEW-MSG  TO  DE1-MSG-LINE
           ELSE
               IF PAGE-SUB GREATER THAN 1
                   IF ANOTHER-ITEM-SW = "Y"
                       IF CONTINUED-SCREEN EQUAL "Y"
                           MOVE BSF-REVIEW-MSG  TO  DE1-MSG-LINE
                       ELSE
                           MOVE BF-REVIEW-MSG  TO  DE1-MSG-LINE
                   ELSE
                       IF CONTINUED-SCREEN EQUAL "Y"
                           MOVE BS-REVIEW-MSG  TO  DE1-MSG-LINE
                       ELSE
                           MOVE B-REVIEW-MSG  TO  DE1-MSG-LINE
               ELSE
                   IF ANOTHER-ITEM-SW = "Y"
                       IF CONTINUED-SCREEN EQUAL "Y"
                           MOVE SF-REVIEW-MSG  TO  DE1-MSG-LINE
                       ELSE
                           MOVE F-REVIEW-MSG  TO  DE1-MSG-LINE
                   ELSE
                       IF CONTINUED-SCREEN EQUAL "Y"
                           MOVE S-REVIEW-MSG  TO  DE1-MSG-LINE
                       ELSE
                           MOVE SPACE  TO  DE1-MSG-LINE.

       61-PROCESS-FORM1.
      *-----DETERMINE TO DISPLAY "F4 FOR QS9000 TRACKING"
           IF ITM-QS9000-TRACK = "X"
              MOVE B"1" TO IND(1).

           MOVE DE-BUFFER1     TO DISPLAY-REC.
           PERFORM 998-WRITE-SCREEN THRU 998-READ-SCREEN.
           MOVE DISPLAY-REC    TO DE-BUFFER1.

           IF VIEW-LASTKEY EQUAL 3
               GO TO  61-PO-ITEMS-X.

           IF VIEW-LASTKEY EQUAL 1
               GO TO  61-PO-ITEMS-X.

           IF VIEW-LASTKEY EQUAL 2
               IF CONTINUED-SCREEN EQUAL "Y"
                   GO TO  61-GET-DPOITEM-CALC
               ELSE
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO FIELD-NUMBER
                   PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
                   GO TO  61-PROCESS-FORM1.

           IF VIEW-LASTKEY EQUAL 4
               IF LINE-SUB GREATER THAN 9
                   GO TO  61-DETERMINE-CONT-DATASET
               ELSE
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO FIELD-NUMBER
                   PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
                   GO TO  61-PROCESS-FORM1.

           IF VIEW-LASTKEY EQUAL 5
               IF ITM-QS9000-TRACK = "X"
                   MOVE "D" TO TRAK-FUNCTION
                   CALL "SRCVTRAK" USING ITM-PO-RCV-NO
                                         ITM-NUMBER
                                         VEN-ARG
                                         ITM-CORP-CODE
                                         TRAK-FUNCTION
                                         ITM-QTY-ORD
                   GO TO  61-PROCESS-FORM1
               ELSE
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO FIELD-NUMBER
                   PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
                   GO TO  61-PROCESS-FORM1.

           IF VIEW-LASTKEY EQUAL 6
               IF PAGE-SUB GREATER THAN 1
                   SUBTRACT 1  FROM  PAGE-SUB
                   GO TO  61-GET-DPOITEM-CALC
               ELSE
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO FIELD-NUMBER
                   PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
                   GO TO  61-PROCESS-FORM1.

           IF VIEW-LASTKEY EQUAL 7
               IF ANOTHER-ITEM-SW = "Y"
                   ADD 1 TO PAGE-SUB
                   GO TO  61-GET-DPOITEM-CALC
               ELSE
      *            ***  INVALID FUNCTION KEY ENTERED  ***
                   MOVE   9 TO LANG-SETNUM
                   MOVE  10 TO LANG-MSGNUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE 99 TO FIELD-NUMBER
                   PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X
                   GO TO  61-PROCESS-FORM1.

           IF VIEW-LASTKEY EQUAL 5  OR
              VIEW-LASTKEY EQUAL 8
      *        ***  INVALID FUNCTION KEY ENTERED  ***
               MOVE   9 TO LANG-SETNUM
               MOVE  10 TO LANG-MSGNUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 99  TO  FIELD-NUMBER
               PERFORM  73-PGM-ERROR  THRU 73-PGM-ERROR-X
               GO TO  61-PROCESS-FORM1.

      *    ***  PRESS DESIRED FUNCTION KEY - NOT 'ENTER'  ***
           MOVE  16 TO LANG-SETNUM.
           MOVE  30 TO LANG-MSGNUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE 99 TO FIELD-NUMBER.
           PERFORM  73-PGM-ERROR   THRU  73-PGM-ERROR-X.
           GO TO  61-PROCESS-FORM1.

       61-DETERMINE-CONT-DATASET.
           MOVE SPACE  TO  DE1-ITEM-TABLE.
           MOVE "Y"  TO  CONTINUED-SCREEN.

           IF SAVE-CONT-DSET EQUAL "D"
               MOVE ZERO                TO   LINE-SUB
               SUBTRACT 1               FROM DESC-SUB
               GO TO  61-GET-DESC-LOOP
           ELSE
           IF SAVE-CONT-DSET EQUAL "I"
               GO TO  61-GET-DPODATAITM-CALC
           ELSE
           IF SAVE-CONT-DSET EQUAL "Z"
               MOVE ZEROS               TO  LINE-SUB
               GO TO  61-PRINT-ITEM-VALUE
           ELSE
           IF SAVE-CONT-DSET EQUAL "S"
               MOVE ZEROS               TO  LINE-SUB
               GO TO  61-PRINT-STD-INSTS
           ELSE
           IF SAVE-CONT-DSET EQUAL "A"
               MOVE ZEROS               TO  LINE-SUB
               GO TO  61-PRINT-ACCTG-LINE
           ELSE
           IF SAVE-CONT-DSET EQUAL "C"
               MOVE ZEROS               TO  LINE-SUB
               GO TO  61-DCOMPL-LOOP
           ELSE
               MOVE "ITEM CONTINUATION*61-DCD"  TO  BU-DISPLAY-MSG
               GO TO 2-BLOWUP.

       61-GET-DPOITEM-CALC.
           MOVE PO-ARG TO PORCVNO OF DPOITEM-REC-I.
           MOVE ITEM-ADDRESS (PAGE-SUB)  TO  ITEMNO OF DPOITEM-REC-I.
           READ DPOITEM-I INTO BUF-DPOITEM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GET4 DPOITEM*61-GDC"  TO  BU-DISPLAY-MSG
               GO TO 2-BLOWUP
           ELSE
               GO TO 61-GATHER-ITEM-DATA.

       61-GET-DPODATAITM-CALC.
           MOVE PO-ARG TO PORCVNO OF DPODATAITM-REC-I.
           MOVE SAVE-ITEM-SEQ TO ITEMSEQNO OF DPODATAITM-REC-I.
           READ DPODATAITM-I INTO BUF-DPODATAITM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE "GET4 DPODATAITM"  TO  BU-DISPLAY-MSG
               MOVE SAVE-ITEM-SEQ      TO  BU-DISPLAY-FLD (5)
               GO TO 2-BLOWUP.

           MOVE ZERO  TO  LINE-SUB.

           IF DATAITM-ITEM-NO EQUAL DE1-ITEM-NUMBER
               ADD 1  TO  LINE-SUB
               MOVE DATAITM-INFO  TO  DE1-ITEM-LINE (LINE-SUB).

           GO TO  61-GET-DPODATAITM-LOOP.

       61-PO-ITEMS-X.
           EXIT.


       611-LOAD-STD-INSTS.
           MOVE STD-INST-ENTRIES (INST-SUB)
                                        TO STD-INST-OUT (INST-SUB).

       611-LSI-X.
           EXIT.



      *************************************************************
      *      FIND REQ NUMBER AND MOVE IT TO ACCTING LINE          *
      *************************************************************
       63-FIND-REQ.
           MOVE ALL "*" TO AR-REQ-NO.
           MOVE PO-ARG TO PORCVNO OF DREQD-REC-I.
           START DREQD-I KEY = PORCVNO OF DREQD-REC-I
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS-1 = "2"
                   GO TO 63-EXIT
               ELSE
                  MOVE "FIND DREQD* 63-FR" TO BU-DISPLAY-MSG
                  GO TO 2-BLOWUP.

       63-FIND-REQ-LOOP.
           READ DREQD-I NEXT INTO BUF-DREQD
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14"
                   GO TO 63-EXIT
               ELSE
                   MOVE "GET DREQD *63-FRL" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
           IF PORCVNO OF DREQD-REC-I NOT = PO-ARG
               GO TO 63-EXIT.

           IF DREQD-PO-ITM-NO = DE1-ITEM-NUMBER
               MOVE DREQD-REQ-NUMBER TO AR-REQ-NO
           ELSE
               GO TO 63-FIND-REQ-LOOP.

       63-EXIT.
           EXIT.

       73-PGM-ERROR.
           MOVE B"1"   TO IND (FIELD-NUMBER) IND (99).
           MOVE MESSAGE-BUFFER TO DE1-MESSAGE-LINE.

       73-PGM-ERROR-X.
           EXIT.

       COPY DISPCALL IN COPYLIB.

       999-CATREAD.
           IF CATREAD-MSG-NUMBER = ZEROS
               MOVE LANG-SETNUM TO CATREAD-MSG-SET
               MOVE LANG-MSGNUM TO CATREAD-MSG-NUM.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
       999-CATREAD-EXIT.
           EXIT.
