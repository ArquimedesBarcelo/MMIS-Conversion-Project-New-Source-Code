       IDENTIFICATION DIVISION.
       PROGRAM-ID.    TPOINQI.
       AUTHOR.        LS BAKER/MOVSESIAN/JIM COFFMAN.
       DATE-WRITTEN.  JUNE 29, 1983.

      *****************************************************************
      *   SUBROUTINE THAT SHOWS PURCHASE ORDER ITEM INFO
      *****************************************************************


      *****************************************************************
      **          M O D I F I C A T I O N    H I S T O R Y
      *****************************************************************
      *C   SEPT. 94   JE COFFMAN  REQ #6527
      *C   ADDED LOGIC TO DISPLAY THE CHAT NUMBER IF THE USER
      *C   HAS SELECTED THE OPTION TO INCLUDE CHAT NUMBERS WITH
      *C   CSIS CORPORATE CODED ITEMS.
      *C
      *C   JUNE 10, 1996  JEFF BUNGO
      *C   EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C   RECOMPILE TO PICK UP NEW DATE FORMATS.
      *C
      *C   11/20/96  JEFF BUNGO
      *C   IF QS9000-TRACKING ITEM THEN DISPLAY F5 INSTRUCTIONS
      *C   AND ALLOW F5 TO DISPLAY TRACKING SCREEN.
      *C
      *C   04/03/2002    CA YODER     NAPANEE REQUEST
      *C   ADDED CALL TO "CCRQDESC" TO DISPLAY COMPLIANCE
      *C   REQUIREMENTS ON THE SCREEN, IF ANY EXIST.
      *C
      *C   12/31/2003    GEISER
      *C   ADDED ITEM NUMBER ON BLOWUP CALL FOR DEBUGGING.
      *C---------------------------------------------------------------
      *C MAR 10, 2005  D.RAUCH       DCR01    REQUEST# 2005-78515
      *C    DISPLAY FILE PROCESSING CHANGED FROM USING ZCSISINQ
      *C    NEW DISPLAY FILE ZTPOINQI  CREATED - FORMATS COPIED
      *C    FROM ZCSISINQ.
      *C---------------------------------------------------------------
      *C MMM DD, CCYY  XXXNAMEXXX    XXX01    REQUEST# 2005-XXXXX
      *C    XXXXXXXXXXXXXXXXXX DESC XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
      *****************************************************************


       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER. IBM-AS400.
       OBJECT-COMPUTER. IBM-AS400.

       SPECIAL-NAMES.
           LOCAL-DATA IS LOCAL-DATA-AREA
           I-O-FEEDBACK IS I-O-FEEDBACK-AREA.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DPODATAITM-I
               ASSIGN TO DATABASE-MCFLCS1101
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DPOITEM-I
               ASSIGN TO DATABASE-MCFLCS1002
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT DREQD-I
               ASSIGN TO DATABASE-MCFLCS2102
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                   WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MPLTINFO-I
                  ASSIGN TO DATABASE-MCFLCS0501
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZTPOINQI-SI
               ORGANIZATION IS TRANSACTION
               CONTROL-AREA IS WS-CONTROL
               FILE STATUS IS DISPLAY-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  DPODATAITM-I
           LABEL RECORDS ARE STANDARD.
       01  DPODATAITM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS1101.

       FD  DPOITEM-I
           LABEL RECORDS ARE STANDARD.
       01  DPOITEM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS1002.

       FD  DREQD-I
           LABEL RECORDS ARE STANDARD.
       01  DREQD-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS2102.

       FD  MPLTINFO-I
           LABEL RECORDS ARE STANDARD.
       01  MPLTINFO-REC-I.
           COPY DDS-ALL-FORMATS  OF MCFLCS0501.

       FD  MSTORERM-I
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC-I.
           COPY DDS-ALL-FORMATS OF MCFLCS0201.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC                  PIC X(2000).

       WORKING-STORAGE SECTION.
       77  SAVE-PCPO-SW                 PIC X.
       77  TRAK-FUNCTION                PIC X VALUE "D".
       77  PRINT-DCOMPL-SW              PIC X VALUE "N".

       01  FILE-STATUS.
           05  FILE-STATUS-1            PIC X  VALUE "0".
           05  FILE-STATUS-2            PIC X  VALUE "0".

       01  Z-BILL-STATUS             PIC X      VALUE SPACE.
           88  MEMO-Z-BILL                      VALUE "1".

       01  PO-ARRAY.
           05  PO-ARR OCCURS 7 INDEXED BY PO-INDEX.
               10  PO-CHAR              PIC X.

       01  PLT-NUMBER.
           05  PLT-DIGIT-1              PIC X.
               88  A-KELLY-PLANT                  VALUE "2".
           05  FILLER                   PIC X(2).
       01  KELLY-CF                     PIC S9(8)V9(4).
       01  CHECK-QTY                    PIC S9(8)V9(4).

      **********************************************
      *                                            *
      *   JCW PARAMETERS                           *
      *                                            *
      **********************************************

       COPY JCWAREA IN COPYLIB.

       01  PRICE-CAPABILITY-SW     PIC X      VALUE SPACES.
           88  PRICE-ALLOWED                  VALUE "Y".

       COPY TBLOWUP IN COPYLIB.

