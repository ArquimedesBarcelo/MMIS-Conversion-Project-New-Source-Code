       IDENTIFICATION DIVISION.
       PROGRAM-ID.             SPWOQUE.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE & RUBBER CO.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          REQUESTOR      IS WORK-STATION
                               SYSTEM-CONSOLE IS CONSOLE
                               LOCAL-DATA     IS LOCAL-DATA-AREA
                               C01            IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED-ST
                  ASSIGN       TO DATABASE-MCFLMM1102
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-PLANNED-WO
                  ASSIGN       TO DATABASE-MCFLMM1101
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-STATUS-FILE
                  ASSIGN       TO DATABASE-MCFLMM0401
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZPWOQUE-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-PWOQUE
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

           SELECT PRINT-FILE
                  ASSIGN       TO PRINTER-MCPRT
                  FILE STATUS  IS FILE-STAT.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-ZONE-PRTY
           LABEL RECORDS ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  WO-PLANNED-ST
           LABEL RECORDS ARE STANDARD.
       01  PWOST-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1102.

       FD  WO-PLANNED-WO
           LABEL RECORDS ARE STANDARD.
       01  PWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1101.

       FD  WO-STATUS-FILE
           LABEL RECORDS ARE STANDARD.
       01  WOSTATUS-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0401.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-LAST-NUM-USED-REC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD CONTAINS 64 CHARACTERS
           LABEL RECORDS ARE OMITTED
           DATA RECORD IS OUT-REC.
       01  OUT-REC.
           05  OUT-WO-QUEUE    PIC 9(02).
           05  OUT-FILLER      PIC X(01).
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-STATUS      PIC X(02).
           05  OUT-DESC        PIC X(30).
           05  OUT-EQUIP       PIC X(06).
           05  OUT-DATE.
               10  OUT-CC      PIC X(02).
               10  OUT-YY      PIC X(02).
               10  OUT-MM      PIC X(02).
               10  OUT-DD      PIC X(02).
           05  OUT-IND         PIC X(01).
           05  OUT-ZONE        PIC X(04).

       SD  SORT-FILE RECORD CONTAINS 64 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           05  SORT-WO-QUEUE   PIC 9(02).
           05  SORT-FILLER     PIC X(01).
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-STATUS     PIC X(02).
           05  SORT-DESC       PIC X(30).
           05  SORT-EQUIP      PIC X(06).
           05  SORT-DATE.
               10  SORT-CC     PIC X(02).
               10  SORT-YY     PIC X(02).
               10  SORT-MM     PIC X(02).
               10  SORT-DD     PIC X(02).
           05  SORT-IND        PIC X(01).
           05  SORT-ZONE       PIC X(04).

       FD  PRINT-FILE
           LABEL RECORD        IS OMITTED
           RECORD CONTAINS     79 CHARACTERS.
       01  PRINT-REC           PIC X(79).

       WORKING-STORAGE SECTION.
       77  ARG-NO              PIC  9(9).
       77  ACT-KEY             PIC  9(08)  VALUE 0.
       77  MAX-KEY             PIC  9(08)  VALUE 0.
       77  PAGE-KEY            PIC S9(08)  VALUE 0.
       77  EOF-SW              PIC  9      VALUE 0.
       77  ERROR-SW            PIC  9      VALUE 0.
       77  DISPLAY-SW          PIC  9      VALUE 0.
       77  SUB                 PIC  9(08)  VALUE 0.
       77  STATUS-KEY          PIC  X(02)  VALUE "  ".
       77  WONUM-KEY           PIC  X(10)  VALUE SPACES.
       77  JCW-ZONE            PIC  XXXX   VALUE SPACES.
       77  ZONE-SORT           PIC  XXXX   VALUE SPACES.
       77  QUEUE-PRTY          PIC  9      VALUE ZEROS.
       77  FILE-SW             PIC  X(01)  VALUE "P".
       77  LINE-CTR            PIC  99     VALUE 60.
       77  PAGE-CTR            PIC  99     VALUE 0.
       77  PRINT-SW            PIC  9      VALUE 0.
           88  PRINT-SWITCH-IS-OFF         VALUE 0.
       77  DASH-LINE           PIC  X(79)  VALUE ALL "-".
       77  SCREEN-SAVE         PIC  X(1042).
       77  TRUE-VAL            PIC  1      VALUE B"1".

       01  FILE-STAT.
           05  FILE-STAT-1     PIC  X      VALUE "0".
           05  FILE-STAT-2     PIC  X      VALUE "0".

       01  DATE-BUFFERS.
           05  DATE-DISP.
               10  DD-MM       PIC XX.
               10  SLASH1      PIC X.
               10  DD-DD       PIC XX.
               10  SLASH2      PIC X.
               10  DD-YY       PIC XX.
           05  DATE-MOVE.
               10  DM-CC       PIC XX.
               10  DM-YY       PIC XX.
               10  DM-MM       PIC XX.
               10  DM-DD       PIC XX.

       01  SCREEN-DATA.
           05  VZONE           PIC  X(04).
           05  VSORT           PIC  X(12).
           05  VLINES          OCCURS 14 TIMES.
               10  VQF         PIC  X(02).
               10  VIN         PIC  X(01).
               10  VWO         PIC  X(10).
               10  VST         PIC  X(02).
               10  VDES        PIC  X(30).
               10  VEQP        PIC  X(06).
               10  IP-SD-DATE.
                   15  DT-MM   PIC  X(02).
                   15  FILL1   PIC  X(01).
                   15  DT-DD   PIC  X(02).
                   15  FILL2   PIC  X(01).
                   15  DT-YY   PIC  X(02).
                   15  FILL3   PIC  X(01).
                   15  IS-IND  PIC  X(02).
           05  CMDMSG          PIC  X(79).
           05  ERRMSG          PIC  X(79).

       01  ZONE-SCREEN-DATA.
           05  ZONE-BUF        PIC  XXXX.
           05  STAT-SEL.
               10  STAT-OO     PIC  X.
               10  STAT-HA     PIC  X.
               10  STAT-IP     PIC  X.
               10  STAT-HL     PIC  X.
               10  STAT-SD     PIC  X.
               10  STAT-HM     PIC  X.
               10  STAT-HS     PIC  X.
               10  STAT-OTHER.
                   15  ST-O1   PIC  XX.
                   15  ST-O2   PIC  XX.
                   15  ST-O3   PIC  XX.
                   15  ST-O4   PIC  XX.
                   15  ST-O5   PIC  XX.
           05  PM-SW           PIC  X.
           05  PMO-SW          PIC  X.
           05  SORT-SEL.
               10  SORT1       PIC  X.
               10  SORT2       PIC  X.
               10  SORT3       PIC  X.
               10  SORT4       PIC  X.
           05  CMDMSG1         PIC  X(79).
           05  ERRMSG1         PIC  X(79).

       01  STATUS-CHECK.
           05  CHK-OO          PIC  XX.
           05  CHK-HA          PIC  XX.
           05  CHK-IP          PIC  XX.
           05  CHK-HL          PIC  XX.
           05  CHK-SD          PIC  XX.
           05  CHK-HM          PIC  XX.
           05  CHK-HS          PIC  XX.

       01  DATE-HEADER.
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "DATE:  ".
           05  P-DATE.
               10  P-DATE-MM   PIC X(02)  VALUE SPACES.
               10  FILLER      PIC X(01)  VALUE "/".
               10  P-DATE-DD   PIC X(02)  VALUE SPACES.
               10  FILLER      PIC X(01)  VALUE "/".
               10  P-DATE-YY   PIC X(02)  VALUE SPACES.
           05  FILLER          PIC X(10) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE "TIME:  ".
           05  P-TIME          PIC X(08) VALUE SPACES.
           05  FILLER          PIC X(12) VALUE SPACES.
           05  FILLER          PIC X(05) VALUE "PAGE:".
           05  ZPAGE           PIC ZZZ   VALUE SPACES.
           05  FILLER          PIC X(10) VALUE SPACES.

       01  TITLE-HEADER.
           05  FILLER          PIC X(20) VALUE "  P L A N N E D   W ".
           05  FILLER          PIC X(20) VALUE "O R K O R D E R   Q ".
           05  FILLER          PIC X(20) VALUE "U E U E   F O R   Z ".
           05  FILLER          PIC X(08) VALUE "O N E   ".
           05  P-ZONE          PIC X(04) VALUE SPACES.
           05  FILLER          PIC X(07) VALUE SPACES.

       01  SORT-HEADER.
           05  FILLER          PIC X(20) VALUE "QUEUE               ".
           05  FILLER          PIC X(20) VALUE "   LIST SORTED BY:  ".
           05  P-SORT          PIC X(12) VALUE SPACES.
           05  FILLER          PIC X(06) VALUE SPACES.
           05  FILLER          PIC X(21) VALUE "        IP SD OR CW  ".

       01  TEXT-HEADER.
           05  FILLER          PIC X(20) VALUE "FACTOR  WO NUMBER  S".
           05  FILLER          PIC X(20) VALUE "TATUS  DESCRIPTION  ".
           05  FILLER          PIC X(20) VALUE "                  EQ".
           05  FILLER          PIC X(19) VALUE "UIP.   DATE        ".

       01  PRINT-LINE.
           05  FILLER          PIC X     VALUE SPACE.
           05  P-QF            PIC 99.
           05  FILLER          PIC X(05) VALUE SPACE.
           05  P-WO            PIC X(10).
           05  FILLER          PIC X(03) VALUE SPACE.
           05  P-STAT          PIC X(02).
           05  FILLER          PIC X(03) VALUE SPACE.
           05  P-DESC          PIC X(30).
           05  FILLER          PIC X(02) VALUE SPACE.
           05  P-EQP           PIC X(06).
           05  FILLER          PIC X(02) VALUE SPACE.
           05  P-DATE-IND.
               10  P-DATE1     PIC X(08).
               10  P-FILL      PIC X(01).
               10  P-IND       PIC X(02).
           05  FILLER          PIC X(02) VALUE SPACE.

       01  CUR-DATE.
           05  CUR-YY          PIC X(02).
           05  CUR-MM          PIC X(02).
           05  CUR-DD          PIC X(02).

       01  TIME-BUFFER.
           05  TIME-BUF.
               10  HRS         PIC XX.
               10  MIN         PIC XX.
               10  SEC         PIC XX.
           05  TIME-EXP.
               10  TIME-H      PIC XX.
               10  FILLER      PIC X  VALUE ":".
               10  TIME-M      PIC XX.
               10  FILLER      PIC X  VALUE ":".
               10  TIME-S      PIC XX.

       01  RIME-NO.
           05  RIME-X          PIC  XX.
           05  RIME-9          REDEFINES RIME-X    PIC  99.

       01  ZONE-ARGUMENT.
           05  Z-ARG           PIC  X(4).
           05  FILLER          PIC  XX   VALUE "1 ".

       01  DB-ERROR.
           05  DB-FUNC         PIC  X(10) VALUE SPACES.
           05  DB-FILE         PIC  X(18) VALUE SPACES.
           05  FILLER          PIC  X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD        PIC  XX.

           COPY SCREENIO       IN COPYLIB.

           COPY ERRORLIN       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-STATUS-DATA.
           COPY MWOSTAT        IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-PROC              SECTION 01.
       BEGIN.
           MOVE SPACES         TO WO-BASIC-DATA
                                  WO-PLANNED-DATA.
           MOVE "P"            TO FILE-SW.
           MOVE 3              TO DATE-FLAG.
           CALL "CLPWOQUE".
           OPEN I-O            DISPLAY-FILE.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          WO-PLANNED-ST.
           OPEN INPUT          WO-PLANNED-WO.
           OPEN INPUT          WO-STATUS-FILE.
           ACCEPT              MC-LOCAL-DATA-AREA
               FROM            LOCAL-DATA-AREA.
      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.

           OPEN INPUT          WO-LAST-NUM-USED.
           MOVE SPACES         TO LAST-WO-USED-DATA.
           MOVE 1              TO DATE-FLAG-SW ARG-NO.
           READ WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           MOVE PLANT-IDENT    TO PLANT-NUMBER.
           MOVE DATE-FLAG-SW   TO DATE-FLAG.
           CLOSE               WO-LAST-NUM-USED.

       1-SELECT-SCREEN.
           MOVE 0              TO PRINT-SW
                                  ACT-KEY MAX-KEY EOF-SW
                                  PAGE-KEY ERROR-SW.
           MOVE SPACES         TO ZONE-SCREEN-DATA MESSAGE-BUFFER.
           MOVE JCW-ZJCW-269   TO ZONE-BUF Z-ARG
           MOVE "X"            TO STAT-SD STAT-IP SORT1.
           MOVE ZONE-ARGUMENT  TO ZONE-DATA.
           MOVE "VPWOQSEL"     TO SCREEN-NAME.

       1-SHOWFORM.
           IF ZONE-BUF NOT = "    " AND ERROR-SW = 0
               MOVE TRUE-VAL   TO IND(2).
           MOVE 0              TO ERROR-SW.
           MOVE ZONE-SCREEN-DATA TO DISPLAY-REC.
           MOVE "00"           TO SCREEN-STATUS.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.
           MOVE DISPLAY-REC    TO ZONE-SCREEN-DATA.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 5
               GO TO 1-SELECT-SCREEN.

           IF KEY-HIT NOT = 0
               GO TO 1-SHOWFORM.

           IF ZONE-BUF = SPACES
      **********************************************************************
      **    MESSAGE 052/001:
      ** ZONE IS REQUIRED
      **********************************************************************
               MOVE  52        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE 1          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               MOVE 1          TO ERROR-SW
               GO TO 1-SHOWFORM.

           IF ZONE-BUF = "ALL " OR " ALL"
               MOVE "ALL "     TO ZONE-BUF ZONE-FIELD
               MOVE ZONE-BUF   TO Z-ARG
               GO TO CONT-ZONE.

           MOVE ZONE-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/044:
      ** INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE 1          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               MOVE 1          TO ERROR-SW
               GO TO 1-SHOWFORM.

       CONT-ZONE.
           MOVE ZONE-FIELD     TO JCW-ZONE.
           IF JCW-ZONE = "ALL "
               MOVE "    "     TO JCW-ZONE.

           MOVE JCW-ZONE       TO JCW-ZJCW-269 SETJCW-VALUE.
           MOVE 269            TO SETJCW-STARTING-POS.
           MOVE 4              TO SETJCW-LENGTH.
           CALL "SETJCW"       USING SETJCW-VALUE,
                               SETJCW-STARTING-POS,
                               SETJCW-LENGTH,
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "    "     TO JCW-ZJCW-269.

           IF STAT-OO  NOT = SPACE MOVE "X" TO STAT-OO.
           IF STAT-IP  NOT = SPACE MOVE "X" TO STAT-IP.
           IF STAT-SD  NOT = SPACE MOVE "X" TO STAT-SD.
           IF STAT-HS  NOT = SPACE MOVE "X" TO STAT-HS.
           IF STAT-HA  NOT = SPACE MOVE "X" TO STAT-HA.
           IF STAT-HL  NOT = SPACE MOVE "X" TO STAT-HL.
           IF STAT-HM  NOT = SPACE MOVE "X" TO STAT-HM.
           IF PM-SW    NOT = SPACE MOVE "X" TO PM-SW.
           IF PMO-SW   NOT = SPACE MOVE "X" TO PMO-SW.
           IF SORT1    NOT = SPACE MOVE "X" TO SORT1.
           IF SORT2    NOT = SPACE MOVE "X" TO SORT2.
           IF SORT3    NOT = SPACE MOVE "X" TO SORT3.
           IF SORT4    NOT = SPACE MOVE "X" TO SORT4.

           IF SORT-SEL = SPACES
               MOVE "X"        TO SORT1.

           IF ST-O1 = "FF"     MOVE "  " TO ST-O1.
           IF ST-O2 = "FF"     MOVE "  " TO ST-O2.
           IF ST-O3 = "FF"     MOVE "  " TO ST-O3.
           IF ST-O4 = "FF"     MOVE "  " TO ST-O4.
           IF ST-O5 = "FF"     MOVE "  " TO ST-O5.

           IF STAT-SEL = SPACES
      **********************************************************************
      **    MESSAGE 041/025:
      ** ONE FIELD MUST BE SELECTED
      **********************************************************************
               MOVE  41        TO CATREAD-MSG-SET
               MOVE  25        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE 2          TO FIELD-NUMBER
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM.

           IF STAT-OTHER = SPACES
               GO TO 6-MAIN.

           IF ST-O1 = "**"     MOVE "FF" TO ST-O1.
           IF ST-O2 = "**"     MOVE "FF" TO ST-O2.
           IF ST-O3 = "**"     MOVE "FF" TO ST-O3.
           IF ST-O4 = "**"     MOVE "FF" TO ST-O4.
           IF ST-O5 = "**"     MOVE "FF" TO ST-O5.

           IF ST-O1 NOT = SPACES
               IF ST-O1 = ST-O2
                   MOVE SPACES TO ST-O2
                   IF ST-O1 = ST-O3
                       MOVE SPACES TO ST-O3
                       IF ST-O1 = ST-O4
                           MOVE SPACES TO ST-O4
                           IF ST-O1 = ST-O5
                               MOVE SPACES TO ST-O5.

           IF ST-O2 NOT = SPACES
               IF ST-O2 = ST-O3
                   MOVE SPACES TO ST-O3
                   IF ST-O2 = ST-O4
                       MOVE SPACES TO ST-O4
                       IF ST-O2 = ST-O5
                           MOVE SPACES TO ST-O5.

           IF ST-O3 NOT = SPACES
               IF ST-O3 = ST-O4
                   MOVE SPACES TO ST-O4
                   IF ST-O3 = ST-O5
                       MOVE SPACES TO ST-O5.

           IF ST-O4 NOT = SPACES
               IF ST-O4 = ST-O5
                   MOVE SPACES TO ST-O5.

           IF ST-O1 NOT = SPACES
               MOVE ST-O1      TO STATUS-KEY
               MOVE 3          TO FIELD-NUMBER
               PERFORM 11-EDIT-STAT THRU 11-ES-EXIT.

           IF ST-O2 NOT = SPACES
               MOVE ST-O2      TO STATUS-KEY
               MOVE 4          TO FIELD-NUMBER
               PERFORM 11-EDIT-STAT THRU 11-ES-EXIT.

           IF ST-O3 NOT = SPACES
               MOVE ST-O3      TO STATUS-KEY
               MOVE 5          TO FIELD-NUMBER
               PERFORM 11-EDIT-STAT THRU 11-ES-EXIT.

           IF ST-O4 NOT = SPACES
               MOVE ST-O4      TO STATUS-KEY
               MOVE 6          TO FIELD-NUMBER
               PERFORM 11-EDIT-STAT THRU 11-ES-EXIT.

           IF ST-O5 NOT = SPACES
               MOVE ST-O5      TO STATUS-KEY
               MOVE 7          TO FIELD-NUMBER
               PERFORM 11-EDIT-STAT THRU 11-ES-EXIT.

       6-MAIN.
           MOVE 0              TO ACT-KEY PAGE-KEY.
           MOVE 60             TO LINE-CTR.
           MOVE SPACES         TO ZONE-SORT.
           IF PRINT-SWITCH-IS-OFF
               PERFORM SORT-DISPLAY
           ELSE
               PERFORM SORT-PRINT
               MOVE 0          TO ACT-KEY
               PERFORM SORT-DISPLAY.

           OPEN INPUT          OUT-FILE.
           IF ACT-KEY = 0
      **********************************************************************
      **    MESSAGE 040/002:
      ** NO WORK ORDERS IN THE BACKLOG FOR THIS ZONE
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE TRUE-VAL   TO IND(99)
               GO TO 1-SHOWFORM.

           MOVE 0              TO ACT-KEY PAGE-KEY.

       6-RESET-SCREEN.
           MOVE "VPWOQUE"      TO SCREEN-NAME.
           MOVE SCREEN-DATA    TO SCREEN-SAVE.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE ZONE-FIELD     TO VZONE P-ZONE.

           IF SORT1 = "X"
               MOVE "QUEUE FACTOR" TO VSORT P-SORT
           ELSE
           IF SORT2 = "X"
               MOVE "EQUIPMENT   " TO VSORT P-SORT
           ELSE
           IF SORT3 = "X"
               MOVE "STATUS      " TO VSORT P-SORT
           ELSE
           IF SORT4 = "X"
               MOVE "WORKORDER   " TO VSORT P-SORT.

           MOVE 0              TO SUB.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.
           ADD 14              TO PAGE-KEY.

           IF EOF-SW = 1 AND SUB = 1
               MOVE 0          TO EOF-SW
               MOVE SCREEN-SAVE TO SCREEN-DATA
               SUBTRACT 1      FROM ACT-KEY
               SUBTRACT 14     FROM PAGE-KEY.

       6-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.
           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               CLOSE           OUT-FILE
               GO TO 1-SELECT-SCREEN.

           IF KEY-HIT = 5
               MOVE 0          TO EOF-SW
               COMPUTE PAGE-KEY = PAGE-KEY - 28
               IF PAGE-KEY < 0
                   MOVE 0      TO PAGE-KEY
               END-IF
               MOVE PAGE-KEY   TO ACT-KEY
               GO TO 6-RESET-SCREEN.

           IF KEY-HIT = 7
               MOVE 1          TO PRINT-SW
               CLOSE           OUT-FILE
               ACCEPT CUR-DATE FROM DATE
               MOVE CUR-YY     TO P-DATE-YY
               MOVE CUR-MM     TO P-DATE-MM
               MOVE CUR-DD     TO P-DATE-DD
               ACCEPT TIME-BUF FROM TIME
               MOVE HRS        TO TIME-H
               MOVE MIN        TO TIME-M
               MOVE SEC        TO TIME-S
               MOVE TIME-EXP   TO P-TIME
               GO TO 6-MAIN.

           IF KEY-HIT = 9
               MOVE 0          TO EOF-SW
               CLOSE           OUT-FILE
               MOVE SPACES     TO SORT-SEL
               MOVE "X"        TO SORT1
               GO TO 6-MAIN.

           IF KEY-HIT = 10
               MOVE 0          TO EOF-SW
               CLOSE           OUT-FILE
               MOVE SPACES     TO SORT-SEL
               MOVE "X"        TO SORT2
               GO TO 6-MAIN.

           IF KEY-HIT = 11
               MOVE 0          TO EOF-SW
               CLOSE           OUT-FILE
               MOVE SPACES     TO SORT-SEL
               MOVE "X"        TO SORT3
               GO TO 6-MAIN.

           IF KEY-HIT = 12
               MOVE 0          TO EOF-SW
               CLOSE           OUT-FILE
               MOVE SPACES     TO SORT-SEL
               MOVE "X"        TO SORT4
               GO TO 6-MAIN.

           MOVE 0              TO SUB DISPLAY-SW.
           PERFORM 7-CHECK-DISPLAY THRU 7-CD-EXIT 14 TIMES.
           IF DISPLAY-SW = 1
               MOVE 0          TO SUB DISPLAY-SW
               PERFORM VARYING SUB FROM 1 BY 1 UNTIL SUB > 14
                   MOVE " "    TO VIN(SUB)
               END-PERFORM
               GO TO 6-SHOWFORM.

           IF EOF-SW = 1
               GO TO 6-SHOWFORM.

           GO TO 6-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY SUB.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.

           MOVE OUT-REC        TO VLINES(SUB).
           MOVE OUT-MM         TO DT-MM(SUB).
           MOVE OUT-DD         TO DT-DD(SUB).
           MOVE OUT-YY         TO DT-YY(SUB).
           IF DATE-FLAG = 3
               MOVE OUT-DD     TO DT-MM(SUB)
               MOVE OUT-MM     TO DT-DD(SUB).
           MOVE "/"            TO FILL1(SUB) FILL2(SUB).
           MOVE "-"            TO FILL3(SUB).
           MOVE "IP"           TO IS-IND(SUB).
           IF OUT-IND = "S"    MOVE "SD" TO IS-IND(SUB).
           IF OUT-IND = "C"    MOVE "CW" TO IS-IND(SUB).
           IF SUB = 14
               MOVE 0          TO SUB
               GO TO 62-FS-EXIT.

           GO TO 62-FILL-SCREEN.

       62-FS-EXIT.             EXIT.

       7-CHECK-DISPLAY.
           ADD 1               TO SUB.
           IF VIN(SUB) NOT = SPACE
               IF VWO(SUB) NOT = SPACES
                   MOVE VWO(SUB) TO WONUM-KEY
                   MOVE 1      TO DISPLAY-SW
                   PERFORM 7-WO-DISPLAY THRU 7-WOD-EXIT.

       7-CD-EXIT.              EXIT.

       7-WO-DISPLAY.
           MOVE WONUM-KEY      TO WONUM OF WO-PLANNED-WO
           READ WO-PLANNED-WO  INTO WO-PLANNED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-PLANNED-ST" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               DISPLAY DB-ERROR
               GO TO END-OF-JOB.

           CALL "TDISPWO"      USING DBPARAMETERS
                               WO-BASIC-DATA
                               WO-PLANNED-DATA
                               FILE-SW.

       7-WOD-EXIT.             EXIT.

       SORT-DISPLAY.
           IF SORT1 = "X"
               SORT SORT-FILE  DESCENDING KEY SORT-WO-QUEUE
                                ASCENDING KEY SORT-STATUS
                                              SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT
           ELSE
           IF SORT2 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-EQUIP
                                              SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT
           ELSE
           IF SORT3 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-STATUS
                               DESCENDING KEY SORT-WO-QUEUE
                                ASCENDING KEY SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT
           ELSE
           IF SORT4 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT.

       SORT-PRINT.
           IF SORT1 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-ZONE
                               DESCENDING KEY SORT-WO-QUEUE
                                ASCENDING KEY SORT-STATUS
                                              SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT
           ELSE
           IF SORT2 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-ZONE
                                              SORT-EQUIP
                                              SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT
           ELSE
           IF SORT3 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-ZONE
                                ASCENDING KEY SORT-STATUS
                               DESCENDING KEY SORT-WO-QUEUE
                                ASCENDING KEY SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT
           ELSE
           IF SORT4 = "X"
               SORT SORT-FILE   ASCENDING KEY SORT-ZONE
                                ASCENDING KEY SORT-WO-NUM
                  INPUT  PROCEDURE SORT-PWQ-RECS
                  OUTPUT PROCEDURE SORT-PWQ-OUT.

       11-EDIT-STAT.
           MOVE STATUS-KEY     TO WOSTATUS OF WO-STATUS-FILE.
           READ WO-STATUS-FILE INTO WO-STATUS-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      **********************************************************************
      **    MESSAGE 035/001:
      **  INVALID STATUS
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE   1        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSG1
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               MOVE 1          TO ERROR-SW
               GO TO 1-SHOWFORM.

       11-ES-EXIT.             EXIT.

       DATE-ADJUST.
           MOVE DM-MM          TO  DD-MM.
           MOVE DM-DD          TO  DD-DD.
           MOVE DM-YY          TO  DD-YY.
           IF DATE-FLAG = 3
               MOVE DM-MM      TO  DD-DD
               MOVE DM-DD      TO  DD-MM.
           MOVE "/"            TO  SLASH1 SLASH2.
           IF "00" = DD-MM AND DD-DD AND DD-YY
               MOVE SPACES     TO DATE-DISP.

       DA-EXIT.                EXIT.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       END-OF-JOB.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               WO-PLANNED-ST.
           CLOSE               WO-PLANNED-WO.
           CLOSE               WO-STATUS-FILE.
           CLOSE               OUT-FILE.
           CLOSE               DISPLAY-FILE.
           GOBACK.

       SORT-PWQ-RECS           SECTION 02.
       SORT-PWQ-RECS-PROC.
           MOVE SPACES         TO STATUS-CHECK.
           IF STAT-OO = "X"
               MOVE "OO"       TO STATUS-KEY CHK-OO
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-IP = "X"
               MOVE "IP"       TO STATUS-KEY CHK-IP
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-SD = "X"
               MOVE "SD"       TO STATUS-KEY CHK-SD
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-HS = "X"
               MOVE "HS"       TO STATUS-KEY CHK-HS
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-HA = "X"
               MOVE "HA"       TO STATUS-KEY CHK-HA
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-HL = "X"
               MOVE "HL"       TO STATUS-KEY CHK-HL
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-HM = "X"
               MOVE "HM"       TO STATUS-KEY CHK-HM
               PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF STAT-OTHER = SPACES
               GO TO SORT-IP-EXIT.

           IF ST-O1 NOT = SPACES
               IF ST-O1 = CHK-OO OR
                          CHK-IP OR
                          CHK-SD OR
                          CHK-HS OR
                          CHK-HA OR
                          CHK-HL OR
                          CHK-HM
                   NEXT SENTENCE
               ELSE
                   MOVE ST-O1  TO STATUS-KEY
                   PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF ST-O2 NOT = SPACES
               IF ST-O2 = CHK-OO OR
                          CHK-IP OR
                          CHK-SD OR
                          CHK-HS OR
                          CHK-HA OR
                          CHK-HL OR
                          CHK-HM
                   NEXT SENTENCE
               ELSE
                   MOVE ST-O2  TO STATUS-KEY
                   PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF ST-O3 NOT = SPACES
               IF ST-O3 = CHK-OO OR
                          CHK-IP OR
                          CHK-SD OR
                          CHK-HS OR
                          CHK-HA OR
                          CHK-HL OR
                          CHK-HM
                   NEXT SENTENCE
               ELSE
                   MOVE ST-O3  TO STATUS-KEY
                   PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF ST-O4 NOT = SPACES
               IF ST-O4 = CHK-OO OR
                          CHK-IP OR
                          CHK-SD OR
                          CHK-HS OR
                          CHK-HA OR
                          CHK-HL OR
                          CHK-HM
                   NEXT SENTENCE
               ELSE
                   MOVE ST-O4  TO STATUS-KEY
                   PERFORM SORT-MAIN THRU SORT-M-EXIT.

           IF ST-O5 NOT = SPACES
               IF ST-O5 = CHK-OO OR
                          CHK-IP OR
                          CHK-SD OR
                          CHK-HS OR
                          CHK-HA OR
                          CHK-HL OR
                          CHK-HM
                   NEXT SENTENCE
               ELSE
                   MOVE ST-O5  TO STATUS-KEY
                   PERFORM SORT-MAIN THRU SORT-M-EXIT.

           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE STATUS-KEY     TO WOSTATUS OF WO-PLANNED-ST.
           START WO-PLANNED-ST  KEY = WOSTATUS OF WO-PLANNED-ST
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-PLANNED-ST" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

           PERFORM SORT-DBGET  THRU SORT-DBGET-EXIT.

       SORT-M-EXIT.            EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-PLANNED-ST  NEXT INTO WO-PLANNED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-PLANNED-ST" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   DISPLAY DB-ERROR
                   GO TO END-OF-JOB.

           IF STATUS-KEY NOT = WO-STATUS-P
               GO TO SORT-DBGET-EXIT.

           IF ZONE-BUF = "ALL "
               NEXT SENTENCE
           ELSE
               IF ZONE-P NOT = ZONE-BUF
                   GO TO SORT-DBGET.

           IF PMO-SW = "X"
               IF WO-START-TYPE NOT = "A"
                   GO TO SORT-DBGET.

           IF PM-SW = " " AND PMO-SW = " "
               IF WO-START-TYPE = "A"
                   GO TO SORT-DBGET.

           IF PRIORITY-P = "1 "  MOVE 5 TO QUEUE-PRTY.
           IF PRIORITY-P = "2 "  MOVE 4 TO QUEUE-PRTY.
           IF PRIORITY-P = "3 "  MOVE 3 TO QUEUE-PRTY.
           IF PRIORITY-P = "4 "  MOVE 2 TO QUEUE-PRTY.
           IF PRIORITY-P = "5 "  MOVE 1 TO QUEUE-PRTY.

           IF RIME-P = "  "
               MOVE "01"       TO RIME-P.

           IF RIME-P NOT NUMERIC
               MOVE "01"       TO RIME-P.

           MOVE RIME-P         TO RIME-X.
           COMPUTE SORT-WO-QUEUE = RIME-9 * QUEUE-PRTY.
           MOVE EQUIP-NUM-P    TO SORT-EQUIP.
           MOVE WO-NUM-PLANNED TO SORT-WO-NUM.
           MOVE WO-STATUS-P    TO SORT-STATUS.
           MOVE ZONE-P         TO SORT-ZONE.
           MOVE DESCRIPTION-1-P TO SORT-DESC.
           MOVE DATE-STRT-P-CN TO SORT-DATE.
           MOVE "I"            TO SORT-IND.

           IF WO-STATUS-P = "HS" OR "SD"
               MOVE DATE-SCHD-CN TO SORT-DATE
               MOVE "S"        TO SORT-IND.

           IF WO-STATUS-P = "DW" OR "CW"
               MOVE DATE-COMP-P-CN TO SORT-DATE
               MOVE "C"        TO SORT-IND.

           IF WO-START-TYPE = "A"
               IF SPECL-EQUIP-1 NOT = SPACES
                   MOVE SPECL-EQUIP-1 TO SORT-DESC
                   IF SORT-DESC = "PROGRAM TPMNEWYR HAS GENERATED"
                       MOVE DESCRIPTION-1-P TO SORT-DESC.

           RELEASE             SORT-REC.
           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.        EXIT.

       SORT-IP-EXIT.           EXIT.

       SORT-PWQ-OUT            SECTION 03.
       SORT-PWQ-OUT-PROC.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           PERFORM SORT-PRINT-LOOP THRU SPL-EXIT.
           GO TO SORT-WF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.               EXIT.

       SORT-PRINT-LOOP.
           IF PRINT-SWITCH-IS-OFF
               GO TO SPL-EXIT.

      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.
           OPEN OUTPUT         PRINT-FILE.

       PRINT-LOOP.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               GO TO PL-EXIT.
           IF ACT-KEY > MAX-KEY
               GO TO PL-EXIT.

           MOVE OUT-ZONE       TO P-ZONE.
           IF ZONE-SORT = SPACES
               MOVE OUT-ZONE   TO ZONE-SORT.

           IF OUT-ZONE NOT = ZONE-SORT
               MOVE OUT-ZONE   TO ZONE-SORT
               MOVE 60         TO LINE-CTR.

           IF LINE-CTR > 59
               PERFORM PRINT-HEADINGS.

           MOVE OUT-WO-QUEUE   TO P-QF.
           MOVE OUT-WO-NUM     TO P-WO.
           MOVE OUT-STATUS     TO P-STAT.
           MOVE OUT-DESC       TO P-DESC.
           MOVE OUT-EQUIP      TO P-EQP.
           MOVE OUT-DATE       TO  DATE-MOVE.
           PERFORM DATE-ADJUST THRU DA-EXIT.
           MOVE DATE-DISP      TO P-DATE1.

           MOVE "-"            TO P-FILL.
           MOVE "IP"           TO P-IND.
           IF OUT-IND = "S"    MOVE "SD" TO P-IND.
           IF OUT-IND = "C"    MOVE "CW" TO P-IND.

           MOVE PRINT-LINE     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           ADD  1              TO LINE-CTR.
           GO TO PRINT-LOOP.

       PL-EXIT.
           CLOSE               OUT-FILE.
           CLOSE               PRINT-FILE.
           MOVE 0              TO PRINT-SW.
           GO TO SPL-EXIT.

       PRINT-HEADINGS.
           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO ZPAGE.
           MOVE DATE-HEADER    TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TITLE-HEADER   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE SORT-HEADER    TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TEXT-HEADER    TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE 7              TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.

       SPL-EXIT.               EXIT.

       SORT-WF-EXIT.           EXIT.

