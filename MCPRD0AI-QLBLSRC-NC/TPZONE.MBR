000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID. TPZONE.
000400 ENVIRONMENT DIVISION.
000500 CONFIGURATION SECTION.
000600 SOURCE-COMPUTER. AS400.
000700 OBJECT-COMPUTER. AS400.
       SPECIAL-NAMES.      I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                           LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZPERSON-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT PERSONNEL-FILE
               ASSIGN TO DATABASE-MCFLMM0301
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS PF-STATUS.
           SELECT WO-ZONE-PRTY-FILE
               ASSIGN TO DATABASE-MCFLMM0501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WZPF-STATUS.
001200 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC                   PIC X(2000).
       FD  PERSONNEL-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS PFREC.
       01  PFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0301.
       FD  WO-ZONE-PRTY-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WZPFREC.
       01  WZPFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.
000900 WORKING-STORAGE SECTION.
       COPY CATREAD OF COPYLIB.
       COPY CPYIND  OF COPYLIB.
002300 01  DEX                            PIC S9(4) COMP-4.
002400 01  DEX1                           PIC S9(4) COMP-4.
       01  DSPLY-STATUS                   PIC XX.
003100 01  ERROR-BUFFER.
           05  FILLER                     PIC X(12).
           05  ERR-CC                     PIC X(4).
           05  FILLER                     PIC X(64).
       COPY IOFEEDBACK OF COPYLIB.
002800 01  N-F-SW                         PIC X.
001000 01  PASSWORD-INFORMATION.
001100     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TPZONE  ".
001200     05  PROGRAM-TYPE        PIC X(02) VALUE "MA".
001300     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
001400     05  PROGRAM-DESCRIPTION.
001500         10  PROG-DESC-A     PIC X(60) VALUE
001600            "PERSONNEL SYSTEM MASS CHANGE ZONE PROGRAM "         .
001700         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
001900         10  PROG-FUNCTION   PIC X(60) VALUE SPACES.
002100     05  PASSWORD-FLAG       PIC X.
004200 01  PER-PERSONNEL.                 COPY MPERSONL OF COPYLIB.
       01  PF-STATUS                      PIC XX.
003800 01  SCREEN-BUFF.
003900     05 SCREEN-ZONE                 PIC X(4).
004000     05 SCREEN-TABLE.
004100        10 CNUM OCCURS 15 TIMES     PIC X(4).
           05  SCREEN-CMD-LINE            PIC X(79).
           05  SCREEN-ERR-LINE            PIC X(79).
004300 COPY DBSTAT   OF COPYLIB.
003200 01  STOP-SW                        PIC X VALUE "N".
003300     88 TIME-TO-STOP                      VALUE "Y".
       01  TRUE-VAL                       PIC 1 VALUE B"1".
003500 01  WO-OR-ZOPRTYS.
003600     05 WOZOPR OCCURS 750 TIMES INDEXED BY Z-INDEX.
003700        10 ZOPRTY                   PIC X(4).
       COPY WSCONTROL OF COPYLIB.
       01  WZPF-STATUS                    PIC XX.
003400 01  ZONE-PRTY.                     COPY MZONPRTY OF COPYLIB.
002900 01  ZONE-SW                        PIC X VALUE "Y".
004500 LINKAGE SECTION.
004600 01  DBPARAMETERS.                  COPY DBPARMS  OF COPYLIB.
004700 COPY VCOMLINK  OF COPYLIB.
004800 01  PLT-IDT                        PIC X(4).
005000 PROCEDURE DIVISION USING DBPARAMETERS VIEW-COMAREA
005100                      PLT-IDT.
       START-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN UNTIL TIME-TO-STOP.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE PERSONNEL-FILE.
           CLOSE WO-ZONE-PRTY-FILE.
           GOBACK.
       1-HSK.
           OPEN I-O   DISPLAY-FILE.
           OPEN I-O   PERSONNEL-FILE.
           OPEN INPUT WO-ZONE-PRTY-FILE.
005300     CALL "TPWORD" USING PASSWORD-INFORMATION.
005700     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
007500 6-MAIN.
007600     MOVE "FPZONE" TO VIEW-CFNAME.
008000     MOVE SPACES TO SCREEN-BUFF.
008100     MOVE SCREEN-BUFF TO DSPLY-REC.
008200     PERFORM 99-SCREEN-WRITE.
009300     MOVE 0 TO DEX.
009500     PERFORM 61-READ-AND-UPDATE-PERSONNEL THRU 61-RAUP-EXIT.
009800 61-READ-AND-UPDATE-PERSONNEL.
009900     PERFORM 98-SCREEN-READ.
010900     IF VIEW-LASTKEY = 3
011000         MOVE "Y" TO STOP-SW
011100         GO TO 61-RAUP-EXIT.
012800     MOVE DSPLY-REC TO SCREEN-BUFF.
013400     MOVE "N" TO N-F-SW.
           MOVE 0 TO COND-WORD.
           READ WO-ZONE-PRTY-FILE NEXT INTO ZONE-PRTY
               AT END    MOVE 11 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 11 TO COND-WORD.
014000     IF COND-WORD = 0 OR 11
014100         NEXT SENTENCE
014200     ELSE
014300     GO TO 2-EOJ.
014400     IF ZONE-SW = "Y"
014500         MOVE SPACES TO WO-OR-ZOPRTYS
014600         MOVE 1 TO DEX1
014700         MOVE "N" TO ZONE-SW
014800         PERFORM FIND-ZONES UNTIL DEX1 > 750 OR COND-WORD = 11.
014900     PERFORM CHECK-ZONE THRU C-Z-E.
015000     IF N-F-SW = "Y"
015200         MOVE 35044 TO CATREAD-MSG-NUMBER
015400         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO SCREEN-ERR-LINE
               MOVE SCREEN-BUFF TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               MOVE TRUE-VAL TO INDS (1) INDS (99)
               MOVE SPACES TO ERROR-BUFFER
016100         GO 61-READ-AND-UPDATE-PERSONNEL.
016600 61-RAUP-CONT.
016700     ADD 1 TO DEX.
016800     IF DEX > 15 GO TO 61-RAUP-EXIT.
016900     IF CNUM (DEX) = SPACES GO TO 61-RAUP-EXIT.
017000     MOVE 0 TO COND-WORD.
017100     MOVE CNUM (DEX) TO PERCCNUM OF PFREC.
           START PERSONNEL-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
017400     IF COND-WORD = 17 GO TO 61-RAUP-CONT.
           READ PERSONNEL-FILE NEXT INTO PER-PERSONNEL
               AT END    MOVE 15 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 61-RAUP-CONT.
017700     MOVE SCREEN-ZONE TO PER-MAINT-ZONE.
017800     MOVE 0 TO COND-WORD.
017900     REWRITE PFREC FROM PER-PERSONNEL
018000         INVALID KEY    MOVE 17 TO COND-WORD.
           IF PF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
018100     IF COND-WORD = 17 GO TO 2-EOJ.
           MOVE TRUE-VAL TO INDS (98).
           MOVE 66190 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE PER-CC-NUM TO ERR-CC.
           MOVE ERROR-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFF TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".
           MOVE SPACES TO ERROR-BUFFER SCREEN-CMD-LINE.
018300     GO TO 61-RAUP-CONT.
018400 61-RAUP-EXIT.    EXIT.
018500
018600 CHECK-ZONE.
018700     SET Z-INDEX TO 1.
018800     SEARCH WOZOPR AT END MOVE "Y" TO N-F-SW
018900         WHEN SCREEN-ZONE = WOZOPR (Z-INDEX) GO TO C-Z-E.
019000 C-Z-E.    EXIT.
019100
019200 FIND-ZONES.
019300     IF ZONE-FIELD = SPACES
019400         NEXT SENTENCE
019500     ELSE
019600     MOVE ZONE-FIELD TO ZOPRTY (DEX1)
019700     ADD 1 TO DEX1.
           READ WO-ZONE-PRTY-FILE NEXT INTO ZONE-PRTY
               AT END    MOVE 11 TO COND-WORD.
           IF WZPF-STATUS NOT = "00" MOVE 11 TO COND-WORD.
020200     IF COND-WORD = 0 OR 11
020300         NEXT SENTENCE
020400     ELSE
020500     GO TO 2-EOJ.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.

051100 999-CATREAD.
024000     MOVE SPACES TO ERROR-BUFFER.
024100     CALL "CCATREAD" USING CATREAD-PARMS.
024200     MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.
052100 999-CATREAD-EXIT.
052200     EXIT.
