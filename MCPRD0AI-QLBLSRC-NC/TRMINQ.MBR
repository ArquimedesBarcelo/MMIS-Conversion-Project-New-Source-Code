       IDENTIFICATION DIVISION.
       PROGRAM-ID.         TRMINQ.
       AUTHOR.             CA YODER.
       DATE-WRITTEN.       NOVEMBER 1999.
       DATE-COMPILED.
      *INSTALLATION.       GOODYEAR TIRE & RUBBER CO.

      *D* REMARKS.
      *D*
      *D*   THIS PROGRAM DISPLAYS THE RECORDS IN THE RAW MATERIAL
      *D*   INVENTORY FILE (MCFPPICT).
      *D*
      *C* CHANGES
      *C*

       ENVIRONMENT DIVISION.

       CONFIGURATION SECTION.

       SOURCE-COMPUTER.          IBM-AS400.
       OBJECT-COMPUTER.          IBM-AS400.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN         TO WORKSTATION-ZRMINQ-SI
               ORGANIZATION   IS TRANSACTION
               ACCESS         IS DYNAMIC
               RELATIVE KEY   IS REC-COUNT
               FILE STATUS    IS DISPLAY-STATUS
               CONTROL-AREA   IS WS-CONTROL.

           SELECT RMFILE-I
               ASSIGN         TO DATABASE-MCFLPICT1
               ORGANIZATION   IS INDEXED
               ACCESS MODE    IS DYNAMIC
               RECORD KEY     IS EXTERNALLY-DESCRIBED-KEY
                              WITH DUPLICATES
               FILE STATUS    IS FILE-STATUS.

       DATA DIVISION.

       FILE SECTION.

       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DISPLAY-REC        PIC X(2000).

       FD  RMFILE-I
           LABEL RECORDS ARE STANDARD.
       01  RMFILE-I-REC.
           COPY DDS-ALL-FORMATS OF MCFLPICT1.

       WORKING-STORAGE SECTION.

       77  SUB                      PIC 9.
       77  HOLD-MATL                PIC X(8).

      *-----------------------------------------------------------------
      *                   B U F F E R S
      *-----------------------------------------------------------------

      *--- BUFFER FOR FIRST DISPLAY SCREEN.
       01  DE-BUF.
           05  DE-START             PIC X(8).
           05  DE-DATE              PIC X(8).
           05  DE-TIME              PIC X(8).
           05  DE-MSGLINE           PIC X(78).

      *--- BUFFER FOR SUBFILE SCREEN LINES.
       01  BUF-SCREEN.
           05  SC-LINE    OCCURS  4 TIMES.
               10  SC-MATL          PIC X(8).
               10  FILLER           PIC X(2) VALUE SPACES.
               10  SC-AMOUNT        PIC Z(7)9.
               10  SC-AMOUNT-X   REDEFINES   SC-AMOUNT
                                    PIC X(8).
               10  FILLER           PIC X(2) VALUE SPACES.

       01  BUF-RMFILE.
           05  RM-CODE              PIC X(7).
           05  RM-MATL              PIC X(30).
           05  RM-UM                PIC X(2).
           05  RM-AMT               PIC 9(8).
           05  FILLER               PIC X(33).

       01  END-LIST-MSG.
           05  FILLER               PIC X(52) VALUE
               "STARTING PAST END OF LIST; ENTER ANOTHER START VALUE".

      *-----------------------------------------------------------------
      *         S W I T C H E S / C O U N T E R S
      *-----------------------------------------------------------------

       01  RMFILE-EOF-SW            PIC X  VALUE "N".

       01  REC-COUNT               PIC 9(5) VALUE 0.

      *-----------------------------------------------------------------
      *          D A T A B A S E   S T A T U S   A R E A
      *-----------------------------------------------------------------

       01  FILE-STATUS.
           05  FILE-STATUS-1        PIC X.
           05  FILE-STATUS-2        PIC X.

       COPY DATAB    OF COPYLIB.

      *-----------------------------------------------------------------
      *               U T I L I T Y   A R E A
      *-----------------------------------------------------------------

       COPY TBLOWUP OF COPYLIB.

       COPY VCOMAREA OF COPYLIB.

       01  WS-CONTROL.
           05  FUNCTION-KEY         PIC X(2).
               88  ENTER-KEY-USED            VALUE "00".
               88  F1-KEY-USED               VALUE "01".
               88  F2-KEY-USED               VALUE "02".
               88  F3-KEY-USED               VALUE "03".
               88  F4-KEY-USED               VALUE "04".
               88  F5-KEY-USED               VALUE "05".
               88  F6-KEY-USED               VALUE "06".
               88  F7-KEY-USED               VALUE "07".
               88  F8-KEY-USED               VALUE "08".
               88  F9-KEY-USED               VALUE "09".
               88  F10-KEY-USED              VALUE "10".
               88  F11-KEY-USED              VALUE "11".
               88  F12-KEY-USED              VALUE "12".
               88  ROLLUP-KEY-USED           VALUE "RU".
           05  TERMINAL-ID          PIC X(10).
           05  FORMAT-NAME          PIC X(10).

       01  DISPLAY-STATUS           PIC X(2).

       01  SRF-INDICATORS.
           05  IND                  PIC 1
                                    OCCURS 99 TIMES
                                    INDICATOR 1.
               88  IND-OFF          VALUE B"0".
               88  IND-ON           VALUE B"1".

       01  OFF-SWITCH               PIC 1  VALUE B"0".
       01  ON-SWITCH                PIC 1  VALUE B"1".

       01  MATL-ARG                 PIC X(30).

       COPY TDATECHK IN COPYLIB.

       01  CLRTVMBRD-FILE           PIC X(10)  VALUE "MCFPPICT  ".
       01  CLRTVMBRD-CHGDATE        PIC X(13).

       01  HOLD-CHGDATE.
           05  FILLER               PIC X.
           05  HOLD-DATE            PIC X(6).
           05  HOLD-TIME            PIC X(6).

      *-----------------------------------------------------------------
      *          P R O C E D U R E   D I V I S I O N
      *-----------------------------------------------------------------

       PROCEDURE DIVISION.

       BEGIN SECTION.

       0-BEGIN.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-X.
           PERFORM 2-EOJ.
           GOBACK.

       1-HSK.
           OPEN INPUT     RMFILE-I
                I-O       DISPLAY-FILE.

           MOVE SPACES             TO  CLRTVMBRD-CHGDATE.
           CALL "CLRTVMBRD" USING CLRTVMBRD-FILE
                                  CLRTVMBRD-CHGDATE.
           MOVE CLRTVMBRD-CHGDATE  TO  HOLD-CHGDATE.
           MOVE 4                  TO  DATE-MODE.
           MOVE HOLD-DATE          TO  DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.

       2-EOJ.
           CLOSE          RMFILE-I
                          DISPLAY-FILE.

       6-MAIN SECTION.

       6-BEGIN.
           INITIALIZE DISPLAY-REC.
           MOVE SPACES    TO  MATL-ARG.

       6-DISPLAY-SCREEN.

           MOVE DATE-SLASH-OUT          TO  DE-DATE.
           STRING HOLD-TIME (1:2) ":"
                  HOLD-TIME (3:2) ":"
                  HOLD-TIME (5:2)
                  DELIMITED BY SIZE   INTO  DE-TIME.

           MOVE DE-BUF                  TO  DISPLAY-REC.
      *--- SHOW FIRST SCREEN WHERE DATA IS ENTERED.
           WRITE DISPLAY-REC FORMAT IS "RMSCRN"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SCREEN WRITE" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.
           READ DISPLAY-FILE
               FORMAT IS "RMSCRN"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SCREEN" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.
           MOVE DISPLAY-REC    TO DE-BUF.

       6-CHECK-ERRORS.
           IF F3-KEY-USED
               GO TO 6-MAIN-X.

           MOVE DE-START       TO MATL-ARG.

       60-LOAD-SCREEN.

           INITIALIZE REC-COUNT.

      *---- SHOW SFLCTL (71) AND CLEAR SFL (72), BUT DON'T SHOW IT (70).

           MOVE ON-SWITCH    TO IND (71)  IND (72).
           MOVE OFF-SWITCH   TO IND (70).

           WRITE SUBFILE DISPLAY-REC FROM BUF-SCREEN
               FORMAT IS "RMSFLC"
               INDICATORS ARE SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON INIT SFL WRITE" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.

      *-------- TURN CLEAR SFL OFF.

           MOVE OFF-SWITCH TO IND (72).

       61-GET-LIST.

           INITIALIZE BUF-SCREEN.
           PERFORM 64-LIST-RECORDS.

       62-SHOW-SCREEN.

      *--- SHOW FUNCTION KEYS.
           WRITE DISPLAY-REC
               FORMAT IS "RMREC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.

           MOVE ON-SWITCH TO IND (70)  IND (71)  IND (73).

      *--- WRITE THE SUBFILE TO SCREEN.
           WRITE SUBFILE DISPLAY-REC
               FORMAT IS "RMSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON SHOW SFL WRITE" TO BU-DISPLAY-MSG
               MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
               MOVE DISPLAY-STATUS TO BU-DISPLAY-FLD (2)
               GO TO 9999-BLOWUP.

      *--- WAIT FOR USER TO PRESS A KEY.
           READ DISPLAY-FILE
               FORMAT IS "RMSFLC"
               INDICATORS ARE SRF-INDICATORS.
           MOVE ALL B"0" TO SRF-INDICATORS.
           IF DISPLAY-STATUS NOT = "00"
               MOVE "PROBLEM ON READ SFL" TO BU-DISPLAY-MSG
               GO TO 9999-BLOWUP.


       63-ACTION.

      *--- THE ENTER KEY IS TREATED THE SAME AS PRESSING THE F3 KEY.
           IF F3-KEY-USED OR ENTER-KEY-USED
               MOVE "N" TO RMFILE-EOF-SW
               GO TO 6-BEGIN.

       64-LIST-RECORDS.

           MOVE "N" TO RMFILE-EOF-SW.
           PERFORM 9999-START-RMFILE.

           IF FILE-STATUS NOT = "00"
               INITIALIZE DE-BUF
      *       ***  START PAST END OF LIST ***
               MOVE END-LIST-MSG          TO DE-MSGLINE
               MOVE ON-SWITCH             TO IND (60)
               MOVE DE-BUF                TO DISPLAY-REC
               GO TO 6-DISPLAY-SCREEN.

           PERFORM 9999-READ-NEXT-RMFILE.
           MOVE SPACES                        TO HOLD-MATL.

           PERFORM UNTIL RMFILE-EOF-SW = "Y"
      *------- MOVE FIELDS TO DISPLAY RECORD.

               MOVE 1                         TO SUB
               PERFORM UNTIL SUB > 4
                   IF RMFILE-EOF-SW = "Y"
                       MOVE SPACES            TO SC-MATL (SUB)
                                                 SC-AMOUNT-X (SUB)
                       ADD 1                  TO SUB
                   ELSE
                       IF RM-MATL = HOLD-MATL
                           NEXT SENTENCE
                       ELSE
                           MOVE RM-MATL       TO SC-MATL (SUB)
                                                 HOLD-MATL
                           MOVE RM-AMT        TO SC-AMOUNT (SUB)
                           ADD 1              TO SUB
                       END-IF
                       PERFORM 9999-READ-NEXT-RMFILE
                   END-IF

               END-PERFORM

      *------- MOVE THE SCREEN BUFFER AND WRITE OUT.
               MOVE BUF-SCREEN            TO DISPLAY-REC
               ADD 1                      TO REC-COUNT
               IF REC-COUNT > 9999
                   MOVE "SUBFILE TOO SMALL-INCREASE ZRMINQ"
                       TO BU-DISPLAY-MSG
                   MOVE REC-COUNT TO BU-DISPLAY-FLD (1)
                   GO TO 9999-BLOWUP
               END-IF
               WRITE SUBFILE DISPLAY-REC
                   FORMAT IS "RMSFL"
                   INDICATORS ARE SRF-INDICATORS
               IF DISPLAY-STATUS NOT = "00"
                   MOVE "SUBFILE WRITE ERROR" TO BU-DISPLAY-MSG
                   MOVE REC-COUNT        TO BU-DISPLAY-FLD (1)
                   MOVE DISPLAY-STATUS   TO BU-DISPLAY-FLD (2)
               GO TO 9999-BLOWUP
               END-IF

               INITIALIZE BUF-SCREEN
           END-PERFORM.

       6-MAIN-X.
           EXIT.

       9999-UTILITY SECTION.

       9999-START-RMFILE.
           MOVE MATL-ARG TO MATLNAME OF RMFILE-I-REC.
           START RMFILE-I KEY >= MATLNAME OF RMFILE-I-REC
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-READ-NEXT-RMFILE.
           READ RMFILE-I NEXT INTO BUF-RMFILE
               AT END MOVE "Y" TO RMFILE-EOF-SW.

       9999-BLOWUP.
           MOVE "TRELINQ" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
               VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
               BU-DISPLAY-FLDS.
