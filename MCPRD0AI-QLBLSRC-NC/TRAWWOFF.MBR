026400*******************************************************
026500*   PARAMETERS USED IN 'TBLOWUP' ROUTINE (PRINTS      *
026600*   ERRORS AND ABORTS PROGRAM.  RUN XBLPRT.OBJECT TO  *
026700*   READ ERRORS).                                     *
026800*******************************************************
026900
027000 COPY TBLOWUP IN COPYLIB.
027100
027200******************************************
027300**   PARAMETERS FOR CALLING 'CBLOWSRT'
027400******************************************
027500
027600 COPY CBLOWSRT IN COPYLIB.
027700
028000 PROCEDURE DIVISION.
028100
028200 001-BEGIN SECTION.
028300
028400 010-MAINLINE.
           MOVE "C" TO MCXCBLERR-SCOPE.
           CALL "MCXCBLERR" USING MCXCBLERR-SCOPE.
028500
028600*******************************************************
028700**   CALL 'CBLOWSRT' FIRST BEFORE GOING INTO THE
028800**   SORT VERB.  THE FIRST CALL TO 'CBLOWSRT' OPENS
028900**   UP A NEW TEMPORARY FILE 'BLUPDATA' THAT IS USED
029000**   TO WRITE THE BLOWUP INFORMATION IF A BLOWUP
029100**   OCCURS
029200*******************************************************
029300
029400     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
029500                           ACCTG-BASE,
029600                           BU-PGM-NAME,
029700                           STATUS-AREA,
029800                           DUMMY-VIEW-AREA,
029900                           FILE-STATUS,
030000                           BU-DISPLAY-MSG,
030100                           BU-DISPLAY-FLDS.
030200
030300     SORT SORT-FILE ON ASCENDING KEY SORT-CLASS
030400                                     SORT-MATL-CODE
030500     INPUT PROCEDURE IS 050-PROCESS-TRANS
030600     OUTPUT PROCEDURE IS 700-CREATE-REPORT.
030700     PERFORM 1000-CLOSE-FILES.
030800     GOBACK.
030900
031100 050-PROCESS-TRANS SECTION.
       050-PROCESS-TRANS-PARA.
031200     PERFORM 100-BEGIN.
031300     PERFORM 200-PROCESS-DETAIL
031400         UNTIL END-OF-FILE.
031500
031600**********************************************************
031700*  TRANSFER CONTROL TO LAST STATEMENT IN INPUT PROCEDURE *
031800*  FOR SORTING OF RECORDS.                               *
031900**********************************************************
032000
032100     GO TO 699-PROCESS-EXIT.
032200
032300 100-BEGIN.
032400     DISPLAY "CREATE ADJUSTMENT TRANSACTIONS (YES OR NO)".
032500     DISPLAY "A NO RESPONSE MEANS THIS IS AN EDIT RUN".
032600     ACCEPT UPDATE-SW.
032700     DISPLAY "UPDATE-SW = ", UPDATE-SW.
032800
           PERFORM 9999-OPEN-STUFF.
034700
034800     MOVE SPACES                  TO SVARDEPT-PARMS.
034900     CALL "SVARDEPT" USING ACCTG-BASE,
035000                           SVARDEPT-PARMS,
035100                           STATUS-AREA,
035200                           BU-DISPLAY-MSG,
035300                           BU-DISPLAY-FLDS.
035400     IF BU-DISPLAY-MSG NOT = SPACES
035500         PERFORM 990-BLOWUP.
035600
035700     MOVE SPACES TO SORT-REC.
           PERFORM 9999-INIT-MMATL-ACCUM-MC-O.
035800     PERFORM 400-GET-MMATL-ACCUM.
035900
036100 200-PROCESS-DETAIL.
036200     IF MATL-STORES-CODE = "NON-STR" OR
036300        MATL-STORES-CODE-1-4 = "INTR" OR "ACCR" OR "OPNR"
036400             NEXT SENTENCE
036500         ELSE
036600             IF MATL-CLASS > 099 AND MATL-CLASS < 200 OR
036700                MATL-CLASS > 399 AND MATL-CLASS < 500
036800                 PERFORM 500-GET-MSTORERM
036900                 IF NO-ENTRY
037000                     NEXT SENTENCE
037100                 ELSE
037200                     PERFORM 600-BUILD-SORT-REC THRU 601-BSR-X.
037300
037400     PERFORM 400-GET-MMATL-ACCUM.
037500
037700 400-GET-MMATL-ACCUM.
           PERFORM 9999-DBGET2-MMATL-ACCUM-MC-O.
038500     IF GOOD-CALL
038600         NEXT SENTENCE
038700     ELSE
038800         IF END-OF-FILE
038900             NEXT SENTENCE
039000         ELSE
039100             MOVE "GET MMATL-ACCUM * 400-GMA" TO BU-DISPLAY-MSG
039200             PERFORM 990-BLOWUP.

039300     MOVE MATL-STORES-CODE        TO MMATL-CODE-ARG.
039400
039600 500-GET-MSTORERM.
           PERFORM 9999-DBGET7-MSTORERM-CD-I.
040400     IF GOOD-CALL
040500         NEXT SENTENCE
040600     ELSE
040700        IF NO-ENTRY
040800            NEXT SENTENCE
040900        ELSE
041000             MOVE "GET MSTORERM * 500-GM" TO BU-DISPLAY-MSG
041100             PERFORM 990-BLOWUP.
041200
041300 600-BUILD-SORT-REC.
041400     COMPUTE NEW-BEG-BAL-UNITS = MATL-BEG-BAL-UNITS +
041500                                 MATL-RCPT-UNITS +
041600                                 MATL-ADJ-UNITS +
041700                                 MATL-RTN-UNITS +
041800                                 MATL-RTNVAL-UNITS +
041900                                 MATL-ACCTG-UNIT-CORR -
042000                                 MATL-ISSUE-UNITS.
042100
042200     IF NEW-BEG-BAL-UNITS = ZEROS
042300         GO TO 601-BSR-X.
042400
042500     COMPUTE OLD-BEG-BAL-DOLLARS = MATL-BEG-BAL-DOLLARS +
042600                                   MATL-INV-DOLLARS +
042700                                   MATL-TOT-ADJ-DOLLARS +
042800                                   MATL-RTN-DOLLARS +
042900                                   MATL-RTNVAL-DOLLARS +
043000                                   MATL-ACCTG-DOLLAR-CORR -
043100                                   MATL-TOT-ISS-DOLLARS.
043200
043300     COMPUTE NEW-BEG-BAL-DOLLARS ROUNDED =
043400             NEW-BEG-BAL-UNITS * STR-AVG-COST.
043500
043600     COMPUTE WRITEOFF-AMT = NEW-BEG-BAL-DOLLARS -
043700                            OLD-BEG-BAL-DOLLARS.
043800
043900     IF WRITEOFF-AMT = ZEROS
044000         NEXT SENTENCE
044100     ELSE
044200         PERFORM 610-RELEASE-TO-SORT.
044300
044400 601-BSR-X.
044500     EXIT.
044600
044700 610-RELEASE-TO-SORT.
044800     MOVE SPACES               TO BUF-DTRANS.
044900     MOVE NEW-BEG-BAL-UNITS    TO SORT-BEG-UNITS.
045000     MOVE OLD-BEG-BAL-DOLLARS  TO SORT-BEG-DOLLARS.
045100     MOVE NEW-BEG-BAL-DOLLARS  TO SORT-BEG-DOLLARS-NED.
045200     MOVE WRITEOFF-AMT         TO SORT-WRITEOFF-AMT,
045300                                  TRANS-VALUE.
045400     MOVE STR-AVG-COST         TO SORT-AVG-COST.
045500     PERFORM 650-GET-DEPT.
045600     MOVE MATL-ACCOUNT         TO SORT-ACCOUNT,
045700                                  TRANS-ACCT.
045800     MOVE MATL-UNIT-MEASURE    TO SORT-UM,
045900                                  TRANS-UNIT-MEASURE.
046000     MOVE MATL-STORES-CODE     TO SORT-MATL-CODE,
046100                                  TRANS-STORES-CODE.
046200     MOVE MATL-CLASS           TO SORT-CLASS,
046300                                  TRANS-CLASS.
046400     MOVE ZERO                 TO TRANS-QTY.
046500     MOVE "AADJ"               TO TRANS-CODE.
046600     MOVE 1                    TO DATE-MODE.
046700     CALL "TDATECHK" USING DATE-CHECK-AREA.
046800     MOVE DATE-YMD-OUT         TO TRANS-DATE.

           IF TRANS-YY > "70"
               MOVE "19"             TO TRANS-DATE-CC
           ELSE
               MOVE "20"             TO TRANS-DATE-CC
           END-IF.

046900     MOVE DATE-UNFORMATTED-TIME-OUT  TO TRANS-TIME.
047000     MOVE ZERO                 TO TRANS-BALANCE-QTY.
047100     MOVE "TRAWWOFF"           TO TRANS-DOCUMENT-NUM.
047200
047300     IF UPDATE-SW = "YES"
047400         COMPUTE MATL-ACCTG-DOLLAR-CORR =
047500                 MATL-ACCTG-DOLLAR-CORR + TRANS-VALUE
               MOVE TRANS-DATE-CN  TO  MATL-DATE-LAST-UPDATE-CN
047600         PERFORM 670-PUT-DTRANS.
047800         PERFORM 680-UPDATE-MMATL-ACCUM.
047900
048000     RELEASE SORT-REC.
048100     MOVE SPACES               TO SORT-REC.
048200     MOVE ZERO                 TO SORT-BEG-UNITS
048300                                  SORT-BEG-DOLLARS
048400                                  SORT-BEG-DOLLARS-NED
048500                                  SORT-WRITEOFF-AMT
048600                                  SORT-AVG-COST.
048700
048900 650-GET-DEPT.
049000     MOVE MATL-CLASS          TO SVARDEPT-MATL-CLASS.
049100     CALL "SVARDEPT" USING ACCTG-BASE,
049200                           SVARDEPT-PARMS,
049300                           STATUS-AREA,
049400                           BU-DISPLAY-MSG,
049500                           BU-DISPLAY-FLDS
049600     IF BU-DISPLAY-MSG NOT = SPACES
049700         PERFORM 990-BLOWUP
049800     ELSE
049900         MOVE SVARDEPT-DEPT-CLASS-VAR  TO DEPT-ARG.

      ******* 12SEP1996 ADDED LOGIC TO VALIDATE THE DEPARTMENT NUMBER.
      *******   IF THE DEPT DOESN'T EXIST IN MCHT-ACCTS, THEN WE MOVE
      *******   ZEROES TO THE DEPARTMENT FIELD.

           PERFORM 9999-DBGET7-MCHT-ACCTS-DP-I.
           IF GOOD-CALL
               MOVE DEPT-ARG TO SORT-DEPT,
                                TRANS-DEPT
           ELSE
               IF NO-ENTRY
                   DISPLAY "PGM SVARDEPT RETURNED AN INVALID DEPT."
                   DISPLAY "CODE  = ", MATL-STORES-CODE
                   DISPLAY "CLASS = ", SVARDEPT-MATL-CLASS
                   DISPLAY "DEPT  = ", SVARDEPT-DEPT-CLASS-VAR
                   MOVE "0000" TO SORT-DEPT
                                  TRANS-DEPT
               ELSE
                   MOVE "DBGET MCHT-ACCTS * 650-GET-DEPT"
                     TO BU-DISPLAY-MSG
                   MOVE DEPT-ARG TO BU-DISPLAY-FLD (1)
                   PERFORM 990-BLOWUP.

       670-PUT-DTRANS.
           PERFORM 9999-DBPUT-DTRANS-MC-O.

           IF NOT GOOD-CALL
               MOVE "DBPUT DTRANS * 670-PD" TO BU-DISPLAY-MSG
               MOVE TRANS-STORES-CODE TO BU-DISPLAY-FLD (1)
               PERFORM 990-BLOWUP.

054100 680-UPDATE-MMATL-ACCUM.
           PERFORM 9999-DBUPDATE-MMATL-ACCUM-MC-O.
055800     IF GOOD-CALL
055900         NEXT SENTENCE
056000     ELSE
056100         MOVE "DBUPDATE MMATL * 200-MAIN" TO BU-DISPLAY-MSG
056200         PERFORM 990-BLOWUP.
057300
057400 699-PROCESS-EXIT.
057500     EXIT.
057600
057800 700-CREATE-REPORT SECTION.
       700-CREATE-REPORT-PARA.
057900     DISPLAY "BEGIN REPORT".
058000     PERFORM 710-BEGIN-REPORT.
058100     PERFORM 722-PROCESS-TRANS
058200        UNTIL NO-MORE-SORT = "YES".
058300     PERFORM 723-END-REPORT.
058400
058500*************************************************
058600**   IF UPDATE-SW = "YES" THEN UPDATE THE
058700**   RAW MATERIAL WRITEOFF INDICATOR DENOTING
058800**   THAT THIS PROGRAM WAS RAN.  THE INDICATOR
058900**   IS IN MACCOUNT-INFO (KEY=MTED)
059000*************************************************
059100
059200     IF UPDATE-SW = "YES"
059300         PERFORM 780-UPDATE-RAWWOFF-SW.
059400
059500*************************************************
059600**   CREATE SUMMARY REPORT JUST SHOWING THE
059700**   TOTAL WRITEOFF AMOUNT BY CLASS.
059800**   THIS REPORT GOES TO THE ACCOUNTING MGRS.
059900*************************************************
060000
060100     PERFORM 730-CREATE-SUMMARY-REPORT.
060200
060300**************************************************
060400**  BRANCH TO LAST STATEMENT OF OUTPUT SECTION  **
060500**  TO COMPLETE PROCESSING OF REPORT            **
060600**************************************************
060700
060800     GO TO 799-CREATE-EXIT.
060900
061000 710-BEGIN-REPORT.
061100     OPEN OUTPUT ONLINE-PRT.
061200     MOVE SPACES                  TO CLASS-SUMMARY-TABLE.
061300     MOVE ZEROS                   TO SUB.
061400     RETURN SORT-FILE
061500        AT END
061600            MOVE "YES" TO NO-MORE-SORT.
061700
061800     IF UPDATE-SW = "YES"
061900         MOVE "(ACTUAL)"          TO RUN-TYPE
062000     ELSE
062100         MOVE "(EDIT)"            TO RUN-TYPE.
062200     MOVE "DETAIL" TO REPORT-TYPE.
062300
062400     PERFORM 750-PRINT-HEADINGS.
062500
062700 722-PROCESS-TRANS.
062800     MOVE SORT-CLASS              TO SAVE-CLASS.
062900     MOVE ZEROS                   TO CLASS-END-DLRS-NEW,
063000                                     CLASS-END-DLRS-OLD,
063100                                     CLASS-WRITEOFF-AMT.
063200     PERFORM 724-PROCESS-DETAIL
063300         UNTIL NO-MORE-SORT = "YES" OR
063400               SAVE-CLASS NOT = SORT-CLASS.
063500     PERFORM 725-END-CLASS.
063600
063900 724-PROCESS-DETAIL.
064000     MOVE SORT-CLASS              TO PRT-CLASS.
064100     MOVE SORT-MATL-CODE          TO PRT-CODE.
064200     MOVE SORT-DEPT               TO PRT-DEPT.
064300     MOVE SORT-ACCOUNT            TO PRT-ACCOUNT.
064400     MOVE SORT-UM                 TO PRT-UM.
064500     MOVE SORT-BEG-UNITS          TO PRT-BEG-UNITS.
064600     MOVE SORT-AVG-COST           TO PRT-AVG-COST.
064700     MOVE SORT-BEG-DOLLARS        TO PRT-BEG-DLRS-OLD.
064800     MOVE SORT-BEG-DOLLARS-NED    TO PRT-BEG-DLRS-NEW.
064900     MOVE SORT-WRITEOFF-AMT       TO PRT-WRITEOFF-AMT.
065000     WRITE PRT-REC FROM DETAIL-LINE AFTER 1.
065100     ADD 1                        TO LINE-CNT.
065200     ADD SORT-BEG-DOLLARS         TO CLASS-END-DLRS-OLD.
065300     ADD SORT-BEG-DOLLARS-NED     TO CLASS-END-DLRS-NEW.
065400     ADD SORT-WRITEOFF-AMT        TO CLASS-WRITEOFF-AMT.
065500     IF LINE-CNT > 55
065600         PERFORM 750-PRINT-HEADINGS.
065700     RETURN SORT-FILE
065800        AT END
065900             MOVE "YES" TO NO-MORE-SORT.
066000
066100 723-END-REPORT.
066200     MOVE "TOTAL"                 TO DETAIL-LINE.
066300     MOVE TOTAL-END-DLRS-NEW      TO PRT-BEG-DLRS-NEW.
066400     MOVE TOTAL-END-DLRS-OLD      TO PRT-BEG-DLRS-OLD.
066500     MOVE TOTAL-WRITEOFF-AMT      TO PRT-WRITEOFF-AMT.
066600     WRITE PRT-REC FROM DETAIL-LINE AFTER 3.
066700
066800 725-END-CLASS.
066900     ADD 1                        TO SUB.
067000     MOVE SPACES                  TO DETAIL-LINE.
067100     MOVE SAVE-CLASS              TO CLASS-ENTRY (SUB),
067200                                     PRT-CLASS.
067300     MOVE CLASS-END-DLRS-NEW      TO PRT-BEG-DLRS-NEW.
067400     MOVE CLASS-END-DLRS-OLD      TO PRT-BEG-DLRS-OLD.
067500     MOVE CLASS-WRITEOFF-AMT      TO PRT-WRITEOFF-AMT,
067600                                     CLASS-TOTAL (SUB).
067700     WRITE PRT-REC FROM DETAIL-LINE AFTER 2.
067800     MOVE SPACES                  TO PRT-REC.
067900     WRITE PRT-REC AFTER 1.
068000     ADD 3                        TO LINE-CNT.
068100     ADD CLASS-END-DLRS-NEW       TO TOTAL-END-DLRS-NEW.
068200     ADD CLASS-END-DLRS-OLD       TO TOTAL-END-DLRS-OLD.
068300     ADD CLASS-WRITEOFF-AMT       TO TOTAL-WRITEOFF-AMT.
068400     MOVE ZEROS                   TO CLASS-END-DLRS-NEW,
068500                                     CLASS-END-DLRS-OLD,
068600                                     CLASS-WRITEOFF-AMT.
068700
068800 730-CREATE-SUMMARY-REPORT.
068900     MOVE SUB                     TO NO-OF-CLASSES.
069000     MOVE "SUMMARY"               TO REPORT-TYPE.
069100     MOVE ZERO                    TO TOTAL-WRITEOFF-AMT,
069200                                     PAGE-CNT.
069300     PERFORM 750-PRINT-HEADINGS.
069400
069500     PERFORM 732-PRINT-CLASS-LINE
069600         VARYING SUB FROM 1 BY 1
069700             UNTIL SUB > NO-OF-CLASSES.
069800
069900     MOVE TOTAL-WRITEOFF-AMT      TO PRT-TOTAL-DOLLARS.
070000     WRITE PRT-REC FROM TOT-LINE AFTER 3.
070100
070200 732-PRINT-CLASS-LINE.
070300     MOVE CLASS-ENTRY (SUB)       TO PRT-CLASS-2.
070400     MOVE CLASS-TOTAL (SUB)       TO PRT-CLASS-TOTAL.
070500     ADD CLASS-TOTAL (SUB)        TO TOTAL-WRITEOFF-AMT.
070600     WRITE PRT-REC FROM CLASS-TOT-LINE AFTER 2.
070700     ADD 2                        TO LINE-CNT.
070800     IF LINE-CNT > 55
070900         PERFORM 750-PRINT-HEADINGS.
071000
071100 750-PRINT-HEADINGS.
071200     MOVE 1                       TO DATE-MODE.
071300     CALL "TDATECHK" USING DATE-CHECK-AREA.
071400     MOVE DATE-SLASH-OUT          TO DATE-H1.
071500     MOVE DATE-FORMATTED-TIME-OUT TO TIME-H2.
071600     MOVE "MY"                    TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-O.
072400     IF GOOD-CALL
072500         NEXT SENTENCE
072600     ELSE
072700         MOVE "DBGET MACCOUNT-INFO * 750-PH" TO BU-DISPLAY-MSG
072800         MOVE MACCT-KEY TO BU-DISPLAY-FLD (1)
072900         PERFORM 990-BLOWUP.
073000
           PERFORM 9999-RESET-MACCOUNT-INFO-IK-O.

073100     MOVE MACCT-MONTH             TO MONTH-PARM.
073200     MOVE MACCT-YEAR              TO YEAR-PARM.
073300     MOVE MONTH-T (MONTH-PARM)    TO MONTH-H3.
073400     MOVE YEAR-PARM               TO YEAR-H3B.
073500     ADD 1                        TO PAGE-CNT.
073600     MOVE PAGE-CNT                TO PAGE-H2.
073700     WRITE PRT-REC FROM HEADER1 AFTER ADVANCING NEW-PAGE.
073800     WRITE PRT-REC FROM HEADER2 AFTER ADVANCING 1.
073900     WRITE PRT-REC FROM HEADER3 AFTER ADVANCING 1.
074000     WRITE PRT-REC FROM HEADER4 AFTER ADVANCING 2.
074100     WRITE PRT-REC FROM HEADER5 AFTER ADVANCING 1.
074200     WRITE PRT-REC FROM BLANK-LINE AFTER ADVANCING 1.
074300     MOVE 7                       TO LINE-CNT.
074400
074600*********************************************************
074700**                                                     **
074800**   THIS PROCEDURE UPDATES AN INDICATOR THAT STATES   **
074900**   THIS PROGRAM WAS EXECUTED SUCCESSFULLY.  THIS IS  **
075000**   PART OF THE MONTH-END PROCEDURE.  THE INDICATOR   **
075100**   IS LOCATED IN THE DATA SET 'MACCOUNT-INFO' UNDER  **
075200**   THE KEY 'MTED'                                    **
075300**                                                     **
075400*********************************************************
075500
075600 780-UPDATE-RAWWOFF-SW.
076700     MOVE "MTED" TO MACCT-KEY.
           PERFORM 9999-DBGET7-MACCOUNT-INFO-IK-O.
077500     IF GOOD-CALL
077600         NEXT SENTENCE
077700     ELSE
077800         MOVE "DBGET MACCT 'MTED'* 780-UBS" TO BU-DISPLAY-MSG
077900         MOVE MACCT-KEY           TO  BU-DISPLAY-FLD (2)
078000         PERFORM 990-BLOWUP.
078100
078200     MOVE "X"                     TO  MACCT-RAWWOFF-SW.
           PERFORM 9999-DBUPDATE-MACCOUNT-INFO-O.
078900     IF GOOD-CALL
079000         NEXT SENTENCE
079100     ELSE
079200         MOVE "DBUPDATE MACCT * 780-UBS" TO BU-DISPLAY-MSG
079300         MOVE MACCT-KEY           TO BU-DISPLAY-FLD (2)
079400         PERFORM 990-BLOWUP.
079500
080700 799-CREATE-EXIT.
080800     EXIT.
080900
081000 900-ERROR SECTION.
081100
081200 990-BLOWUP.
081300
081400***************************************************************
081500**   CALL 'CBLOWSRT' INSTEAD OF 'TBLOWUP' WHEN A BLOWUP      **
081600**   SITUATION OCCURS SINCE THIS PROGRAM USES THE 'SORT'     **
081700**   VERB.  'CBLOWSRT' WRITES ALL THE BLOWUP INFORMATION     **
081800**   TO A TEMPORARY FILE 'BLUPDATA' (WHICH WAS OPENED AT     **
081900**   THE BEGINNING OF THE PROGRAM) THE CLOSES IT. THEN IT    **
082000**   CREATESA A SON PROCESS 'XBLOWSRT' THAT READS THE        **
082100**   BLOWUP INFORMATION OUT OF 'BLUPDATA' AND CALLS          **
082200**   'TBLOWUP' USING THIS INFO.  SINCE THE NEW PROCESS       **
082300**   'XBLOWSRT' HAS ITS OWN STACK THE STACK OVERFLOW         **
082400**   PROBLEM IS AVOIDED.                                     **
082500***************************************************************
082600
082700     MOVE "TRAWWOFF"              TO  BU-PGM-NAME.
082800     CALL "CBLOWSRT" USING CBLOWSRT-PARMS,
082900                           ACCTG-BASE,
083000                           BU-PGM-NAME,
083100                           STATUS-AREA,
083200                           DUMMY-VIEW-AREA,
083300                           FILE-STATUS,
083400                           BU-DISPLAY-MSG,
083500                           BU-DISPLAY-FLDS.
083600
083800 1000-CLOSE-FILES.
083900     CLOSE ONLINE-PRT.
           PERFORM 9999-CLOSE-STUFF.

       9999-ROUTINES SECTION.

       9999-DBGET2-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           READ MMATL-ACCUM-MC-O NEXT INTO BUF-MATLACUM
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS-1 = "1" OR FILE-STATUS = "46"
               MOVE 11 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-INIT-MMATL-ACCUM-MC-O.
           MOVE SPACES TO MATLCODE OF MMATL-ACCUM-MC-REC-O.
           START MMATL-ACCUM-MC-O KEY >= MATLCODE OF
             MMATL-ACCUM-MC-REC-O
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE MMATL-CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBPUT-DTRANS-MC-O.
           MOVE 0 TO COND-WORD.
           WRITE DTRANS-MC-REC-O FROM BUF-DTRANS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBUPDATE-MMATL-ACCUM-MC-O.
           MOVE 0 TO COND-WORD.
           REWRITE MMATL-ACCUM-MC-REC-O FROM BUF-MATLACUM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MACCOUNT-INFO-IK-O.
           MOVE 0 TO COND-WORD.
           MOVE MACCT-KEY TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           READ MACCOUNT-INFO-IK-O INTO BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-RESET-MACCOUNT-INFO-IK-O.
           MOVE HIGH-VALUES TO INFOKEY OF MACCOUNT-INFO-IK-REC-O.
           START MACCOUNT-INFO-IK-O KEY > INFOKEY OF
              MACCOUNT-INFO-IK-REC-O
               INVALID KEY MOVE "00" TO FILE-STATUS.

       9999-DBUPDATE-MACCOUNT-INFO-O.
           MOVE 0 TO COND-WORD.
           REWRITE MACCOUNT-INFO-IK-REC-O FROM BUF-MACCT-INFO
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               MOVE 99 TO COND-WORD.

       9999-DBGET7-MCHT-ACCTS-DP-I.
           MOVE 0 TO COND-WORD.
           MOVE DEPT-ARG TO DEPT OF MCHT-ACCTS-DP-REC-I.
           READ MCHT-ACCTS-DP-I INTO BUF-MCHTACCTS
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
               IF FILE-STATUS NOT = "00"
                   MOVE 99 TO COND-WORD.

       9999-OPEN-STUFF.
           OPEN I-O   MMATL-ACCUM-MC-O     .
           OPEN INPUT MSTORERM-CD-I        .
           OPEN I-O   DTRANS-MC-O          .
           OPEN I-O   MACCOUNT-INFO-IK-O   .
           OPEN INPUT MCHT-ACCTS-DP-I.

       9999-CLOSE-STUFF.
           CLOSE      MMATL-ACCUM-MC-O     .
           CLOSE      MSTORERM-CD-I        .
           CLOSE      DTRANS-MC-O          .
           CLOSE      MACCOUNT-INFO-IK-O   .
           CLOSE      MCHT-ACCTS-DP-I.
