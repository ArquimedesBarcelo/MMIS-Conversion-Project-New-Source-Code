000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.           TRAWWOFF.
000400 AUTHOR.               KURT MOVSESIAN.
000500 DATE-WRITTEN.         JUNE 15, 1989.
000600*INSTALLATION.         GOODYEAR TIRE AND RUBBER CO.
000800*REMARKS.    RAW MATERIAL ENDING DOLLAR WRITEOFF.
000900*            THIS PROGRAM WILL COMPUTE WHAT THE ENDING
001000*            DOLLARS WILL BE AND THEN COMPARE THAT TO
001100*            ENDING DOLLARS USING THE NEW AVERAGE COST TIMES
001200*            ENDING UNITS.  ANY DIFFERENCE WILL BE WRITTEN
001300*            OFF TO VARIANCE.  A REPORT WILL SHOW THE VARIANCE
001400*            WRITEOFFS.  THIS WILL CAUSE BEGINNING DOLLARS
001500*            DIVIDED BY BEGINNING UNITS TO ALWAYS EQUAL AVERAGE
001600*            COST.
      *C
      *C   25FEB1994    DAVE PLUM
      *C     ADDED CALL TO THE COBOL ERROR HANDLER - MCXCBLERR.
      *C
      *C   12SEP1996    DAVE PLUM
      *C     REVISED FOR CENTURY DATABASE CHANGES.
      *C     ALSO ADDED LOGIC TO VALIDATE THE DEPT BEFORE WRITING
      *C     DTRANS RECORDS.
      *C
001800 ENVIRONMENT DIVISION.
001900 CONFIGURATION SECTION.
002000 SOURCE-COMPUTER.      HP-3000.
002100 OBJECT-COMPUTER.      HP-3000.
       COPY SPECIALN IN COPYLIB.
002300
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT MMATL-ACCUM-MC-O
               ASSIGN TO DATABASE-MCFLCA0601
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT MSTORERM-CD-I
               ASSIGN TO DATABASE-MCFLCS0201
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT DTRANS-MC-O
               ASSIGN TO DATABASE-MCFLCA0701
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                 WITH DUPLICATES
               FILE STATUS IS FILE-STATUS.

           SELECT MACCOUNT-INFO-IK-O
               ASSIGN TO DATABASE-MCFLCA0101
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

           SELECT ONLINE-PRT ASSIGN TO PRINTER-MCPRT.

           SELECT SORT-FILE ASSIGN TO DISK-SORT.

           SELECT MCHT-ACCTS-DP-I
               ASSIGN TO DATABASE-MCFLCA0301
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

