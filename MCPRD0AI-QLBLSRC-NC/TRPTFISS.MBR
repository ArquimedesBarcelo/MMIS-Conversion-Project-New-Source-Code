       IDENTIFICATION DIVISION.
       PROGRAM-ID.     TRPTFISS.
       AUTHOR.         J S BUNGO.
       DATE-WRITTEN.   JUN 05, 1995.
      *REMARKS.        THIS PROGRAM PRINTS A REPORT SHOWING ALL
      *                FAILED STOREROOM ISSUES DUE TO INSUFFICIENT
      *                ON HAND THAT WAS RECORDED IN THE FILE
      *                DSTRWITH (5900).  THIS PROGRAM WILL ALSO
      *                DELETE THOSE RECORDS THAT ARE NOT FROM THE
      *                CURRENT MONTH ENSURING THAT ONLY MONTH TO
      *                DATE DATA IS KEPT IN THE FILE.
      *
      *C 06/13/96   JEFF BUNGO
      *C  EXPAND DATE FIELDS FOR YEAR 2000 COMPLIANCE.
      *C  RECOMPILE TO PICK UP NEW FILE FORMATS.
      *C
      *C  11/25/97    JEFF BUNGO   REQ #97-017
      *C     ADD USAGE FIELDS FOR DIRECT DELIVERY.  DD USAGE
      *C     TO BE STORED IN ADDITIONAL FIELD AND TOTAL USAGE.
      *C     STORE ISSUE USAGE CALCULATED BY TOTAL USAGE - DD USAGE.
      *C
      *C 12/03/97   CA YODER
      *C   Y2K TESTING FOUND PROBLEM WITH THE DELETION OF OLD
      *C   RECORDS IN FILE; CENTURY NOT INCLUDED.  CORRECTED PROBLEM.
      *C

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.    IBM-AS400.
       OBJECT-COMPUTER.    IBM-AS400.
       SPECIAL-NAMES.      C01 IS NEW-PAGE.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE ASSIGN TO PRINTER-MCPRT.
           SELECT SORT-FILE ASSIGN  TO DISK-SORT.
           SELECT DSTRWITH
                  ASSIGN TO DATABASE-MCFLCS5901
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                    WITH DUPLICATES
                  FILE STATUS IS FILE-STATUS.
           SELECT MSTORERM
                  ASSIGN TO DATABASE-MCFLCS0201
                  ORGANIZATION IS INDEXED
                    ACCESS MODE IS DYNAMIC
                  RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS IS FILE-STATUS.
           SELECT USAGEFIL
               ASSIGN TO DATABASE-MCFLCSUSAG
               ORGANIZATION IS INDEXED
                 ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS FILE-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  PRINT-FILE RECORD CONTAINS 132 CHARACTERS
           LABEL RECORD IS OMITTED
           DATA RECORD IS PRT-REC.
       01  PRT-REC                 PIC X(132).

       SD  SORT-FILE RECORD CONTAINS 62 CHARACTERS
           DATA RECORD IS SORT-REC.
       01  SORT-REC.
           COPY DDS-MCRPCS5900   OF MCFLCS5901.
       FD  DSTRWITH
           LABEL RECORDS ARE STANDARD.
       01  DSTRWITH-REC.
           COPY DDS-MCRPCS5900   OF MCFLCS5901.
       FD  MSTORERM
           LABEL RECORDS ARE STANDARD.
       01  MSTORERM-REC.
           COPY DDS-MCRPCS0200   OF MCFLCS0201.
       FD  USAGEFIL
           LABEL RECORDS ARE STANDARD.
       01  USAGEFIL-REC.
           COPY DDS-MCRPCSUSAG  OF MCFLCSUSAG.

       WORKING-STORAGE SECTION.
       77  NO-ARG                  PIC X     VALUE SPACE.
       77  LINE-K                  PIC 99    VALUE 60 COMP-4.
       77  PAGE-K                  PIC 9(3)  VALUE 0  COMP-4.
       77  TOT-USAGE-12            PIC 9(9)  VALUE 0.
       77  SUB                     PIC 99    VALUE 0.
       77  SHORT-QTY               PIC 9(9)  VALUE 0.
       77  SHORT-VALUE             PIC 9(11)V9(4) VALUE 0.
       77  GRAND-SHORT-QTY         PIC S9(10) VALUE +0.
       77  GRAND-SHORT-VAL         PIC S9(11)V9(4) VALUE +0.
       77  CODE-SEARCH             PIC X(10) VALUE "CORP-CODE;".
       77  CODE-ARG                PIC X(8)  VALUE SPACES.
       01  FILE-STATUS.
           05  FILE-STATUS-1          PIC X      VALUE SPACES.
           05  FILE-STATUS-2          PIC X      VALUE SPACES.

       01  HOLD-WITH-DATE.
           05  HOLD-WITH-YEAR         PIC X(4).
           05  FILLER                 PIC X(4).

       01  SCOPE   PIC X.

       01  SYSTEM-DATE.
           05  SYSTEM-YEAR          PIC X(02).
           05  SYSTEM-MONTH         PIC X(02).
           05  FILLER               PIC X(02).
       01  FIRST-MONTH-READ         PIC X(02)     VALUE "99".
       01  FIRST-YEAR-READ-CN.
           05  FIRST-YEAR-CC        PIC X(02).
           05  FIRST-YEAR-READ      PIC X(02)     VALUE "99".
       01  SYSTEM-YEAR-CN.
           05  SYSTEM-CC            PIC X(02).
           05  SYSTEM-YEAR-2        PIC X(02).

       01  MESSAGE-AREA.
           05  NO-SORTED-RECORDS   PIC X(31) VALUE
                                   "ZERO CODES QUALIFIED FOR REPORT".

       01  SWITCH-AREA.
           05  END-OF-INPUT-FILE               PIC X VALUE "N".
               88  ALL-INPUT-RECORDS-PROCESSED       VALUE "Y".
           05  END-OF-SORT-FILE                PIC X VALUE "N".
               88  ALL-SORTED-RECORDS-PROCESSED      VALUE "Y".
           05  BLOWUP-SWITCH                   PIC X VALUE "N".

       COPY TDATECHK IN COPYLIB.

       COPY VCOMAREA IN COPYLIB.

       COPY DATAB IN COPYLIB.

       COPY TBLOWUP IN COPYLIB.

       COPY OVRPFDATA IN COPYLIB.

       COPY THDPRTA  IN COPYLIB.

       COPY CDESC IN COPYLIB.

      *-------------- ESCAPE SEQUENCES
       COPY ESCNAM2 IN COPYLIB.

       01  COMPRESS-PRINT             PIC X(8).

       01  NORMAL-PRINT               PIC X(8).

       COPY DSTRWITH IN COPYLIB.
       COPY MSTORERM IN COPYLIB.
       COPY USAGEFIL IN COPYLIB.

       01  DATE-PRINT.
           05  FILLER                PIC X(06).
           05  DATE-PRINT-CC         PIC X(02).
           05  DATE-PRINT-YY         PIC X(02).

       01  HDR-1.
           05  FILLER      PIC X(10) VALUE " TRPTFISS ".
           05  FILLER      PIC X(34) VALUE SPACES.
           05  FILLER      PIC X(20) VALUE "REJECTED WITHDRAWALS".
           05  FILLER      PIC X(16) VALUE " DUE TO ON HAND ".
           05  FILLER      PIC X(09) VALUE "SHORTAGES".
           05  FILLER      PIC X(23) VALUE SPACES.
           05  PRT-DATE    PIC X(8)  VALUE SPACES.
           05  FILLER      PIC X(4)  VALUE SPACES.
           05  PRT-TIME    PIC X(8) VALUE SPACES.

       01  HDR-2.
           05  FILLER      PIC X(7)  VALUE "  PAGE ".
           05  PRT-PAGE    PIC 999   VALUE ZEROS.
           05  FILLER      PIC X(41) VALUE SPACES.
           05  FILLER      PIC X(21) VALUE "Month to Date ending ".
           05  HDR2-DATE   PIC X(08) VALUE SPACES.
           05  FILLER      PIC X(47) VALUE SPACES.

       01  HDR-3.
           05  FILLER        PIC X(09) VALUE "Requested".
           05  FILLER        PIC X(02) VALUE SPACES.
           05  FILLER        PIC X(07) VALUE "On Hand".
           05  FILLER        PIC X(02) VALUE SPACES.
           05  FILLER        PIC X(09) VALUE "Shortfall".
           05  FILLER        PIC X(21) VALUE SPACES.
           05  FILLER        PIC X(09) VALUE "Shortfall".
           05  FILLER        PIC X(07) VALUE SPACES.
           05  FILLER        PIC X(05) VALUE "Usage".
           05  FILLER        PIC X(05) VALUE SPACES.
           05  FILLER        PIC X(05) VALUE "Usage".
           05  FILLER        PIC X(24) VALUE SPACES.
           05  FILLER        PIC X(03) VALUE "Chg".
           05  FILLER        PIC X(03) VALUE SPACES.
           05  FILLER        PIC X(03) VALUE "Exp".
           05  FILLER        PIC X(18) VALUE SPACES.

       01  HDR-4.
           05  FILLER        PIC X(03) VALUE SPACES.
           05  FILLER        PIC X(03) VALUE "Qty".
           05  FILLER        PIC X(07) VALUE SPACES.
           05  FILLER        PIC X(03) VALUE "Qty".
           05  FILLER        PIC X(07) VALUE SPACES.
           05  FILLER        PIC X(03) VALUE "Qty".
           05  FILLER        PIC X(08) VALUE SPACES.
           05  FILLER        PIC X(08) VALUE "Avg Cost".
           05  FILLER        PIC X(10) VALUE SPACES.
           05  FILLER        PIC X(05) VALUE "Value".
           05  FILLER        PIC X(06) VALUE SPACES.
           05  FILLER        PIC X(10) VALUE "Last 12 Mo".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(10) VALUE "Month-Date".
           05  FILLER        PIC X(02) VALUE SPACES.
           05  FILLER        PIC X(07) VALUE "Maximum".
           05  FILLER        PIC X(03) VALUE SPACES.
           05  FILLER        PIC X(07) VALUE "Reorder".
           05  FILLER        PIC X(02) VALUE SPACES.
           05  FILLER        PIC X(04) VALUE "Dept".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(05) VALUE "Class".
           05  FILLER        PIC X(02) VALUE SPACES.
           05  FILLER        PIC X(03) VALUE "Emp".
           05  FILLER        PIC X(05) VALUE SPACES.
           05  FILLER        PIC X(04) VALUE "Date".
           05  FILLER        PIC X(03) VALUE SPACES.

       01  HDR-5.
           05  FILLER        PIC X(09) VALUE "---------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(09) VALUE "---------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(09) VALUE "---------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(15) VALUE "---------------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(16) VALUE "----------------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(10) VALUE "----------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(10) VALUE "----------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(09) VALUE "---------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(09) VALUE "---------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(04) VALUE "----".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(06) VALUE "------".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(04) VALUE "----".
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(10) VALUE "----------".

       01  PRT-CODE-DATA.
           05  PRT-CODE      PIC X(07) VALUE SPACES.
           05  FILLER        PIC X(04) VALUE SPACES.
           05  PRT-KWRD-MOD  PIC X(51) VALUE SPACES.
           05  FILLER        PIC X(70) VALUE SPACES.

       01  PRT-ITEM-DATA.
           05  PRT-REQ-QTY   PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-ON-HAND   PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-SHORT-QTY PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-AVG-COST  PIC Z(9)9.9999 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-SHORT-VAL PIC Z(10)9.9999 VALUE ZEROS.
           05  FILLER        PIC X(02) VALUE SPACES.
           05  PRT-USE-12    PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(02) VALUE SPACES.
           05  PRT-USE-MTD   PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-MAX       PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-REORDER   PIC Z(8)9 VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-CHG-DEPT  PIC X(04) VALUE SPACES.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-EXP-CLASS PIC X(06) VALUE SPACES.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-EMP       PIC X(04) VALUE SPACES.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  PRT-WITH-DATE PIC X(10) VALUE SPACES.

       01  GRAND-TOTAL-HDR.
           05  FILLER        PIC X(19) VALUE SPACES.
           05  FILLER        PIC X(10) VALUE "==========".
           05  FILLER        PIC X(17) VALUE SPACES.
           05  FILLER        PIC X(16) VALUE "================".
           05  FILLER        PIC X(70) VALUE SPACES.

       01  GRAND-TOTAL-LINE.
           05  FILLER        PIC X(05) VALUE SPACES.
           05  FILLER        PIC X(14) VALUE "SHORTFALL QTY:".
           05  TOT-SHORT-QTY PIC Z(10) VALUE ZEROS.
           05  FILLER        PIC X(01) VALUE SPACES.
           05  FILLER        PIC X(16) VALUE "SHORTFALL VALUE:".
           05  TOT-SHORT-VAL PIC Z(10)9.9(4) VALUE ZEROES.
           05  FILLER        PIC X(70) VALUE SPACES.

       LINKAGE SECTION.
       COPY THDPRTB IN COPYLIB.
       01  DATA-LINE                  PIC X(112).

       PROCEDURE DIVISION USING HD-ROUTE-DATA, DATA-LINE.
       BEGIN-SORT SECTION.
       1-HOUSEKEEPING.
           MOVE "C" TO SCOPE.
           CALL "MCXCBLERR" USING SCOPE.

           ACCEPT SYSTEM-DATE FROM DATE.
           MOVE SYSTEM-YEAR       TO SYSTEM-YEAR-2.
           IF SYSTEM-YEAR > "70"
               MOVE "19"          TO SYSTEM-CC
           ELSE
               MOVE "20"          TO SYSTEM-CC.

      *---------- OPEN THE PRINT FILE, GET THE FILE NUMBER OF THE PRINT
      *---------- FILE, AND PRINT THE HEADER PAGE.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.

           MOVE "DHDR100.PUB"   TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
               HD-ROUTE-DATA, ESC-NAME.
           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR * TRPTFS" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "        TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE             TO BU-DISPLAY-FLD9 (1)
               GO TO 2-BLOWUP.

           MOVE 1 TO DATE-MODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT  TO  PRT-DATE HDR2-DATE.
           MOVE DATE-FORMATTED-TIME-OUT  TO PRT-TIME.


           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI     TO COMPRESS-PRINT.
           MOVE CHAR-10PI       TO NORMAL-PRINT.

           OPEN INPUT DSTRWITH
                      MSTORERM
                      USAGEFIL.

           SORT SORT-FILE
                ON ASCENDING KEY CORPCDE OF SORT-REC
                INPUT  PROCEDURE IS 8-INPUT-RECORDS
                OUTPUT PROCEDURE IS 9-WRITE-RECORDS.

       2-EOJ.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
              WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.
           CLOSE PRINT-FILE.
           CLOSE MSTORERM
                 DSTRWITH
                 USAGEFIL.

      *-----REMOVE NON CURRENT MONTH RECORDS
           IF FIRST-MONTH-READ < SYSTEM-MONTH
              OR FIRST-YEAR-READ-CN < SYSTEM-YEAR-CN
               OPEN I-O DSTRWITH
               READ DSTRWITH FIRST RECORD INTO BUF-DSTRWITH
                   AT END MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               PERFORM UNTIL
                 FILE-STATUS NOT = "00"  OR
                 (WITH-DATE-MM = SYSTEM-MONTH AND
                  WITH-DATE-YY = SYSTEM-YEAR)
                   MOVE WITH-DATE TO HOLD-WITH-DATE
                   IF WITH-DATE-MM < SYSTEM-MONTH OR
                      HOLD-WITH-YEAR < SYSTEM-YEAR-CN
                       DELETE DSTRWITH
                           INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                       END-DELETE
                       IF FILE-STATUS NOT = "00"
                           MOVE "DELETE ERROR DSTRWITH"  TO
                             BU-DISPLAY-MSG
                           GO TO 2-BLOWUP
                       END-IF
                   END-IF
                   READ DSTRWITH NEXT INTO BUF-DSTRWITH
                      AT END MOVE FILE-STATUS TO FILE-STATUS
                   END-READ
               END-PERFORM
               CLOSE DSTRWITH
           END-IF.
           GOBACK.

      *************************************************************
      *                    BLOWUP   ROUTINE                       *
      *************************************************************
       2-BLOWUP.
           WRITE PRT-REC FROM NORMAL-PRINT AFTER ADVANCING 0.

           CALL "TBLOWUP" USING BASE, BU-PGM-NAME, STATUS-AREA,
                 VIEW-COMAREA, FILE-STATUS, BU-DISPLAY-MSG,
                 BU-DISPLAY-AREA.

       8-INPUT-RECORDS SECTION.
           READ DSTRWITH FIRST RECORD INTO BUF-DSTRWITH
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "00"
               MOVE WITH-DATE-MM TO FIRST-MONTH-READ
               MOVE WITH-DATE-YY TO FIRST-YEAR-READ
               IF FIRST-YEAR-READ > "70"
                   MOVE "19"     TO FIRST-YEAR-CC
               ELSE
                   MOVE "20"     TO FIRST-YEAR-CC
               END-IF
               PERFORM 81-PROCESS-INPUT-RECORDS THRU 81-PIR-EXIT UNTIL
                       ALL-INPUT-RECORDS-PROCESSED.
           GO TO 8-IR-EXIT.

       81-PROCESS-INPUT-RECORDS.
           MOVE SPACES          TO SORT-REC.
           MOVE BUF-DSTRWITH TO SORT-REC.
           RELEASE SORT-REC.

           READ DSTRWITH NEXT INTO BUF-DSTRWITH
               AT END MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS NOT = "00"
               IF FILE-STATUS = "10" OR "14" OR "46"
                   MOVE "Y" TO END-OF-INPUT-FILE
                   GO TO 81-PIR-EXIT
               ELSE
                   MOVE "READ ERROR DSTRWITH*81-PIR" TO BU-DISPLAY-MSG
                   GO TO 2-BLOWUP.
       81-PIR-EXIT.
           EXIT.

       8-IR-EXIT.
           EXIT.

       9-WRITE-RECORDS SECTION.
           IF PAPER-IS-132-COLS
               NEXT SENTENCE
           ELSE
              WRITE PRT-REC FROM COMPRESS-PRINT AFTER ADVANCING 0.

           RETURN SORT-FILE INTO BUF-DSTRWITH AT END
               MOVE "Y" TO END-OF-SORT-FILE
               MOVE  1  TO PRT-PAGE
               WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE
               WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINES
               WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 2 LINES
               WRITE PRT-REC FROM HDR-4 AFTER ADVANCING 1 LINES
               WRITE PRT-REC FROM HDR-5 AFTER ADVANCING 1 LINES
               MOVE NO-SORTED-RECORDS TO PRT-REC
               WRITE PRT-REC AFTER ADVANCING 2 LINES
               GO TO 2-EOJ.

           PERFORM 92-PROCESS-SORTED-RECORDS THRU 92-PSR-EXIT
                   UNTIL ALL-SORTED-RECORDS-PROCESSED.

           MOVE GRAND-SHORT-QTY TO TOT-SHORT-QTY.
           MOVE GRAND-SHORT-VAL TO TOT-SHORT-VAL.
           WRITE PRT-REC FROM GRAND-TOTAL-HDR
                   AFTER ADVANCING 2 LINES.
           WRITE PRT-REC FROM GRAND-TOTAL-LINE
                   AFTER ADVANCING 1 LINE.
           GO TO 9-WR-EXIT.

       92-PROCESS-SORTED-RECORDS.
           IF LINE-K > 59
               ADD     1      TO PAGE-K
               MOVE    5      TO LINE-K
               MOVE PAGE-K    TO PRT-PAGE
               WRITE PRT-REC FROM HDR-1 AFTER ADVANCING NEW-PAGE
               WRITE PRT-REC FROM HDR-2 AFTER ADVANCING 1 LINES
               WRITE PRT-REC FROM HDR-3 AFTER ADVANCING 2 LINES
               WRITE PRT-REC FROM HDR-4 AFTER ADVANCING 1 LINES
               WRITE PRT-REC FROM HDR-5 AFTER ADVANCING 1 LINES

           MOVE SPACES        TO PRT-REC
                                 PRT-CODE-DATA
                                 PRT-ITEM-DATA.
           MOVE  WITH-CORP-CODE TO CODE-ARG.

           IF CODE-ARG NOT = PRT-CODE
      *---------GET MSTORERM INFORMATION
               MOVE CODE-ARG TO CORPCDE OF MSTORERM-REC
               READ MSTORERM INTO BUF-MSTORERM
                   INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
               END-READ
               IF FILE-STATUS NOT = "00"
                  MOVE "CODE NO LONGER EXISTS AT PLANT" TO PRT-KWRD-MOD
               ELSE
      *------------- GET KEYWORD MODIFIER
                  MOVE 1 TO CDESC-LINES-TO-GET
                  MOVE "P" TO CDESC-LANGUAGE-OPTION
                  MOVE "K" TO CDESC-DESC-OPTION
                  MOVE "N" TO  CDESC-LOCAL-DESC-OPTION
                  CALL "CDESC" USING CDESC-RET-CODE, BASE, STATUS-AREA,
                     BU-DISPLAY-MSG, CODE-ARG, CDESC-DATA
                  IF BU-DISPLAY-MSG-1 NOT = SPACES
                      MOVE "* NO KWRD/MOD ON FILE *" TO PRT-KWRD-MOD
                  ELSE
                      MOVE CDESC-KWM (1) TO PRT-KWRD-MOD
                  END-IF
      *-------------GET USAGE INFORMATION
                  MOVE CODE-ARG TO CORPCDE OF USAGEFIL-REC
                  READ USAGEFIL INTO BUF-USAGEFIL
                      INVALID KEY MOVE FILE-STATUS TO FILE-STATUS
                  END-READ
                  IF FILE-STATUS NOT = "00"
                      MOVE ZEROS TO TOT-USAGE-12
                  ELSE
                      MOVE 0 TO SUB TOT-USAGE-12
                      PERFORM 12 TIMES
                          ADD 1 TO SUB
                          ADD K-MTH-USAGE(SUB) TO TOT-USAGE-12
                      END-PERFORM
                  END-IF
               END-IF
               MOVE CORPCDE OF SORT-REC TO PRT-CODE
               WRITE PRT-REC FROM PRT-CODE-DATA AFTER ADVANCING 2 LINES
               ADD 2 TO LINE-K
           END-IF.
           IF LINE-K = 5
               WRITE PRT-REC FROM PRT-CODE-DATA AFTER ADVANCING 1 LINE
           END-IF.

       92-CONT.
           COMPUTE SHORT-QTY   = WITH-QUANTITY - WITH-ONHAND.
           COMPUTE SHORT-VALUE = SHORT-QTY * WITH-AVG-COST.
           COMPUTE GRAND-SHORT-QTY = GRAND-SHORT-QTY + SHORT-QTY.
           COMPUTE GRAND-SHORT-VAL = GRAND-SHORT-VAL + SHORT-VALUE.
           MOVE WITH-QUANTITY TO PRT-REQ-QTY.
           MOVE WITH-ONHAND   TO PRT-ON-HAND.
           MOVE SHORT-QTY     TO PRT-SHORT-QTY.
           MOVE WITH-AVG-COST TO PRT-AVG-COST.
           MOVE SHORT-VALUE   TO PRT-SHORT-VAL.
           MOVE TOT-USAGE-12  TO PRT-USE-12.
           MOVE WITH-MTD-USAGE TO PRT-USE-MTD.
           MOVE WITH-MAX      TO PRT-MAX.
           MOVE WITH-REORDER  TO PRT-REORDER.
           MOVE WITH-CHRG-DEPT TO PRT-CHG-DEPT.
           MOVE WITH-EXP-CLASS TO PRT-EXP-CLASS.
           MOVE WITH-EMPLOYEE  TO PRT-EMP.

      *------CONVERT DATE TO CORRECT DISPLAYABLE FORMAT
      *------ THEN ADD IN THE CENTURY FOR THE DISPLAY
           MOVE 4 TO DATE-MODE.
           MOVE WITH-DATE-YMD  TO DATE-VALIDATE-IN.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE DATE-SLASH-OUT TO DATE-PRINT.
           MOVE DATE-PRINT-CC  TO DATE-PRINT-YY.
           MOVE WITH-DATE-CC   TO DATE-PRINT-CC.
           MOVE DATE-PRINT     TO PRT-WITH-DATE.

           ADD  1  TO LINE-K.
           WRITE PRT-REC FROM PRT-ITEM-DATA AFTER ADVANCING 1 LINES.

           RETURN SORT-FILE INTO BUF-DSTRWITH AT END
               MOVE "Y"       TO END-OF-SORT-FILE.

       92-PSR-EXIT.
           EXIT.

       9-WR-EXIT.
           EXIT.

       COPY OVRPFCALL IN COPYLIB.
