       IDENTIFICATION DIVISION.
       PROGRAM-ID.             TAUTOTWO.
       AUTHOR.                 W. ROXBURY.
       INSTALLATION.           GOODYEAR TIRE AND RUBBER CO.
      *REMARKS. STAND-ALONE VERSION OF THE AUTOMATIC WO-QUEUE
      *               BACKLOG INQUIRY FOR EITHER ONE OR TWO ZONES.
      *          **** CHANGED REFRESH CYCLE TIME TO 5 MINUTES 6/8/88. WDR.
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.        IBM-AS400.
       OBJECT-COMPUTER.        IBM-AS400.
       SPECIAL-NAMES.          I-O-FEEDBACK     IS I-O-FEEDBACK-AREA
                               REQUESTOR        IS WORK-STATION
                               SYSTEM-CONSOLE   IS CONSOLE
                               LOCAL-DATA       IS LOCAL-DATA-AREA.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-OPEN-QUEUE
                  ASSIGN       TO DATABASE-MCFLMM1901
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-ZONE-PRTY
                  ASSIGN       TO DATABASE-MCFLMM0501
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-BASIC
                  ASSIGN       TO DATABASE-MCFLMM1001
                  ORGANIZATION IS INDEXED
                  ACCESS MODE  IS DYNAMIC
                  RECORD KEY   IS EXTERNALLY-DESCRIBED-KEY
                               WITH DUPLICATES
                  FILE STATUS  IS FILE-STAT.

           SELECT WO-LAST-NUM-USED
                  ASSIGN       TO DATABASE-MCFPMM0800
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS RANDOM
                  RELATIVE KEY IS ARG-NO
                  FILE STATUS  IS FILE-STAT.

           SELECT DISPLAY-FILE
                  ASSIGN       TO WORKSTATION-ZAUTOTWO-SI
                  ORGANIZATION IS TRANSACTION
                  ACCESS MODE  IS SEQUENTIAL
                  FILE STATUS  IS SCREEN-STATUS
                               MAJOR-MINOR
                  CONTROL-AREA IS SCREEN-CONTROL.

           SELECT OUT-FILE
                  ASSIGN       TO DISK-AUTOTWO
                  ORGANIZATION IS RELATIVE
                  ACCESS MODE  IS DYNAMIC
                  RELATIVE KEY IS ACT-KEY
                  FILE STATUS  IS FILE-STAT.

           SELECT SORT-FILE
                  ASSIGN       TO DISK-SORTFILE.

       DATA DIVISION.
       FILE SECTION.
       FD  WO-OPEN-QUEUE
           LABEL RECORDS       ARE STANDARD.
       01  WOQ-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1901.

       FD  WO-ZONE-PRTY
           LABEL RECORDS       ARE STANDARD.
       01  ZP-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM0501.

       FD  WO-BASIC
           LABEL RECORDS       ARE STANDARD.
       01  VWO-REC.
           COPY DDS-ALL-FORMATS OF MCFLMM1001.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS       ARE STANDARD.
       01  WO-REC.
           COPY DD-ALL-FORMATS OF MCFPMM0800.

       FD  DISPLAY-FILE
           LABEL RECORDS       ARE OMITTED.
       01  DISPLAY-REC         PIC X(2000).

       FD  OUT-FILE RECORD     CONTAINS 60 CHARACTERS
           LABEL RECORDS       ARE OMITTED
           DATA RECORD         IS OUT-REC.
       01  OUT-REC.
           05  OUT-WO-QUEUE    PIC 99.
           05  OUT-CC-NUM      PIC XXXX.
           05  OUT-EQUIP       PIC X(06).
           05  OUT-DOWN        PIC X.
           05  OUT-FILLER      PIC X.
           05  OUT-WO-NUM      PIC X(10).
           05  OUT-DESC        PIC X(30).
           05  OUT-SKILL-1     PIC XX.
           05  OUT-SKILL-2     PIC XX.
           05  OUT-SKILL-3     PIC XX.

       SD  SORT-FILE RECORD    CONTAINS 60 CHARACTERS
           DATA RECORD         IS SORT-REC.
       01  SORT-REC.
           05  SORT-WO-QUEUE   PIC 99.
           05  SORT-CC-NUM     PIC XXXX.
           05  SORT-EQUIP.
               10  SORT-EQ1    PIC X.
               10  SORT-EQ2    PIC X.
               10  SORT-EQ3    PIC X.
               10  SORT-EQ4    PIC X.
               10  SORT-EQ5    PIC X.
               10  SORT-EQ6    PIC X.
           05  SORT-DOWN       PIC X.
           05  SORT-FILLER     PIC X.
           05  SORT-WO-NUM     PIC X(10).
           05  SORT-DESC       PIC X(30).
           05  SORT-SKILL-1    PIC XX.
           05  SORT-SKILL-2    PIC XX.
           05  SORT-SKILL-3    PIC XX.

       WORKING-STORAGE SECTION.
       77  ARG-NO                    PIC 9999  VALUE 1.
       77  ACT-KEY                   PIC 9(8) BINARY SYNC VALUE ZEROS.
       77  MAX-KEY                   PIC S9(8) BINARY SYNC VALUE ZEROS.
       77  SAVE-KEY                  PIC S9(8) BINARY SYNC VALUE ZEROS.
       77  EOF-SW                    PIC 9      VALUE 0.
       77  ALARM                     PIC 9      VALUE 0.
       77  FILE-SW                   PIC X      VALUE "B".
       77  QUEUE-SW                  PIC X.
       77  QUEUE-ERROR               PIC X(76).
       77  SAVE-TITLE                PIC X(10)  VALUE SPACES.
       77  DWO-BUFFER                PIC X(10)  VALUE SPACES.
       77  SCREEN-SAVE               PIC X(860) VALUE SPACES.
       77  TRUE-VAL                  PIC 1      VALUE B"1".

       01  PASSWORD-INFORMATION.
           05  NAME-OF-PROGRAM     PIC X(08) VALUE "TAUTOTWO".
           05  PROGRAM-TYPE        PIC X(02) VALUE "IN".
           05  PROGRAM-RELEASE     PIC X(12) VALUE " J0100010001".
           05  PROGRAM-DESCRIPTION.
               10  PROG-DESCA1 PIC X(30) VALUE
                   "SPECIAL VERSION IF THE AUTO-QU".
               10  PROG-DESCA2 PIC X(30) VALUE
                   "EUE PROGRAM TO ALLOW COMBINING".
               10  PROG-DESCB1 PIC X(30) VALUE
                   "TWO ZONES INTO A SINGLE QUEUE ".
               10  PROG-DESCB2 PIC X(30) VALUE
                   "BACKLOG INQUIRY.  PRIMARILY   ".
               10  PROG-FUNC1  PIC X(30) VALUE
                   "FOR OFF-SHIFT CONDITIONS WHEN ".
               10  PROG-FUNC2  PIC X(30) VALUE
                   "SAME CRAFTSMEN COVER TWO ZONES".
           05  PASSWORD-FLAG   PIC X.

       01  FILE-STAT.
           05 FILE-STAT-1      PIC X   VALUE "0".
           05 FILE-STAT-2      PIC X   VALUE "0".

       01  LINE-UP.
           05  WO-QUEUE-UP     PIC 99 VALUE ZEROS.
           05  WO-Q-X-UP       REDEFINES WO-QUEUE-UP PIC XX.
           05  CC-NUM-UP       PIC XXXX.
           05  EQUIP-UP        PIC X(06).
           05  EQP-DN-UP       PIC X.
           05  WO-NUM-SELECT.
               10  WO-NUM-SEL  PIC X.
               10  WO-NUM-UP   PIC X(10).
           05  DESC-UP         PIC X(30).
           05  SKILL-A-UP      PIC XX.
           05  SKILL-B-UP      PIC XX.
           05  SKILL-C-UP      PIC XX.

       01  SELECT-BUFFER.
           05  SEL-BUFF.
               10  ZON1-BUF    PIC XXXX.
               10  ZON2-BUF    PIC XXXX.
           05  CMDMSGS         PIC X(79).
           05  ERRMSGS         PIC X(79).

       01  SCREEN-DATA.
           05  ZONE-DISPLAY.
               10  ZON1-TITLE  PIC XXXX.
               10  AND-FILL    PIC XXX.
               10  ZON2-TITLE  PIC XXXX.
           05  LINE-1.
               10  WO-QUEUE-1         PIC 99 VALUE ZEROS.
               10  WO-Q-X-1 REDEFINES WO-QUEUE-1 PIC XX.
               10  CC-NUM-1           PIC XXXX.
               10  EQUIP-1            PIC X(06).
               10  DOWN-1             PIC X.
               10  WO-NUM-S1.
                   15  WO-S1          PIC X.
                   15  WO-NUM-1       PIC X(10).
               10  DESC-1             PIC X(30).
               10  SKILL-A-1          PIC XX.
               10  SKILL-B-1          PIC XX.
               10  SKILL-C-1          PIC XX.
           05  LINE-2.
               10  WO-QUEUE-2         PIC 99 VALUE ZEROS.
               10  WO-Q-X-2 REDEFINES WO-QUEUE-2 PIC XX.
               10  CC-NUM-2           PIC XXXX.
               10  EQUIP-2            PIC X(06).
               10  DOWN-2             PIC X.
               10  WO-NUM-S2.
                   15  WO-S2          PIC X.
                   15  WO-NUM-2       PIC X(10).
               10  DESC-2             PIC X(30).
               10  SKILL-A-2          PIC XX.
               10  SKILL-B-2          PIC XX.
               10  SKILL-C-2          PIC XX.
           05  LINE-3.
               10  WO-QUEUE-3         PIC 99 VALUE ZEROS.
               10  WO-Q-X-3 REDEFINES WO-QUEUE-3 PIC XX.
               10  CC-NUM-3           PIC XXXX.
               10  EQUIP-3            PIC X(06).
               10  DOWN-3             PIC X.
               10  WO-NUM-S3.
                   15  WO-S3          PIC X.
                   15  WO-NUM-3       PIC X(10).
               10  DESC-3             PIC X(30).
               10  SKILL-A-3          PIC XX.
               10  SKILL-B-3          PIC XX.
               10  SKILL-C-3          PIC XX.
           05  LINE-4.
               10  WO-QUEUE-4         PIC 99 VALUE ZEROS.
               10  WO-Q-X-4 REDEFINES WO-QUEUE-4 PIC XX.
               10  CC-NUM-4           PIC XXXX.
               10  EQUIP-4            PIC X(06).
               10  DOWN-4             PIC X.
               10  WO-NUM-S4.
                   15  WO-S4          PIC X.
                   15  WO-NUM-4       PIC X(10).
               10  DESC-4             PIC X(30).
               10  SKILL-A-4          PIC XX.
               10  SKILL-B-4          PIC XX.
               10  SKILL-C-4          PIC XX.
           05  LINE-5.
               10  WO-QUEUE-5         PIC 99 VALUE ZEROS.
               10  WO-Q-X-5 REDEFINES WO-QUEUE-5 PIC XX.
               10  CC-NUM-5           PIC XXXX.
               10  EQUIP-5            PIC X(06).
               10  DOWN-5             PIC X.
               10  WO-NUM-S5.
                   15  WO-S5          PIC X.
                   15  WO-NUM-5       PIC X(10).
               10  DESC-5             PIC X(30).
               10  SKILL-A-5          PIC XX.
               10  SKILL-B-5          PIC XX.
               10  SKILL-C-5          PIC XX.
           05  LINE-6.
               10  WO-QUEUE-6         PIC 99 VALUE ZEROS.
               10  WO-Q-X-6 REDEFINES WO-QUEUE-6 PIC XX.
               10  CC-NUM-6           PIC XXXX.
               10  EQUIP-6            PIC X(06).
               10  DOWN-6             PIC X.
               10  WO-NUM-S6.
                   15  WO-S6          PIC X.
                   15  WO-NUM-6       PIC X(10).
               10  DESC-6             PIC X(30).
               10  SKILL-A-6          PIC XX.
               10  SKILL-B-6          PIC XX.
               10  SKILL-C-6          PIC XX.
           05  LINE-7.
               10  WO-QUEUE-7         PIC 99 VALUE ZEROS.
               10  WO-Q-X-7 REDEFINES WO-QUEUE-7 PIC XX.
               10  CC-NUM-7           PIC XXXX.
               10  EQUIP-7            PIC X(06).
               10  DOWN-7             PIC X.
               10  WO-NUM-S7.
                   15  WO-S7          PIC X.
                   15  WO-NUM-7       PIC X(10).
               10  DESC-7             PIC X(30).
               10  SKILL-A-7          PIC XX.
               10  SKILL-B-7          PIC XX.
               10  SKILL-C-7          PIC XX.
           05  LINE-8.
               10  WO-QUEUE-8         PIC 99 VALUE ZEROS.
               10  WO-Q-X-8 REDEFINES WO-QUEUE-8 PIC XX.
               10  CC-NUM-8           PIC XXXX.
               10  EQUIP-8            PIC X(06).
               10  DOWN-8             PIC X.
               10  WO-NUM-S8.
                   15  WO-S8          PIC X.
                   15  WO-NUM-8       PIC X(10).
               10  DESC-8             PIC X(30).
               10  SKILL-A-8          PIC XX.
               10  SKILL-B-8          PIC XX.
               10  SKILL-C-8          PIC XX.
           05  LINE-9.
               10  WO-QUEUE-9         PIC 99 VALUE ZEROS.
               10  WO-Q-X-9 REDEFINES WO-QUEUE-9 PIC XX.
               10  CC-NUM-9           PIC XXXX.
               10  EQUIP-9            PIC X(06).
               10  DOWN-9             PIC X.
               10  WO-NUM-S9.
                   15  WO-S9          PIC X.
                   15  WO-NUM-9       PIC X(10).
               10  DESC-9             PIC X(30).
               10  SKILL-A-9          PIC XX.
               10  SKILL-B-9          PIC XX.
               10  SKILL-C-9          PIC XX.
           05  LINE-10.
               10  WO-QUEUE-10        PIC 99 VALUE ZEROS.
               10  WO-Q-X-10 REDEFINES WO-QUEUE-10 PIC XX.
               10  CC-NUM-10          PIC XXXX.
               10  EQUIP-10           PIC X(06).
               10  DOWN-10            PIC X.
               10  WO-NUM-S10.
                   15  WO-S10         PIC X.
                   15  WO-NUM-10      PIC X(10).
               10  DESC-10            PIC X(30).
               10  SKILL-A-10         PIC XX.
               10  SKILL-B-10         PIC XX.
               10  SKILL-C-10         PIC XX.
           05  LINE-11.
               10  WO-QUEUE-11        PIC 99 VALUE ZEROS.
               10  WO-Q-X-11 REDEFINES WO-QUEUE-11 PIC XX.
               10  CC-NUM-11          PIC XXXX.
               10  EQUIP-11           PIC X(06).
               10  DOWN-11            PIC X.
               10  WO-NUM-S11.
                   15  WO-S11         PIC X.
                   15  WO-NUM-11      PIC X(10).
               10  DESC-11            PIC X(30).
               10  SKILL-A-11         PIC XX.
               10  SKILL-B-11         PIC XX.
               10  SKILL-C-11         PIC XX.
           05  LINE-12.
               10  WO-QUEUE-12        PIC 99 VALUE ZEROS.
               10  WO-Q-X-12 REDEFINES WO-QUEUE-12 PIC XX.
               10  CC-NUM-12          PIC XXXX.
               10  EQUIP-12           PIC X(06).
               10  DOWN-12            PIC X.
               10  WO-NUM-S12.
                   15  WO-S12         PIC X.
                   15  WO-NUM-12      PIC X(10).
               10  DESC-12            PIC X(30).
               10  SKILL-A-12         PIC XX.
               10  SKILL-B-12         PIC XX.
               10  SKILL-C-12         PIC XX.
           05  LINE-13.
               10  WO-QUEUE-13        PIC 99 VALUE ZEROS.
               10  WO-Q-X-13 REDEFINES WO-QUEUE-13 PIC XX.
               10  CC-NUM-13          PIC XXXX.
               10  EQUIP-13           PIC X(06).
               10  DOWN-13            PIC X.
               10  WO-NUM-S13.
                   15  WO-S13         PIC X.
                   15  WO-NUM-13      PIC X(10).
               10  DESC-13            PIC X(30).
               10  SKILL-A-13         PIC XX.
               10  SKILL-B-13         PIC XX.
               10  SKILL-C-13         PIC XX.
           05  LINE-14.
               10  WO-QUEUE-14        PIC 99 VALUE ZEROS.
               10  WO-Q-X-14 REDEFINES WO-QUEUE-14 PIC XX.
               10  CC-NUM-14          PIC XXXX.
               10  EQUIP-14           PIC X(06).
               10  DOWN-14            PIC X.
               10  WO-NUM-S14.
                   15  WO-S14         PIC X.
                   15  WO-NUM-14      PIC X(10).
               10  DESC-14            PIC X(30).
               10  SKILL-A-14         PIC XX.
               10  SKILL-B-14         PIC XX.
               10  SKILL-C-14         PIC XX.
           05  CMDMSG                 PIC X(79).
           05  ERRMSG                 PIC X(79).

       01  ZONE-ARGUMENT.
           05  Z-ARG          PIC X(4).
           05  FILLER         PIC XX   VALUE "1 ".

       01  DB-ERROR.
           05  DB-FUNC   PIC X(10) VALUE SPACES.
           05  DB-FILE   PIC X(18) VALUE SPACES.
           05  FILLER    PIC X(20) VALUE "ERROR - FILE-STAT = ".
           05  CON-WORD  PIC XX.

           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       01  WO-BASIC-DATA.
           COPY DWOBASIC       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  WO-QUEUE-DATA.
           COPY DWOOPENQ       IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  LAST-WO-USED-DATA.
           COPY MLASTWO        IN COPYLIB.

       01  MESSAGE-BUFF-DATA.
           COPY ERRORLIN       IN COPYLIB.

       PROCEDURE DIVISION.
       BEGIN-SORT SECTION 01.
       OPEN-FILES.
           OPEN INPUT          WO-OPEN-QUEUE.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          WO-BASIC.
           OPEN I-O            DISPLAY-FILE.

       BEGIN-PROC.
           PERFORM 1-HSK THRU 1-EXIT.
           GO TO CLEAR-BUFFERS.

       2-EOJ.
           CLOSE               WO-OPEN-QUEUE.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               WO-BASIC.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           GOBACK.

       1-HSK.
           MOVE SPACES         TO LAST-WO-USED-DATA.
           MOVE 1              TO DATE-FLAG-SW.
           OPEN INPUT          WO-LAST-NUM-USED.
           READ  WO-LAST-NUM-USED INTO LAST-WO-USED-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = ZEROS
               DISPLAY "UNABLE TO GET LAST-WO-USED DATA."
                       "    FILE-STATUS = " FILE-STAT
               CLOSE           WO-LAST-NUM-USED
               GO TO 2-EOJ.

           CLOSE               WO-LAST-NUM-USED.
           MOVE DATE-FLAG-SW   TO DATE-FLAG.

           CALL "TPWORD" USING PASSWORD-INFORMATION.
           IF PASSWORD-FLAG = "N"
               GO TO 2-EOJ.

           MOVE SPACES         TO WO-PLANNED-DATA.

       1-EXIT.    EXIT.

       CLEAR-BUFFERS.
           MOVE SPACES         TO MESSAGE-BUFFER SELECT-BUFFER.
           MOVE SPACES         TO SCREEN-DATA.
           MOVE 0              TO ACT-KEY ALARM.
           MOVE "VSELECTZ"     TO SCREEN-NAME.

       1-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SELECT-BUFFER  TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SELECT-BUFFER.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO 2-EOJ.

           IF KEY-HIT NOT = 0
               GO TO 1-SHOWFORM.

           IF SEL-BUFF = SPACES
               GO TO 1-SHOWFORM.

           IF ZON1-BUF = SPACES
               MOVE ZON2-BUF   TO ZON1-BUF
               MOVE SPACES     TO ZON2-BUF.

           IF ZON1-BUF = ZON2-BUF
               MOVE SPACES     TO ZON2-BUF.

           MOVE ZON1-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2"
      **********************************************************************
      **    MESSAGE 035/044:
      **  INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 1          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM
           ELSE
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-ZONE-PRTY" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE 1          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM.

           IF ZON2-BUF = SPACES GO TO 1-GETNEWFORM.
           MOVE ZON2-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
             IF FILE-STAT-1 = "2"
      **********************************************************************
      **    MESSAGE 035/044:
      **  INVALID ZONE
      **********************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE 2          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM
           ELSE
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-ZONE-PRTY" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE 2          TO FIELD-NUMBER
               MOVE MESSAGE-BUFFER TO ERRMSGS
               MOVE TRUE-VAL   TO IND(FIELD-NUMBER) IND(99)
               GO TO 1-SHOWFORM.

       1-GETNEWFORM.
           MOVE ZON1-BUF       TO ZON1-TITLE.
           MOVE ZON2-BUF       TO ZON2-TITLE.
           MOVE "VAUTOZON"     TO SCREEN-NAME.

       6-MAIN.
           MOVE 0              TO ACT-KEY.
           MOVE SPACES         TO MESSAGE-BUFFER.

           SORT SORT-FILE DESCENDING KEY SORT-WO-QUEUE
                            SORT-EQUIP SORT-SKILL-1
               INPUT PROCEDURE SORT-INPUT-RECORDS
               OUTPUT PROCEDURE SORT-WRITE-FILE.

           IF MESSAGE-BUFFER NOT = SPACES
               GO TO  61-SHOWFORM.

           IF ACT-KEY = 0
               MOVE 1          TO ALARM
               MOVE SPACES     TO SCREEN-DATA
               MOVE ZON1-BUF   TO ZON1-TITLE
               MOVE ZON2-BUF   TO ZON2-TITLE
               MOVE " & "      TO AND-FILL
      **********************************************************************
      **    MESSAGE 040/002:
      **  NO WORKORDERS IN THE BACKLOG FOR THIS ZONE
      **********************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE   2        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               IF ZON2-BUF = SPACES
                   MOVE SPACES TO AND-FILL
                   GO TO 61-SHOWFORM
               ELSE
                   GO TO 61-SHOWFORM.

           IF ALARM = 1
               PERFORM 63-ALARM-SCREEN THRU 63-ALARM-EXIT.
           MOVE 0              TO ACT-KEY ALARM.
           OPEN INPUT          OUT-FILE.

       61-RESET-SCREEN.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER.
           MOVE ZON1-BUF       TO ZON1-TITLE.
           MOVE ZON2-BUF       TO ZON2-TITLE.
           IF ZON2-BUF NOT = SPACES
               MOVE " & "      TO AND-FILL.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.
           MOVE SCREEN-DATA    TO SCREEN-SAVE.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3
               GO TO 2-EOJ.

           IF KEY-HIT = 1
               CLOSE           OUT-FILE
               GO TO CLEAR-BUFFERS.

           IF EOF-SW = 1
               MOVE 0          TO EOF-SW
               MOVE 0          TO ACT-KEY.

           IF WO-S1 NOT = SPACE
               MOVE WO-NUM-1   TO DWO-BUFFER
               MOVE SPACE      TO WO-S1
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S2 NOT = SPACE
               MOVE WO-NUM-2   TO DWO-BUFFER
               MOVE SPACE      TO WO-S2
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S3 NOT = SPACE
               MOVE WO-NUM-3   TO DWO-BUFFER
               MOVE SPACE      TO WO-S3
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S4 NOT = SPACE
               MOVE WO-NUM-4   TO DWO-BUFFER
               MOVE SPACE      TO WO-S4
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S5 NOT = SPACE
               MOVE WO-NUM-5   TO DWO-BUFFER
               MOVE SPACE      TO WO-S5
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S6 NOT = SPACE
               MOVE WO-NUM-6   TO DWO-BUFFER
               MOVE SPACE      TO WO-S6
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S7 NOT = SPACE
               MOVE WO-NUM-7   TO DWO-BUFFER
               MOVE SPACE      TO WO-S7
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S8 NOT = SPACE
               MOVE WO-NUM-8   TO DWO-BUFFER
               MOVE SPACE      TO WO-S8
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S9 NOT = SPACE
               MOVE WO-NUM-9   TO DWO-BUFFER
               MOVE SPACE      TO WO-S9
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S10 NOT = SPACE
               MOVE WO-NUM-10  TO DWO-BUFFER
               MOVE SPACE      TO WO-S10
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S11 NOT = SPACE
               MOVE WO-NUM-11  TO DWO-BUFFER
               MOVE SPACE      TO WO-S11
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S12 NOT = SPACE
               MOVE WO-NUM-12  TO DWO-BUFFER
               MOVE SPACE      TO WO-S12
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S13 NOT = SPACE
               MOVE WO-NUM-13  TO DWO-BUFFER
               MOVE SPACE      TO WO-S13
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM
           ELSE
           IF WO-S14 NOT = SPACE
               MOVE WO-NUM-14  TO DWO-BUFFER
               MOVE SPACE      TO WO-S14
               PERFORM 64-DISPLAY-WO THRU 64-EXIT
               GO TO 61-SHOWFORM.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO              TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-1.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-2.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-3.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-4.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-5.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-6.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-7.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-8.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-9.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-10.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-11.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-12.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-13.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           MOVE OUT-REC        TO LINE-14.

       62-FS-EXIT.    EXIT.

       63-ALARM-SCREEN.
           MOVE "VALARM"       TO SCREEN-NAME.

       63-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SPACES         TO DISPLAY-REC.

           WRITE DISPLAY-REC  FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           READ  DISPLAY-FILE FORMAT IS SCREEN-NAME
               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                        SCREEN-STATUS
               GO TO 2-EOJ.

           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 0 OR 1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8
               NEXT SENTENCE
           ELSE
               GO TO 63-SHOWFORM.

           MOVE "VAUTOZON"     TO SCREEN-NAME.

       63-ALARM-EXIT.    EXIT.

       64-DISPLAY-WO.
           MOVE DWO-BUFFER     TO WONUM OF WO-BASIC.
           START WO-BASIC      KEY = WONUM OF WO-BASIC
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-CONT.

           READ WO-BASIC       NEXT INTO WO-BASIC-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF DWO-BUFFER NOT = WO-NUM
               MOVE "READ    " TO DB-FUNC
               MOVE "WO-BASIC" TO DB-FILE
               MOVE FILE-STAT  TO CON-WORD
               MOVE DB-ERROR   TO MESSAGE-BUFFER
               MOVE DWO-BUFFER TO MSG-FLD
               GO TO 64-CONT.

           MOVE SPACES         TO MESSAGE-BUFFER.

           CALL "TDISPWO" USING DBPARAMETERS
                                WO-BASIC-DATA
                                WO-PLANNED-DATA
                                FILE-SW.

           MOVE "VAUTOZON"     TO SCREEN-NAME.

       64-CONT.
           MOVE SCREEN-SAVE    TO SCREEN-DATA.

       64-EXIT.    EXIT.

       65-ERROR.
           MOVE MESSAGE-BUFFER TO ERRMSG.
           MOVE TRUE-VAL       TO IND(FIELD-NUMBER) IND(99).

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.    EXIT.

       SORT-INPUT-RECORDS SECTION 02.
           PERFORM SORT-MAIN THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE ZON1-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-OPEN-QUEUE.
           START WO-OPEN-QUEUE KEY = ZONEPRTY OF WO-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-M-CONT
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 2-EOJ.

           PERFORM SORT-DBGET THRU SORT-DBGET-EXIT.

       SORT-M-CONT.
           IF ZON2-BUF = SPACES GO TO SORT-M-EXIT.
           MOVE ZON2-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-OPEN-QUEUE.
           START WO-OPEN-QUEUE KEY = ZONEPRTY OF WO-OPEN-QUEUE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT-1 = "2"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE "START   " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 2-EOJ.

           PERFORM SORT-DBGET THRU SORT-DBGET-EXIT.

       SORT-M-EXIT.    EXIT.

       SORT-DBGET.
           MOVE SPACES         TO SORT-REC.
           READ WO-OPEN-QUEUE  NEXT INTO WO-QUEUE-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-DBGET-EXIT
               ELSE
                   MOVE "READ    " TO DB-FUNC
                   MOVE "WO-OPEN-QUEUE" TO DB-FILE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   MOVE 1          TO FIELD-NUMBER
                   PERFORM 65-ERROR
                   GO TO 2-EOJ.

           IF ZONE-ARGUMENT NOT = Q-ZONE-PRI
               GO TO SORT-DBGET-EXIT.

           MOVE QUEUE-FACTOR   TO SORT-WO-QUEUE.
           MOVE Q-EQUIP-NUM    TO SORT-EQUIP.
           MOVE Q-WO-NUM       TO SORT-WO-NUM.
           IF Q-CC-NUM NOT = "9999"
               MOVE Q-CC-NUM   TO SORT-CC-NUM.
           IF Q-EQP-DN = "Y"
               MOVE "D"        TO SORT-DOWN.
           MOVE Q-DESCRIPTION  TO SORT-DESC.
           MOVE Q-SKILL-1      TO SORT-SKILL-1.
           MOVE Q-SKILL-2      TO SORT-SKILL-2.
           MOVE Q-SKILL-3      TO SORT-SKILL-3.
           RELEASE SORT-REC.
           GO TO SORT-DBGET.

       SORT-DBGET-EXIT.    EXIT.

       SORT-IP-EXIT.    EXIT.

       SORT-WRITE-FILE SECTION 03.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           GO TO SORT-WF-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.    EXIT.

       SORT-WF-EXIT.    EXIT.

      *******************>>>  END OF FILE  <<<*********************
