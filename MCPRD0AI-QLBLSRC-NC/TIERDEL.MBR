000200 IDENTIFICATION DIVISION.
000300 PROGRAM-ID.    TIERDEL.
000600*REMARKS.  ***  THIS PROGRAM IS THE SUB-EXECUTIVE
000700*               FOR THE DELETION OF RECORDS FROM
000800*               THE EQUIPMENT REFERENCE FILE
000900*          ***  SUBROUTINES CALLED:
001000*               TIERDEL2
001100*               TIERDEL3
001200*               TIERDEL4
001300*                   ****.
001400 ENVIRONMENT DIVISION.
001500 CONFIGURATION SECTION.
001600 SOURCE-COMPUTER.    AS400.
001700 OBJECT-COMPUTER.    AS400.
       SPECIAL-NAMES. I-O-FEEDBACK IS I-O-FEEDBACK-AREA
                      LOCAL-DATA IS LOCAL-DATA-AREA.
001000 INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT DISPLAY-FILE
               ASSIGN TO WORKSTATION-ZIEQPREF-SI
               ORGANIZATION IS TRANSACTION
               ACCESS IS SEQUENTIAL
               FILE STATUS IS DSPLY-STATUS
               CONTROL-AREA IS WS-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.
001900 DATA DIVISION.
       FILE SECTION.
       FD  DISPLAY-FILE
           LABEL RECORDS ARE OMITTED.
       01  DSPLY-REC               PIC X(2000).
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.
002000 WORKING-STORAGE SECTION.
       COPY CATREAD IN COPYLIB.

       COPY CPYIND  IN COPYLIB.

004700 01  EQUIP-BUFFER            PIC X(06) VALUE SPACES.
004800
       01  FILE-STATUSES.
           05  DSPLY-STATUS        PIC XX.
           05  EF-STATUS           PIC XX.

       COPY IOFEEDBACK IN COPYLIB.

004900 01  MESSAGE-BUFFER.
           05  MESSAGE-LIT1        PIC X(33).
           05  MESSAGE-EQPNUM      PIC X(6).
           05  MESSAGE-LIT2        PIC X(13).
           05  MESSAGE-SUBSYS      PIC X(4).
           05  MESSAGE-LIT3        PIC X(24).

002100 01  PASSWORD-INFORMATION.
002200     05  NAME-OF-PROGRAM     PIC X(08) VALUE "TIERDEL ".
002300     05  PROGRAM-TYPE        PIC X(02) VALUE "UP".
002400     05  PROGRAM-RELEASE     PIC X(12) VALUE " E0100010001".
002500     05  PROGRAM-DESCRIPTION.
002600         10  PROG-DESC-A.
                   15  FILLER      PIC X(15) VALUE "DELETE PROGRAM ".
                   15  FILLER      PIC X(08) VALUE "FOR THE ".
                   15  FILLER      PIC X(10) VALUE "EQUIPMENT ".
                   15  FILLER      PIC X(27) VALUE "REFERENCE FILE ".
002800         10  PROG-DESC-B     PIC X(60) VALUE SPACES.
003000         10  PROG-FUNCTION.
                   15  FILLER      PIC X(16) VALUE "RUNS FROM THE F5".
                   15  FILLER      PIC X(12) VALUE " KEY OF THE ".
                   15  FILLER      PIC X(32) VALUE "PRIMARY MENU ".
003200     05  PASSWORD-FLAG       PIC X.
003300
003900 01  SCREEN-BUFFER.
004000     05  ACD-DISP            PIC X(06).
004100     05  EQP-NUMBER          PIC X(06).
004200     05  EQP-DISP            PIC X(06).
004300     05  SUB-SYS             PIC X(04).
004400     05  EQP-OLD             PIC X(06).
004500     05  EQP-NEW             PIC X(06).
           05  SCREEN-CMD-LINE     PIC X(79).
           05  SCREEN-ERR-LINE     PIC X(79).
004600
       COPY DBSTAT   IN COPYLIB.

       01  TRUE-VAL                PIC 1 VALUE B"1".

       COPY WSCONTROL IN COPYLIB.
006000 LINKAGE SECTION.
006100 COPY VCOMLINK IN COPYLIB.
006200 01  DBPARAMETERS.        COPY DBPARMS IN COPYLIB.
006500 01  EQP-SUB-BUFFER.
006600     05  EQP-NUM-BUF         PIC X(06).
006700     05  SUB-SYS-BUF         PIC X(04).
006800     05  EQP-SUB-DESC-BUF    PIC X(40).
006900     05  EQP-TYPE-BUF        PIC X(08).
007000     05  ACD-FUNCTION        PIC X(06).
007100     05  ACD-SW              PIC X(01).
007200
007300 PROCEDURE DIVISION USING VIEW-COMAREA
007400                          DBPARAMETERS
007700                          EQP-SUB-BUFFER.
007800 BEGIN-PGM.
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT UNTIL VIEW-LASTKEY = 3.
       2-EOJ.
           CLOSE DISPLAY-FILE.
           CLOSE EQUIPMENT-FILE.
           GOBACK.
       1-HSK.
           MOVE LOW-VALUES TO STATUS-AREA.
           OPEN I-O   DISPLAY-FILE.
           OPEN INPUT EQUIPMENT-FILE.
008000     CALL "TPWORD" USING PASSWORD-INFORMATION.
008400     IF PASSWORD-FLAG = "N" GO TO 2-EOJ.
008900
009000 6-MAIN.
009100     MOVE "FIERDEL1" TO VIEW-CFNAME.
           IF TRUE-VAL = INDS (99)
               MOVE MESSAGE-BUFFER TO SCREEN-ERR-LINE
           ELSE
012400     MOVE SPACES TO SCREEN-BUFFER.
012500     MOVE EQP-NUM-BUF TO EQP-NUMBER EQP-OLD.
012600     MOVE ACD-FUNCTION TO ACD-DISP.
           MOVE 66288 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
015100     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
015400     IF VIEW-LASTKEY = 2
015500         PERFORM 62-FUNCTION-2 THRU 62-F2-EXIT
015600         GO TO 6-MAIN.
015900     IF VIEW-LASTKEY = 4
016000         PERFORM 62-FUNCTION-4 THRU 62-F4-EXIT
016100         GO TO 6-MAIN.
016400     IF VIEW-LASTKEY = 5
016500         PERFORM 62-FUNCTION-5 THRU 62-F5-EXIT
016800         GO TO 6-MAIN.
016900
       6-MAIN-EXIT.    EXIT.

017000 62-FUNCTION-2.
017100     MOVE "FIERDEL2" TO VIEW-CFNAME.
020400     MOVE 48004 TO CATREAD-MSG-NUMBER.
020600**MESSAGE******************************************************
020700** VERIFY LOCAL EQUIPMENT NUMBER TO BE DELETED AND PRESS `ENTER'
020800***************************************************************
020900     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98-SCREEN-READ.
023100     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
023500     MOVE DSPLY-REC TO SCREEN-BUFFER.
023900     IF EQP-DISP = EQP-NUMBER
024000         CALL "TIERDEL2" USING VIEW-COMAREA
024100                              DBPARAMETERS
024400                              EQP-SUB-BUFFER
               IF VIEW-LASTKEY = 3
                   MOVE 0 TO VIEW-LASTKEY
                   MOVE 27049 TO CATREAD-MSG-NUMBER
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
                   MOVE TRUE-VAL TO INDS (98)
                   MOVE SCREEN-BUFFER TO DSPLY-REC
                   PERFORM 99-SCREEN-WRITE
                   PERFORM 98A-SCREEN-READ
                   CALL "CLPAUSE2"
                   GO TO 62-F2-EXIT
               ELSE
               MOVE 0 TO VIEW-LASTKEY
               MOVE TRUE-VAL TO INDS (98)
               MOVE 66309 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE EQP-NUMBER TO MESSAGE-EQPNUM
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
024500         GO TO 62-F2-EXIT
024600     ELSE
024700     MOVE 38007 TO CATREAD-MSG-NUMBER
024900**MESSAGE******************************************************
025000** LOCAL NUMBER NOT VERIFIED - RETURN TO INITIATE SCREEN     **
025100***************************************************************
025200     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
           MOVE SCREEN-BUFFER TO DSPLY-REC
           MOVE TRUE-VAL TO INDS (98)
025300     PERFORM 99-SCREEN-WRITE
           PERFORM 98A-SCREEN-READ
025400     CALL "CLPAUSE2".
026500 62-F2-EXIT.    EXIT.
026600
026700 62-FUNCTION-4.
026800     MOVE "FIERDEL3" TO VIEW-CFNAME.
030000     MOVE SPACES TO SUB-SYS.
030300     MOVE 31006 TO CATREAD-MSG-NUMBER.
030500**MESSAGE******************************************************
030600** ENTER SUBSYSTEM NUMBER AND PRESS `ENTER'                  **
030700***************************************************************
030800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE TRUE-VAL TO INDS (98).
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
030900     PERFORM 99-SCREEN-WRITE.
031000     PERFORM 98-SCREEN-READ.
033100     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
034300     MOVE DSPLY-REC TO SCREEN-BUFFER.
034700     MOVE SUB-SYS TO SUB-SYS-BUF.
034800     CALL "TIERDEL3" USING VIEW-COMAREA
034900                           DBPARAMETERS
035200                           EQP-SUB-BUFFER.
           IF VIEW-LASTKEY = 3
               MOVE 0 TO VIEW-LASTKEY
               MOVE TRUE-VAL TO INDS (98)
               MOVE 66290 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE EQP-NUMBER TO MESSAGE-EQPNUM
               MOVE SUB-SYS  TO MESSAGE-SUBSYS
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 62-F4-EXIT.
           IF VIEW-LASTKEY > 0
               MOVE 0 TO VIEW-LASTKEY
               MOVE TRUE-VAL TO INDS (98)
               MOVE 66291 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE
               MOVE SCREEN-BUFFER TO DSPLY-REC
               PERFORM 99-SCREEN-WRITE
               PERFORM 98A-SCREEN-READ
               CALL "CLPAUSE2"
               GO TO 62-FUNCTION-4.
035400 62-F4-EXIT.    EXIT.
035500
035600 62-FUNCTION-5.
035700     MOVE "FIERDEL4" TO VIEW-CFNAME.
036000     MOVE SPACES TO SUB-SYS.
036300     MOVE 31083 TO CATREAD-MSG-NUMBER.
036500**MESSAGE******************************************************
036600** ENTER NEW LOCAL EQUIPMENT NUMBER AND PRESS `ENTER'        **
036700***************************************************************
036800     PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE TRUE-VAL TO INDS (98).
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
036900     PERFORM 99-SCREEN-WRITE.
037000     PERFORM 98-SCREEN-READ.
039100     IF VIEW-LASTKEY = 1 OR 3 GO TO 2-EOJ.
040300     MOVE DSPLY-REC TO SCREEN-BUFFER.
040700     MOVE EQP-NEW TO EQUIP-BUFFER EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 66134 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE TRUE-VAL TO INDS (99)
               GO TO 62-F5-EXIT.
040800     CALL "TIERDEL4" USING VIEW-COMAREA
040900                           DBPARAMETERS
041200                           EQP-SUB-BUFFER
041300                           EQUIP-BUFFER.
           MOVE 0 TO VIEW-LASTKEY.
           MOVE 27052 TO CATREAD-MSG-NUMBER.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO SCREEN-CMD-LINE.
           MOVE SCREEN-BUFFER TO DSPLY-REC.
           MOVE TRUE-VAL TO INDS (98).
           PERFORM 99-SCREEN-WRITE.
           PERFORM 98A-SCREEN-READ.
           CALL "CLPAUSE2".

041500 62-F5-EXIT.    EXIT.

       98-SCREEN-READ.
           READ DISPLAY-FILE FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           ACCEPT IOFEEDBACK FROM I-O-FEEDBACK-AREA.
           MOVE ALL B"0" TO INDICS.
           IF DSPLY-STATUS NOT = "00"
               MOVE 3 TO VIEW-LASTKEY
           ELSE
           MOVE FUNCTION-NUM TO VIEW-LASTKEY.

       98A-SCREEN-READ.
           READ DISPLAY-FILE TERMINAL IS TERMINAL-ID
               INDIC IS INDICS
                  NO DATA MOVE DSPLY-STATUS TO DSPLY-STATUS.
           MOVE ALL B"0" TO INDICS.

       99-SCREEN-WRITE.
           WRITE DSPLY-REC FORMAT IS VIEW-CFNAME
               INDIC IS INDICS.
           MOVE ALL B"0" TO INDICS.
041600
042200 999-CATREAD.
042300     MOVE SPACES TO MESSAGE-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.
043300 999-CATREAD-EXIT.    EXIT.
