009900**                                                          **
010000**            L I N K A G E   S E C T I O N                 **
010100**                                                          **
010200**************************************************************
010300
010400 LINKAGE SECTION.
010500 01  BASE                      PIC X(10).
010600 01  BASE-MMISA                 PIC X(13).
010700
010800 COPY VCOMLINK   IN COPYLIB.
010900 COPY TSHWSUB2   IN COPYLIB.
011000 COPY LANGSUB    IN COPYLIB.
011100
011200 PROCEDURE DIVISION USING BASE
011300                          BASE-MMISA,
011400                          VIEW-COMAREA,
011500                          SRF-COMAREA,
011600                          LANGUAGE-PARMS.
011700
011800 1-HSK.
           MOVE ZERO TO SAVE-QTY.
           PERFORM 9999-OPEN-STUFF.
011900     PERFORM 6000-MAIN THRU 6990-MAIN-X.
           PERFORM 9999-CLOSE-STUFF.
012000     GOBACK.
012100
012200 2100-BLOWUP.
012300     MOVE "SRESERVE"               TO   BU-PGM-NAME.
012400     CALL "TBLOWUP" USING BASE BU-PGM-NAME STATUS-AREA
012500       VIEW-COMAREA FILE-STATUS BU-DISPLAY-MSG
012600       BU-DISPLAY-FLDS.
012700
017800******************************************************************
017900**                                                              **
018000**                 M A I N   M E N U                            **
018100**                                                              **
018200******************************************************************
018300 6000-MAIN.
018400     MOVE 2 TO SRF-MODE.
018500     MOVE "RSVMAIN"                TO   VIEW-NFNAME.
018600     PERFORM 9951-GETNEXTFORM.
018700     PERFORM 9955-CLEAR-FORM.
018800
018900*----- f1,f2,f3,f4,f8 APPL,f5 PRT SCR,f6,f7 INVALID,ENTER INVALID
019000     MOVE 0                        TO   SRF-KEYSET.
019100     MOVE "I"                      TO   SRF-FKEY (6),
019200                                        SRF-FKEY (7).
019300     MOVE "P"                      TO   SRF-FKEY (5).
019400     MOVE "N"                      TO   SRF-ENTER-FLAG.
019500     MOVE 2                        TO   SRF-MODE.
       6010-SHOWFORM.
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6010-SHOWFORM.

020200     IF VIEW-LASTKEY = 3
020300         GO TO 6990-MAIN-X.
020400
020500     IF VIEW-LASTKEY = 1
020600         MOVE "A"                  TO   MOD-DEL-FLAG
020700         PERFORM 6300-ADD THRU 6390-A-X
020800     ELSE
020900     IF VIEW-LASTKEY = 2
021000         MOVE "M"                  TO   MOD-DEL-FLAG
021100         PERFORM 6500-MOD-DEL THRU 6590-MD-X
021200     ELSE
021300     IF VIEW-LASTKEY = 8
021400         MOVE "D"                  TO   MOD-DEL-FLAG
021500         PERFORM 6500-MOD-DEL THRU 6590-MD-X
021600     ELSE
021700     IF VIEW-LASTKEY = 4
021800         PERFORM 6600-RSV-INQUIRY THRU 6690-RI-X.
021900
022000     GO TO 6000-MAIN.
022100
022200******************************************************************
022300**                                                              **
022400**       A D D   R E S E R V A T I O N                          **
022500**                                                              **
022600******************************************************************
022700 6300-ADD.
022800     MOVE "RSVADD"                 TO   VIEW-NFNAME.
022900     PERFORM 9951-GETNEXTFORM.
023000     PERFORM 9955-CLEAR-FORM.
023100
023200 6310-SHOW-ADD-FORM.
023300     MOVE 7                        TO   SRF-KEYSET.
023400     MOVE 2                        TO   SRF-MODE.
           MOVE ZERO TO DE-QTY.
       6310-SHOWFORM.
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6310-SHOWFORM.

024100     IF VIEW-LASTKEY = 3
024200         GO TO 6390-A-X.
024300
024400     PERFORM 9952-GETBUFFER.
024500     PERFORM 7200-VALIDATE-CODE.
024600     IF NOT GOOD-CALL
024700         GO TO 6310-SHOW-ADD-FORM.
024800
024900     PERFORM 7030-MOVE-TO-RSV.
025000
025100     MOVE "RS"                     TO   RESERVE-TYPE.
025200     CALL "CRESERVE" USING BASE, BASE-MMISA, RESERVATION-DATA,
025300           R-MESSAGE,  VIEW-COMAREA, LANGUAGE-PARMS.
           MOVE R-MESSAGE TO MESSAGE-BUFFER.
025400     IF R-RET-CODE NOT = "OK"
025500         IF R-RET-CODE = "NR" OR "RE"
025600             MOVE 2                TO   FIELD-NUMBER
025700         ELSE
025800         IF R-RET-CODE = "BC"
025900             MOVE 3                TO   FIELD-NUMBER
026000         ELSE
026100             MOVE 4                TO   FIELD-NUMBER.
026200     IF R-RET-CODE NOT = "OK"
026300         PERFORM 9954-SETERROR
026400         GO TO 6310-SHOW-ADD-FORM.
026500
026600     PERFORM 9955-CLEAR-FORM.
026700     GO TO 6310-SHOW-ADD-FORM.
026800
026900 6390-A-X.
027000     EXIT.
027100
027200******************************************************************
027300**                                                              **
027400**      M O D I F Y / D E L E T E   R E S E R V A T I O N       **
027500**                                                              **
027600******************************************************************
027700 6500-MOD-DEL.
027800*------- GET THE FATHER FORM FOR MODIFY OR DELETE
027900     IF MOD-DEL-FLAG = "M"
028000         MOVE "RSVMOD"             TO   VIEW-NFNAME
028100     ELSE
028200         MOVE "RSVDEL"             TO   VIEW-NFNAME.
028300     PERFORM 9951-GETNEXTFORM.
028400
028500 6505-MOD-DEL-GETFORM-1.
028600*------- GET SON FORM FOR LEVEL NUMBER TO MODIFY ENTRY
028700     IF MOD-DEL-FLAG = "M"
028800         MOVE "RSVMOD1"            TO   VIEW-NFNAME
028900     ELSE
029000         MOVE "RSVDEL1"            TO   VIEW-NFNAME.
029100     PERFORM 9951-GETNEXTFORM.
029200     PERFORM 9955-CLEAR-FORM.
029300
029400 6510-SHOW-MOD-FORM-1.
029500     MOVE 7                        TO   SRF-KEYSET.
029600     MOVE 2                        TO   SRF-MODE.
           MOVE ZERO TO DE-QTY.
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6510-SHOW-MOD-FORM-1.

030300     IF VIEW-LASTKEY = 3
030400         GO TO 6590-MD-X.
030500
030600     PERFORM 9952-GETBUFFER.
030700
033500     IF DE-CORP-CODE = SPACES
      *M---- T62: THIS FIELD IS REQUIRED
               MOVE 20 TO LANG-SETNUM
               MOVE 62 TO LANG-MSGNUM
033900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
031600         MOVE 3                    TO   FIELD-NUMBER
               PERFORM 9954-SETERROR
               GO TO 6510-SHOW-MOD-FORM-1.
030700
030800     MOVE "IQ"                     TO   RESERVE-TYPE.
030900     MOVE ZERO                     TO   R-QTY.
031000     MOVE DE-CORP-CODE             TO   R-CORP-CODE.
031100     MOVE DE-WONO                  TO   R-WONO.
031200
031300     CALL "CRESERVE" USING BASE, BASE-MMISA, RESERVATION-DATA,
031400           R-MESSAGE,  VIEW-COMAREA, LANGUAGE-PARMS.
           MOVE R-MESSAGE TO MESSAGE-BUFFER.
031500     IF R-RET-CODE NOT = "OK"
031600         MOVE 2                    TO   FIELD-NUMBER
031700         PERFORM 9954-SETERROR
031800         GO TO 6510-SHOW-MOD-FORM-1.
031900
032000     MOVE R-QTY                    TO   SAVE-QTY.
032100
032200     IF MOD-DEL-FLAG = "M"
032300         MOVE "RSVMOD2"            TO   VIEW-NFNAME
032400     ELSE
032500         MOVE "RSVDEL2"            TO   VIEW-NFNAME.
032600     PERFORM 9951-GETNEXTFORM.
032700
032800     MOVE R-QTY                    TO   DE-QTY.
032900     MOVE R-DATE                   TO   DATE-VALIDATE-IN.
033000     MOVE 4                        TO   DATE-MODE.
033100     CALL "TDATECHK" USING DATE-CHECK-AREA.
033200     MOVE DATE-SLASH-OUT           TO   V-DATE.
033300
033400     PERFORM 9953-PUTBUFFER.
033500     IF MOD-DEL-FLAG = "D"
033600*        "P123: PRESS 'ENTER' TO DELETE OR 'f8' TO EXIT
033700         MOVE  16                  TO   LANG-SETNUM
033800         MOVE 123                  TO   LANG-MSGNUM
033900         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
034000         PERFORM 9956-PUTWINDOW.
034100
034200 6530-SHOW-MOD-FORM-2.
034300*----- f1 f2 f3 f6 INVALID, f4 REFRESH, f5 PRT, f7 CLR, f8 EXIT
034400     MOVE 7                        TO   SRF-KEYSET.
034500     MOVE 2                        TO   SRF-MODE.
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6530-SHOW-MOD-FORM-2.

035200     IF VIEW-LASTKEY = 3
035300         PERFORM 9955-CLEAR-FORM
035400         GO TO 6505-MOD-DEL-GETFORM-1.
035500
035600     PERFORM 9952-GETBUFFER.
035700     PERFORM 7030-MOVE-TO-RSV.
035800
035900     IF MOD-DEL-FLAG = "M"
036000         MOVE "CR"                 TO   RESERVE-TYPE
036100     ELSE
036200         MOVE "UR"                 TO   RESERVE-TYPE.
036300     CALL "CRESERVE" USING BASE, BASE-MMISA, RESERVATION-DATA,
036400           R-MESSAGE,  VIEW-COMAREA, LANGUAGE-PARMS.
           MOVE R-MESSAGE TO MESSAGE-BUFFER.
036500     IF R-RET-CODE NOT = "OK"
036600         MOVE 2                    TO   FIELD-NUMBER
036700         PERFORM 9954-SETERROR
036800         GO TO 6530-SHOW-MOD-FORM-2.
036900
037000     GO TO 6505-MOD-DEL-GETFORM-1.
037100
037200 6590-MD-X.
037300     EXIT.
037400
037500 6600-RSV-INQUIRY.
037600*------ FIRST GET THE CORPORATE CODE TO INQUIRE ON.
037700     MOVE "RSVINQ"             TO   VIEW-NFNAME
037800     PERFORM 9951-GETNEXTFORM.
037900     PERFORM 9955-CLEAR-FORM.
038000
038100 6610-RSV-INQ-SHOWFORM.
038200     MOVE 7                        TO   SRF-KEYSET.
038300     MOVE 2                        TO   SRF-MODE.
           PERFORM 9953-PUTBUFFER.
           PERFORM 998-WRITE-SCREEN THRU 9989-WS-X.
           IF MESSAGE-BUFFER-1 NOT = SPACES
               PERFORM 9954-SETERROR
               GO TO 6610-RSV-INQ-SHOWFORM.

039000     IF VIEW-LASTKEY = 3
039100         GO TO 6690-RI-X.
039200
039300     PERFORM 9952-GETBUFFER.
039400
039500     MOVE 1                        TO   FIELD-NUMBER.
039600     PERFORM 7200-VALIDATE-CODE.
039700     IF NOT GOOD-CALL
039800         GO TO 6610-RSV-INQ-SHOWFORM.
039900
040000     MOVE "FCSISINQ"               TO   CSF-NEW-FORMFILE-NAME.
040100     MOVE "N"                      TO   CSF-MODE.
040200     PERFORM 7150-CALL-CSWITCHF.
040300     IF CSF-OPENFORM-ERR-SW = "Y"
040400         GO TO 6690-RI-X.
040500
040600     MOVE DE-CORP-CODE             TO   CODE-ARG.
040700     CALL "TRSRVINQ" USING         BASE,
040800                                   CODE-ARG,
040900                                   SRF-MPLTINFO-COMPANY,
041000                                   VIEW-COMAREA,
041100                                   SCREEN-PRINT-PARMS,
041200                                   SRF-SPOOL-PRT-NO,
041300                                   FATAL-ERR-SW,
041400                                   BU-DISPLAY-MSG,
041500                                   LANGUAGE-PARMS.
041600
041700     MOVE "O"                      TO   CSF-MODE.
041800     PERFORM 7150-CALL-CSWITCHF.
041900
042000     GO TO 6600-RSV-INQUIRY.
042100
042200 6690-RI-X.
042300     EXIT.
042400
042500 6990-MAIN-X.
042600     EXIT.
042700
042800******************************************************************
042900**                                                              **
043000**      P E R F O R M E D   R O U T I N E S                     **
043100**                                                              **
043200******************************************************************
043300 7030-MOVE-TO-RSV.
043400*------ NOTE: 'CRESERVE' WANTS THE QUANTITY TO ADD OR SUBTRACT TO
043500*------ THE RESERVATION, BUT THE USER ENTERS THE QUANTITY NOW
043600*------ RESERVED.  SO WE DO A LITTLE CALCULATION...
043700     IF MOD-DEL-FLAG = "M"
043800         SUBTRACT SAVE-QTY FROM DE-QTY GIVING R-QTY
043900     ELSE
044000     IF MOD-DEL-FLAG = "D"
044100         MOVE ZERO                 TO   R-QTY
044200     ELSE
044300         MOVE DE-QTY               TO   R-QTY.
044400     MOVE DE-WONO                  TO   R-WONO.
044500     MOVE DE-CORP-CODE             TO   R-CORP-CODE.
044600     IF MOD-DEL-FLAG = "A"
044700         MOVE 1                    TO   DATE-MODE
044800         CALL "TDATECHK" USING DATE-CHECK-AREA
044900         MOVE DATE-YMD-OUT         TO   R-DATE
               IF R-DATE-YY > "70"
                  MOVE "19" TO R-DATE-CC
               ELSE
                  MOVE "20" TO R-DATE-CC
               END-IF
045000         MOVE SPACES               TO   R-MACH
045100         MOVE SPACES               TO   R-MACH-SUB
045200         MOVE SPACES               TO   R-STAGE-LOC
045300         MOVE SPACES               TO   R-USE-DEPT
045400         MOVE SPACES               TO   R-WO-ITEM.
045500
045600 7150-CALL-CSWITCHF.
045700     CALL "CSWITCHF" USING VIEW-COMAREA, LANGUAGE-PARMS,
045800       FORMFILE, CSF-PARMS, BU-DISPLAY-MSG.
045900     IF BU-DISPLAY-MSG-1 NOT = SPACES
046000         PERFORM 2100-BLOWUP.
046100
046200 7200-VALIDATE-CODE.
046300     MOVE DE-CORP-CODE             TO   CODE-ARG.
           PERFORM 9999-DBGET7-MSTORERM-CD-I.
046600     IF NO-ENTRY
046700*        "E45: ENTRY DOES NOT EXIST"
046800         MOVE  5                   TO   LANG-SETNUM
046900         MOVE 45                   TO   LANG-MSGNUM
047000         MOVE 3                    TO   FIELD-NUMBER
047100         PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
047200         PERFORM 9954-SETERROR.
047700
       COPY DISPCALL IN COPYLIB.
       COPY DISPCAL2 IN COPYLIB.
       COPY HCATREAD IN COPYLIB.

       9930-LOCK.
       9940-UNLOCK.
       9951-GETNEXTFORM.
       9952-GETBUFFER.
           MOVE DISPLAY-REC TO DE-FIELDS.

       9953-PUTBUFFER.
           MOVE DE-FIELDS TO DISPLAY-REC.

       9954-SETERROR.
           MOVE B"1" TO IND (99).
           MOVE B"1" TO IND (FIELD-NUMBER).
           MOVE MESSAGE-BUFFER TO DE-MESSAGE-LINE.

       9955-CLEAR-FORM.
           MOVE SPACES TO DE-FIELDS, MESSAGE-BUFFER.

       9956-PUTWINDOW.
       9957-FIELDEDITS.
       9958-INITFORM.
       9959-SHOWFORM.
       9960-SETKEYLABEL.
       9961-AUTOREAD.
       9962-OPENFORM.
       9963-CLOSEFORM.
       9964-FINISHFORM.

       9999-DBGET7-MSTORERM-CD-I.
           MOVE 0 TO COND-WORD.
           MOVE CODE-ARG TO CORPCDE OF MSTORERM-CD-REC-I.
           READ MSTORERM-CD-I INTO BUF-MSTORERM
               INVALID KEY MOVE FILE-STATUS TO FILE-STATUS.
           IF FILE-STATUS = "23"
               MOVE 17 TO COND-WORD
           ELSE
           IF FILE-STATUS NOT = "00"
               MOVE "DBGET7 ERR 9999-DBGET7-MSTORERM-CD-I"
                   TO BU-MSG-AREA
               MOVE 99 TO COND-WORD
               PERFORM 2100-BLOWUP.

       9999-OPEN-STUFF.
           OPEN I-O DISPLAY-FILE.
           OPEN INPUT MSTORERM-CD-I                              .

       9999-CLOSE-STUFF.
           CLOSE DISPLAY-FILE.
           CLOSE      MSTORERM-CD-I                              .
