003100 COPY TBLOWUP    IN COPYLIB.
003200 COPY CSWITCHF   IN COPYLIB.
003300 COPY CRESERVE   IN COPYLIB.
       COPY DISPDAT2   IN COPYLIB.
       COPY IOFEEDBACK IN COPYLIB.
       COPY CATREAD    IN COPYLIB.
003400 01  FORMFILE                      PIC X(31) VALUE "FUDCSTR".
003500 01  SCREEN-PRINT-PARMS.
003600     05  PRINTCNTL                 PIC S9(4)  VALUE ZERO BINARY.
003700     05  PAGECNTL                  PIC S9(4)  VALUE 49   BINARY.
003800     05  SPOOLFIL-OPEN-SW          PIC X(1)   VALUE "N".
003900 01  FATAL-ERR-SW                  PIC X(1)  VALUE SPACES.
