001100 IDENTIFICATION DIVISION.
001200 PROGRAM-ID. TVALSUBS.
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER.   AS400.
001600 OBJECT-COMPUTER.   AS400.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WO-EQUIP-HIER
               ASSIGN TO DATABASE-MCFLMM1701
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS WEH-STATUS.
001700 DATA DIVISION.
       FILE SECTION.
       FD  WO-EQUIP-HIER
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WEHREC.
       01  WEHREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1701.
001800 WORKING-STORAGE SECTION.
       01  DESC-BUFFER.
           05  SUB-BUF-1                   PIC X.
           05  DESC-BUF-1                  PIC X(40).
           05  SUB-BUF-2                   PIC X.
           05  DESC-BUF-2                  PIC X(40).
           05  SUB-BUF-3                   PIC X.
           05  DESC-BUF-3                  PIC X(40).
           05  SUB-BUF-4                   PIC X.
           05  DESC-BUF-4                  PIC X(40).
           05  SUB-BUF-5                   PIC X.
           05  DESC-BUF-5                  PIC X(40).
           05  SUB-BUF-6                   PIC X.
           05  DESC-BUF-6                  PIC X(40).
           05  SUB-BUF-7                   PIC X.
           05  DESC-BUF-7                  PIC X(40).
           05  SUB-BUF-8                   PIC X.
           05  DESC-BUF-8                  PIC X(40).
           05  SUB-BUF-9                   PIC X.
           05  DESC-BUF-9                  PIC X(40).
           05  SUB-BUF-10                  PIC X.
           05  DESC-BUF-10                 PIC X(40).

       01  HIGHEST-SUB           PIC 99.

002000 01  KEY-4-HIER.
002100     02  KEY-TYPE                    PIC X(8).
002200     02  KEY-SUBS-1                  PIC X.
002300     02  KEY-SUBS-2                  PIC X.
002400     02  KEY-SUBS-3                  PIC X.
002500     02  KEY-SUBS-4                  PIC X.
002600     02  KEY-REST                    PIC XX.

002700 01  KEY-WORK-AREA.
002800     02  KEY-WA                      PIC X(14).
002900     02  KEY-SON.
003000         03  KEY-SON-1               PIC X.
003100         03  KEY-SON-2               PIC X.
003200         03  KEY-SON-3               PIC X.
003300         03  KEY-SON-4               PIC X.
003400         03  KEY-DISP-5-6            PIC XX.
003500     02  KEY-DESC                    PIC X(50).

003900 01  STATUS-AREA.      COPY P470003 OF COPYMMIS.

       01  WEH-STATUS                      PIC XX.
003600 LINKAGE SECTION.
003800 01  DBPARAMETERS.     COPY DBPARMS OF COPYLIB.
004000 01  EQUIPMENT-NUMBER                PIC X(6).
004100 01  SUBSYSTEMS-WORK-AREAS.
004500     02  EQUIP-TYPE                  PIC X(8).
004600     02  FAILURE-CODE-EQP.
004700         03  FC-1                    PIC X.
004800         03  FC-2                    PIC X.
004900         03  FILLER                  PIC X.
005000         03  FC-3                    PIC X.
005100         03  FC-4                    PIC X.
005200         03  FC-5                    PIC X.
005300         03  FC-6                    PIC X.
005400     02  LEVEL-SW                    PIC 9.
005500     02  RET-CODE                    PIC X.
005600     02  STAT-CW-SW                  PIC 9.
005700     02  SUBSYSTEM-TABLE.
005800         03  SST OCCURS 4 TIMES.
005900             04  SST-LEVEL           PIC X.
006000             04  SST-NAME            PIC X(50).
006100 PROCEDURE DIVISION USING DBPARAMETERS, EQUIPMENT-NUMBER
006300                      SUBSYSTEMS-WORK-AREAS.
006400 START-CHECK.
           PERFORM 1-HSK.
006500     PERFORM 6-MAIN.
006600 2-EOJ.
           CLOSE WO-EQUIP-HIER.
006700     GOBACK.
       1-HSK.
           OPEN INPUT  WO-EQUIP-HIER.
006800 6-MAIN.
006900     PERFORM 610-VALIDATE-FAIL-CODE THRU 610-VFC-EXIT.
007000 610-VALIDATE-FAIL-CODE.
007300     MOVE EQUIP-TYPE TO KEY-TYPE.
007400     MOVE SPACES TO KEY-REST.
007500     MOVE 0 TO LEVEL-SW.
007600     MOVE SPACES TO SUBSYSTEM-TABLE.
007700     IF FC-3 NOT NUMERIC GO TO 610-VFC-EXIT.
007800     IF FC-3 = " " OR "0" GO TO 610-VFC-EXIT.
007900     MOVE "0" TO KEY-SUBS-1 KEY-SUBS-2 KEY-SUBS-3 KEY-SUBS-4.
007200     MOVE 0 TO COND-WORD.
           MOVE KEY-4-HIER TO HIERKEY OF WEHREC.
           START WO-EQUIP-HIER KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 17 TO COND-WORD.
008200     IF COND-WORD = 17
008300         MOVE 1 TO LEVEL-SW
008400         GO TO 610-VFC-END.
008500 610-VFC-CONT.
           READ WO-EQUIP-HIER NEXT INTO KEY-WORK-AREA
               AT END    MOVE 15 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 15 TO COND-WORD.
008800     IF COND-WORD = 0
008900         NEXT SENTENCE
009000     ELSE
009100     MOVE 1 TO LEVEL-SW
009200     GO TO 610-VFC-END.
009300     IF FC-3 NOT = KEY-SON-1
009400         GO TO 610-VFC-CONT.
009500     MOVE KEY-SON-1 TO SST-LEVEL (1).
009600     MOVE KEY-DESC TO SST-NAME (1).
009700     IF FC-4 = " " OR "0" GO TO 610-VFC-END.
009800     MOVE FC-3 TO KEY-SUBS-1.
           MOVE 0 TO COND-WORD.
           MOVE KEY-4-HIER TO HIERKEY OF WEHREC.
           START WO-EQUIP-HIER KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 17 TO COND-WORD.
010100     IF COND-WORD = 17
010200         MOVE 2 TO LEVEL-SW
010300         GO TO 610-VFC-END.
010400 610-VFC-CONT-1.
           READ WO-EQUIP-HIER NEXT INTO KEY-WORK-AREA
               AT END    MOVE 15 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 15 TO COND-WORD.
010700     IF COND-WORD = 0
010800         NEXT SENTENCE
010900     ELSE
011000     MOVE 2 TO LEVEL-SW
011100     GO TO 610-VFC-END.
011200     IF FC-4 NOT = KEY-SON-2
011300         GO TO 610-VFC-CONT-1.
011400     MOVE KEY-SON-2 TO SST-LEVEL (2).
011500     MOVE KEY-DESC TO SST-NAME (2).
011600     IF FC-5 = " " OR "0" GO TO 610-VFC-END.
011700     MOVE FC-4 TO KEY-SUBS-2.
           MOVE 0 TO COND-WORD.
           MOVE KEY-4-HIER TO HIERKEY OF WEHREC.
           START WO-EQUIP-HIER KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 17 TO COND-WORD.
012000     IF COND-WORD = 17
012100         MOVE 3 TO LEVEL-SW
012200         GO TO 610-VFC-END.
012300 610-VFC-CONT-2.
           READ WO-EQUIP-HIER NEXT INTO KEY-WORK-AREA
               AT END    MOVE 15 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 15 TO COND-WORD.
012600     IF COND-WORD = 0
012700         NEXT SENTENCE
012800     ELSE
012900     MOVE 3 TO LEVEL-SW
013000     GO TO 610-VFC-END.
013100     IF FC-5 NOT = KEY-SON-3
013200         GO TO 610-VFC-CONT-2.
013300     MOVE KEY-SON-3 TO SST-LEVEL (3).
013400     MOVE KEY-DESC TO SST-NAME (3).
013500     MOVE FC-5 TO KEY-SUBS-3.
013600     IF FC-6 = " " OR "0" GO TO 610-VFC-END.
           MOVE 0 TO COND-WORD.
           MOVE KEY-4-HIER TO HIERKEY OF WEHREC.
           START WO-EQUIP-HIER KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 17 TO COND-WORD.
013900     IF COND-WORD = 17
014000         MOVE 4 TO LEVEL-SW
014100         GO TO 610-VFC-END.
014200 610-VFC-CONT-3.
           READ WO-EQUIP-HIER NEXT INTO KEY-WORK-AREA
               AT END    MOVE 15 TO COND-WORD.
           IF WEH-STATUS NOT = "00" MOVE 15 TO COND-WORD.
014500     IF COND-WORD = 0
014600         NEXT SENTENCE
014700     ELSE
014800     MOVE 4 TO LEVEL-SW
014900     GO TO 610-VFC-END.
015000     IF FC-6 NOT = KEY-SON-4
015100         GO TO 610-VFC-CONT-3.
015200     MOVE KEY-SON-4 TO SST-LEVEL (4).
015300     MOVE KEY-DESC TO SST-NAME (4).
015400 610-VFC-END.
015500     IF STAT-CW-SW = 1 GO TO 610-VFC-END-CONT-1.
015600     IF LEVEL-SW > 0 NEXT SENTENCE    ELSE
015700         GO TO 610-VFC-EXIT.
016200     MOVE 1 TO STAT-CW-SW.
016900     GO TO 610-VFC-EXIT.
017000 610-VFC-END-CONT-1.
017400     IF LEVEL-SW = 1
017800         MOVE "X" TO FC-3
017900         CALL "TEQPHIER" USING DBPARAMETERS
                                     EQUIP-TYPE
                                     FAILURE-CODE-EQP
018000                               DESC-BUFFER
018100                               HIGHEST-SUB.
018900         GO TO 610-VFC-EXIT.
019000     IF LEVEL-SW = 2
019400         MOVE "X" TO FC-4
017900         CALL "TEQPHIER" USING DBPARAMETERS
                                     EQUIP-TYPE
                                     FAILURE-CODE-EQP
018000                               DESC-BUFFER
018100                               HIGHEST-SUB
020500         GO TO 610-VFC-EXIT.
020600     IF LEVEL-SW = 3
021000         MOVE "X" TO FC-5
017900         CALL "TEQPHIER" USING DBPARAMETERS
                                     EQUIP-TYPE
                                     FAILURE-CODE-EQP
018000                               DESC-BUFFER
018100                               HIGHEST-SUB
022100         GO TO 610-VFC-EXIT.
022200     IF LEVEL-SW = 4
022600         MOVE "X" TO FC-6
017900         CALL "TEQPHIER" USING DBPARAMETERS
                                     EQUIP-TYPE
                                     FAILURE-CODE-EQP
018000                               DESC-BUFFER
018100                               HIGHEST-SUB
023700         GO TO 610-VFC-EXIT.
023800     MOVE 0 TO LEVEL-SW.
023900 610-VFC-EXIT.    EXIT.
