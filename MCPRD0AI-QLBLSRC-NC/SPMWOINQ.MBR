           COPY SCREENIO       IN COPYLIB.

           COPY CATREAD        IN COPYLIB.

           COPY JCWAREA        IN COPYLIB.

           COPY OVRPFDATA      IN COPYLIB.

       01  MESSAGE-FILE-DATA.
           COPY ERRORLIN       IN COPYLIB.

       01  WO-PLANNED-DATA.
           COPY DWOPLAN        IN COPYLIB.

       01  ZONE-DATA.
           COPY MZONPRTY       IN COPYLIB.

       01  EQUIPMENT-DATA.
           COPY MEQPFILE       IN COPYLIB.

       LINKAGE SECTION.
       01  DBPARAMETERS.
           COPY DBPARMS        IN COPYLIB.

       PROCEDURE DIVISION      USING DBPARAMETERS.
       OPEN-FILES-SECTION      SECTION 01.
       OPEN-FILES.
           MOVE 2              TO SORT-SW.
           MOVE 0              TO PRINT-SW.
           CALL               "CLPMWOINQ".
           OPEN INPUT          WO-PLANNED.
           OPEN INPUT          WO-ZONE-PRTY.
           OPEN INPUT          EQUIPMENT-FILE.
           OPEN INPUT          PM-SCHEDULE.
           OPEN I-O            DISPLAY-FILE.
           ACCEPT              MC-LOCAL-DATA-AREA
               FROM            LOCAL-DATA-AREA.

       BEGIN.
           MOVE SPACES         TO SCREEN-DATA MESSAGE-BUFFER
                                  SELECT-SCREEN-DATA LINE-DATA.
           MOVE JCW-ZJCW-269   TO ZONE-BUF ZONE-FIELD.
           MOVE "VPMWOSEL"     TO SCREEN-NAME.

       1-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SELECT-SCREEN-DATA TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SELECT-SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT NOT = 0
               GO TO 1-SHOWFORM.

           IF ZONE-BUF = SPACES
               MOVE  "ALL "    TO ZONE-BUF.

           IF ZONE-BUF = "ALL " OR " ALL"
               MOVE "ALL "     TO ZONE-BUF ZONE-FIELD
               MOVE ZONE-BUF   TO Z-ARG
               GO TO CONT-ZONE.

           IF ZONE-BUF = "?   " OR "??  " OR "??? " OR "????" OR
                         " ?  " OR "  ? " OR "   ?" OR "??  " OR
                         " ?? " OR "  ??" OR "??? " OR "??? "
               CALL "TRTVZONE" USING ZONE-BUF
               IF ZONE-BUF NOT = SPACES
                   MOVE ZONE-BUF TO ZONE-FIELD
                   GO TO CONT-ZONE.

           MOVE ZONE-BUF       TO Z-ARG.
           MOVE ZONE-ARGUMENT  TO ZONEPRTY OF WO-ZONE-PRTY.
           READ WO-ZONE-PRTY   INTO ZONE-DATA
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
      ************************************************************
      ****  MESSAGE:  INVALID ZONE
      ************************************************************
               MOVE  35        TO CATREAD-MSG-SET
               MOVE  44        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE FILE-STAT  TO CON-WORD
               MOVE CON-WORD   TO MSG-FLD
               MOVE MESSAGE-BUFFER TO ERRMSGZ
               MOVE TRUE-VAL   TO IND(1) IND(99)
               GO TO 1-SHOWFORM.

       CONT-ZONE.
           MOVE ZONE-FIELD     TO JCW-ZONE.
           IF JCW-ZONE = "ALL "
               MOVE "    "     TO JCW-ZONE.

           MOVE JCW-ZONE       TO SETJCW-VALUE JCW-ZJCW-269.
           MOVE 269            TO SETJCW-STARTING-POS.
           MOVE 4              TO SETJCW-LENGTH.
           MOVE "00"           TO SETJCW-STATUS.

           CALL "SETJCW"       USING SETJCW-VALUE
                               SETJCW-STARTING-POS
                               SETJCW-LENGTH
                               SETJCW-STATUS.
           IF SETJCW-STATUS NOT = "00"
               MOVE "    "     TO JCW-ZJCW-269.

           IF EQUIP-BUF = SPACES
               NEXT SENTENCE
           ELSE
               MOVE EQUIP-BUF      TO EQPNUM OF EQUIPMENT-FILE
               READ EQUIPMENT-FILE INTO EQUIPMENT-DATA
                   INVALID KEY     MOVE FILE-STAT TO FILE-STAT
               END-READ
               IF FILE-STAT NOT = "00"
                   CALL "TRTVEQP"      USING EQUIP-BUF.

           IF UI-BUF = SPACE OR "U" OR "I"
               NEXT SENTENCE
           ELSE
      *M**************************************************************
      *M  MESSAGE:  035/105
      *M  INVALID ENTRY
      *M**************************************************************
                   MOVE  35       TO CATREAD-MSG-SET
                   MOVE 105       TO CATREAD-MSG-NUM
                   PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
                   MOVE FILE-STAT TO CON-WORD
                   MOVE CON-WORD  TO MSG-FLD
                   MOVE MESSAGE-BUFFER TO ERRMSGZ
                   MOVE B"1"      TO IND(7) IND(99)
                   GO TO 1-SHOWFORM.

           MOVE "VPMWOINQ"     TO SCREEN-NAME.

       6-MAIN.
           MOVE 0              TO ACT-KEY PAGE-CTR.
           MOVE 60             TO LINE-CTR.
           IF SORT-SW = 1
               SORT SORT-FILE      ASCENDING KEY SORT-WO
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC
           ELSE
           IF SORT-SW = 2
               SORT SORT-FILE      ASCENDING KEY SORT-EQUIP
                                                 SORT-WO
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC
           ELSE
           IF SORT-SW = 3
               SORT SORT-FILE      ASCENDING KEY SORT-ZONE
                                                 SORT-WO
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC
           ELSE
           IF SORT-SW = 4
               SORT SORT-FILE      ASCENDING KEY SORT-JPLAN
                                                 SORT-WO
                 INPUT  PROCEDURE  SORT-IN-PROC
                 OUTPUT PROCEDURE  SORT-OUT-PROC.

           IF ACT-KEY = 0
               MOVE "VPMWOSEL" TO SCREEN-NAME
      ************************************************************
      ****  MESSAGE:  NO RECORDS FOUND WHICH MATCH YOUR SELECTION
      ************************************************************
               MOVE  40        TO CATREAD-MSG-SET
               MOVE  11        TO CATREAD-MSG-NUM
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE MESSAGE-BUFFER TO ERRMSGZ
               MOVE TRUE-VAL   TO IND(99)
               GO TO 1-SHOWFORM.

           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.

       61-RESET-SCREEN.
           MOVE SPACES         TO SCREEN-DATA.
           PERFORM 62-FILL-SCREEN THRU 62-FS-EXIT.
      ************************************************************
      ****  MESSAGE:  PRESS `ENTER' TO CONTINUE OR
      ****                        PRESS APPROPRIATE FUNCTION KEY
      ************************************************************
           MOVE  42            TO CATREAD-MSG-SET.
           MOVE  69            TO CATREAD-MSG-NUM.
           PERFORM 999-CATREAD THRU 999-CATREAD-EXIT.
           MOVE MESSAGE-BUFFER TO CMDMSG.

       61-SHOWFORM.
           MOVE "00"           TO SCREEN-STATUS.
           MOVE SCREEN-DATA    TO DISPLAY-REC.

           WRITE DISPLAY-REC   FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS.
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN WRITE ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           READ  DISPLAY-FILE  FORMAT IS SCREEN-NAME
                               INDIC ARE SCREEN-INDICATORS
           IF SCREEN-STATUS NOT = "00"
               DISPLAY "SCREEN READ ERROR.  SCREEN-STATUS IS "
                               SCREEN-STATUS
               GO TO END-OF-JOB.

           MOVE DISPLAY-REC    TO SCREEN-DATA.
           MOVE ALL B"0"       TO SCREEN-INDICATORS.

           IF KEY-HIT = 3 OR 8
               GO TO END-OF-JOB.

           IF KEY-HIT = 1
               MOVE "    "     TO JCW-ZJCW-269
               CLOSE           OUT-FILE
               GO TO BEGIN.

           IF KEY-HIT = 2
               MOVE 1          TO PRINT-SW
               CLOSE           OUT-FILE
               ACCEPT CUR-DATE FROM DATE
               MOVE CUR-YY     TO P-DATE-YY
               MOVE CUR-MM     TO P-DATE-MM
               MOVE CUR-DD     TO P-DATE-DD
               ACCEPT TIME-BUF FROM TIME
               MOVE HRS        TO TIME-H
               MOVE MIN        TO TIME-M
               MOVE SEC        TO TIME-S
               MOVE TIME-EXP   TO P-TIME
               GO TO 6-MAIN.

           IF KEY-HIT = 4
               MOVE 1          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 5
               MOVE 2          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 6
               MOVE 3          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT = 7
               MOVE 4          TO SORT-SW
               CLOSE           OUT-FILE
               GO TO 6-MAIN.

           IF KEY-HIT NOT = 0
               GO TO 61-SHOWFORM.

           IF EOF-SW = 1
               MOVE 0          TO EOF-SW
               MOVE 0          TO ACT-KEY.

           GO TO 61-RESET-SCREEN.

       62-FILL-SCREEN.
           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-1.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-2.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-3.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-4.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-5.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-6.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-7.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-8.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-9.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-10.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-11.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-12.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-13.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-14.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-15.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           IF ACT-KEY > MAX-KEY
               MOVE 1          TO EOF-SW
               GO TO 62-FS-EXIT.
           PERFORM 62-MOVE-DATA.
           MOVE LINE-DATA      TO LINE-16.

       62-FS-EXIT.             EXIT.

       62-MOVE-DATA.
           MOVE SPACES         TO  LINE-DATA.
           MOVE OUT-WO         TO  WONUM-L.
           MOVE OUT-INIT       TO  INIT-L.
           MOVE OUT-EQUIP      TO  EQUIP-L.
           MOVE OUT-ZONE       TO  ZONE-L.
           MOVE OUT-DESCRIPT   TO  DESC-L.
           MOVE OUT-JPLAN      TO  JPLAN-L.
           MOVE OUT-SCHED      TO  SCHED-L.
           MOVE OUT-PS         TO  PSSW-L.
           MOVE OUT-PLSC       TO  PLSC-L.

       END-OF-JOB.
           CLOSE               WO-PLANNED.
           CLOSE               WO-ZONE-PRTY.
           CLOSE               EQUIPMENT-FILE.
           CLOSE               PM-SCHEDULE.
           CLOSE               DISPLAY-FILE.
           CLOSE               OUT-FILE.
           GOBACK.

       999-CATREAD.
           MOVE SPACES         TO MESSAGE-BUFFER.
           CALL "CCATREAD"     USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO MESSAGE-BUFFER.

       999-CATREAD-EXIT.       EXIT.

       SORT-IN-PROC            SECTION 02.
       SORT-IN-PROC-MAIN.
           PERFORM SORT-MAIN   THRU SORT-M-EXIT.
           GO TO SORT-IP-EXIT.

       SORT-MAIN.
           MOVE SPACES         TO SORT-REC.
           READ WO-PLANNED     FIRST INTO WO-PLANNED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ FST" TO DB-FUNC
                   MOVE "WO-PLANNED" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO 61-SHOWFORM.

           GO TO SORT-CONT.

       SORT-LOOP.
           MOVE SPACES         TO SORT-REC.
           READ WO-PLANNED     NEXT INTO WO-PLANNED-DATA
               AT END          MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT NOT = "00"
               IF FILE-STAT = "10" OR "14" OR "46"
                   GO TO SORT-M-EXIT
               ELSE
                   MOVE FILE-STAT  TO CON-WORD
                   MOVE "READ NXT" TO DB-FUNC
                   MOVE "WO-PLANNED" TO DB-FILE
                   MOVE DB-ERROR   TO MESSAGE-BUFFER
                   GO TO 61-SHOWFORM.

       SORT-CONT.
           IF WO-START-STATUS NOT = "AA"
               GO TO SORT-LOOP.

           IF WO-NUM-SUFF-P NOT = "000"
               GO TO SORT-LOOP.

           IF ZONE-BUF = "ALL "
               NEXT SENTENCE
           ELSE
               IF ZONE-P NOT = ZONE-BUF
                   GO TO SORT-LOOP.

           IF EQUIP-BUF = SPACES OR EQUIP-NUM-P
               NEXT SENTENCE
           ELSE
               GO TO SORT-LOOP.

           IF PLNR-BUF = SPACES OR PLANNER-P
               NEXT SENTENCE
           ELSE
               GO TO SORT-LOOP.

           IF SCHD-BUF = SPACES OR SCHEDULER-P
               NEXT SENTENCE
           ELSE
               GO TO SORT-LOOP.

           IF JPLAN-BUF = SPACES OR PM-JOBPLAN-KEY
               NEXT SENTENCE
           ELSE
               GO TO SORT-LOOP.

           IF SCHED-BUF = SPACES OR PM-SCHEDULE-KEY
               NEXT SENTENCE
           ELSE
               GO TO SORT-LOOP.

           MOVE WO-NUM-PLANNED TO WONUM OF PM-SCHEDULE.
           START PM-SCHEDULE   KEY = WONUM OF PM-SCHEDULE
               INVALID KEY     MOVE FILE-STAT TO FILE-STAT.
           IF FILE-STAT = "00"
               MOVE ">"        TO SORT-INIT.

           IF UI-BUF = " "
               NEXT SENTENCE
           ELSE
           IF UI-BUF = "I" AND SORT-INIT = ">"
               NEXT SENTENCE
           ELSE
           IF UI-BUF = "U" AND SORT-INIT = " "
               NEXT SENTENCE
           ELSE
               GO TO SORT-LOOP.

           MOVE WO-NUM-PLANNED  TO SORT-WO.
           MOVE EQUIP-NUM-P     TO SORT-EQUIP.
           MOVE ZONE-P          TO SORT-ZONE.
           MOVE DESCRIPTION-1-P TO SORT-DESCRIPT.
           MOVE PM-JOBPLAN-KEY  TO SORT-JPLAN.
           MOVE PM-SCHEDULE-KEY TO SORT-SCHED.

           MOVE "P"             TO SORT-PS.
           MOVE PLANNER-P       TO SORT-PLSC.
           IF PLNR-BUF = SPACES AND SCHD-BUF NOT = SPACES
               MOVE "S"         TO SORT-PS
               MOVE SCHEDULER-P TO SORT-PLSC.

           RELEASE             SORT-REC.
           GO TO SORT-LOOP.

       SORT-M-EXIT.            EXIT.

       SORT-IP-EXIT.           EXIT.

       SORT-OUT-PROC           SECTION 03.
       SORT-OUT-PROC-MAIN.
           OPEN OUTPUT         OUT-FILE.
           PERFORM SORT-READ-LOOP THRU SRL-EXIT.
           CLOSE               OUT-FILE.
           PERFORM SORT-PRINT-LOOP THRU SPL-EXIT.
           GO TO SORT-OP-EXIT.

       SORT-READ-LOOP.
           RETURN SORT-FILE    AT END
               MOVE ACT-KEY    TO MAX-KEY
               GO TO SRL-EXIT.
           ADD 1               TO ACT-KEY.
           MOVE SORT-REC       TO OUT-REC.
           WRITE OUT-REC       INVALID KEY
               DISPLAY "WRITE OUT-FILE ERR"
               GO TO SRL-EXIT.
           GO TO SORT-READ-LOOP.

       SRL-EXIT.               EXIT.

       SORT-PRINT-LOOP.
           IF PRINT-SWITCH-IS-OFF
               GO TO SPL-EXIT.

      *    MOVE 0              TO OVRPRTF-TOFILE-NUM.
           MOVE "P "           TO OVRPRTF-TOFILE-NUM-X.
           MOVE "MCPRT"        TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           MOVE 0              TO ACT-KEY.
           OPEN INPUT          OUT-FILE.
           OPEN OUTPUT         PRINT-FILE.

       PRINT-LOOP.
           IF LINE-CTR > 59
               PERFORM PRINT-HEADINGS.

           ADD 1               TO ACT-KEY.
           MOVE SPACES         TO OUT-REC.
           READ OUT-FILE       INVALID KEY
               GO TO PL-EXIT.
           IF ACT-KEY > MAX-KEY
               GO TO PL-EXIT.

           MOVE OUT-WO         TO  WONUM-PR.
           MOVE OUT-INIT       TO  INIT-PR.
           MOVE OUT-EQUIP      TO  EQUIP-PR.
           MOVE OUT-ZONE       TO  ZONE-PR.
           MOVE OUT-DESCRIPT   TO  DESC-PR.
           MOVE OUT-JPLAN      TO  JPLAN-PR.
           MOVE OUT-SCHED      TO  SCHED-PR.
           MOVE OUT-PS         TO  PSSW-PR.
           MOVE OUT-PLSC       TO  PLSC-PR.
           MOVE PRINT-LINE     TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           ADD  1              TO LINE-CTR.
           GO TO PRINT-LOOP.

       PL-EXIT.
           CLOSE               OUT-FILE.
           CLOSE               PRINT-FILE.
           MOVE 0              TO PRINT-SW.
           GO TO SPL-EXIT.

       PRINT-HEADINGS.
           ADD  1              TO PAGE-CTR.
           MOVE PAGE-CTR       TO ZPAGE.
           MOVE DATE-HEADER    TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING NEW-PAGE.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TITLE-HEADER   TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE TEXT-HEADER    TO PRINT-REC
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE DASH-LINE      TO PRINT-REC.
           WRITE PRINT-REC     AFTER ADVANCING 1 LINES.
           MOVE 6              TO LINE-CTR.

       COPY OVRPFCALL IN COPYLIB.

       SPL-EXIT.               EXIT.

       SORT-OP-EXIT.           EXIT.

