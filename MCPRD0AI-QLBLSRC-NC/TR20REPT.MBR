               10  SORT-CRAFT-2          PIC XX.
               10  SORT-CRAFT-3          PIC XX.
           05  SORT-DN                   PIC X.
           05  SORT-OOTIME               PIC X(4).
           05  SORT-IPTIME               PIC X(4).
           05  SORT-CWTIME               PIC X(4).
           05  SORT-DOWNTIME             PIC 9(4).
           05  SORT-REPRTIME             PIC 9(4).
           05  SORT-RESPTIME             PIC 9(4).
           05  SORT-OO-PREV              PIC X.
           05  SORT-IP-PREV              PIC X.
           05  SORT-NORESP               PIC X.
           05  SORT-DESC                 PIC X(30).
           05  SORT-FAILCODE.
               10  SORT-FC-1-2           PIC XX.
               10  SORT-FC-3-6           PIC X(4).
           05  SORT-RECD-MINS            PIC 9(4).
           05  SORT-COMP-MINS            PIC 9(4).

       FD  WO-BASIC-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WBFREC.
       01  WBFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1002.

       FD  WO-LABOR-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLFREC.
       01  WLFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM1301.

       FD  WO-LAST-NUM-USED
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS WLNUREC.
       01  WLNUREC.
           COPY DDS-ALL-FORMATS OF MCFPMM0800.

       FD  ZONE-FILE
           RECORD CONTAINS 34 CHARACTERS
           DATA RECORD IS ZONF-REC.
       01  ZONF-REC.
           COPY DDS-ALL-FORMATS OF MCFPMMZONF.

