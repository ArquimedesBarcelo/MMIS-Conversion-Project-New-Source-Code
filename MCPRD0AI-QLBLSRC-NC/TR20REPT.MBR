               10  FILLER                PIC XX VALUE "HM".
           05  S-ENTRIES REDEFINES STAT-ENTRIES.
               10  S-E OCCURS 4 TIMES    PIC XX.

       01  UNDERLINE-LINE                PIC X(132) VALUE ALL "_".

       COPY TBLOWUP IN COPYLIB.

       01  TIME-BUFFER.
           05  TIME-HHMM.
               10  TIME-HH               PIC 99.
               10  TIME-MM               PIC 99.
           05  FILLER                    PIC XX.

       01  TIME-RECD-WORK.
           05  TIME-RECD-WORK-HH         PIC 99.
           05  TIME-RECD-WORK-MM         PIC 99.

       01  TIME-STRT-WORK.
           05  TIME-STRT-WORK-HH         PIC 99.
           05  TIME-STRT-WORK-MM         PIC 99.

       COPY VCOMLINK  OF COPYLIB.

       01  WHO-VARIABLES.
           05  USERNAME                  PIC X(10).
           05  TERMNUM                   PIC X(10).
           05  USERLIB                   PIC X(10).
           05  JOBLIBX                   PIC X.

       01  WO-BASIC-DATA.      COPY DWOBASIC OF COPYLIB.

       01  WO-LABOR-DATA.      COPY DWOLABOR OF COPYLIB.

       01  WORK-TABLE.
           05  WORKF OCCURS 100 TIMES.
               10  WORK-ZONE             PIC X(4).
               10  WORK-EQTYPE           PIC X(8).
               10  WORK-STATUS           PIC XX.
               10  WORK-EQPNO            PIC X(6).
               10  WORK-WO               PIC X(10).
               10  WORK-CRAFT-1          PIC XX.
               10  WORK-MAN-OR-CRAFT.
                   15  WORK-CRAFT-2      PIC XX.
                   15  WORK-CRAFT-3      PIC XX.
               10  WORK-DN               PIC X.
               10  WORK-OOTIME           PIC X(4).
               10  WORK-IPTIME           PIC X(4).
               10  WORK-CWTIME           PIC X(4).
               10  WORK-DOWNTIME         PIC 9(4).
               10  WORK-REPRTIME         PIC 9(4).
               10  WORK-RESPTIME         PIC 9(4).
               10  WORK-OO-PREV          PIC X.
               10  WORK-IP-PREV          PIC X.
               10  WORK-NORESP           PIC X.
               10  WORK-DESC             PIC X(30).
               10  WORK-FAILCODE.
                   15  WORK-FC-1-2       PIC XX.
                   15  WORK-FC-3-6       PIC XXXX.
               10  WORK-RECD-MINS        PIC 9(4).
               10  WORK-COMP-MINS        PIC 9(4).
               10  WORK-CT-OVLP          PIC X.
               10  FILLER                PIC X.

       01  ZFKEY                         PIC 9(9).
       01  ZONE-ARG                      PIC X(4).
       01  ZONF-DATA.
           05  ZONE-READ                 PIC X(4).
           05  STARTIN.
               10  SIN.
                   15  SINCC             PIC X(2).
                   15  SINYY             PIC X(2).
                   15  SINMM             PIC X(2).
                   15  SINDD             PIC X(2).
               10  SINTIME               PIC X(4).
           05  ENDIN.
               10  EIN.
                   15  EINCC             PIC X(2).
                   15  EINYY             PIC X(2).
                   15  EINMM             PIC X(2).
                   15  EINDD             PIC X(2).
               10  EINTIME               PIC X(4).
           05  CRAFTSIN.
               10  CIN-1                 PIC X(2).
               10  CIN-2                 PIC X(2).
               10  CIN-3                 PIC X(2).

       COPY THDPRTB IN COPYLIB.
       01  OPTION-REC            PIC X(80).
       PROCEDURE DIVISION.
       START-PROCESSING.
           CALL "CLR20RPT".
           PERFORM 1-HSK.
           PERFORM 6-MAIN THRU 6-MAIN-EXIT.

       2-EOJ.
           MOVE SPACES TO PRINTF.
           WRITE PRINTF FROM NORMAL-PRINT AFTER ADVANCING NEW-PAGE.
           CLOSE EQUIPMENT-FILE.
           CLOSE OUT-FILE.
           CLOSE PRINT-FILE.
           CLOSE SHIFT-STRUCTURE-FILE.
           CLOSE WO-BASIC-FILE.
           CLOSE WO-LABOR-FILE.
           CLOSE WO-LAST-NUM-USED.
           CLOSE ZONE-FILE.
           CALL "MCDLT" USING DELETE-FILE.
           GOBACK.

       1-HSK.
           OPEN INPUT  EQUIPMENT-FILE.
           OPEN INPUT  SHIFT-STRUCTURE-FILE.
           OPEN INPUT  WO-BASIC-FILE.
           OPEN INPUT  WO-LABOR-FILE.
           OPEN INPUT  WO-LAST-NUM-USED.
           OPEN INPUT  ZONE-FILE.
           CALL "CLWHO" USING USERNAME TERMNUM USERLIB JOBLIBX.
           PERFORM 60-READ-ZONF.
           CLOSE ZONE-FILE.

       6-MAIN.
           IF ZONE-READ = "ALL "
               SORT SORT-FILE ON ASCENDING KEY SORT-KEY
                                               SORT-EQPNO
                                               SORT-STATUS
      *                                        SORT-FC-3-6
                                               SORT-RECD-MINS
                   INPUT PROCEDURE  7-INPUT-RECORDS
                   OUTPUT PROCEDURE 8-WRITE-OUTPUT
           ELSE
           SORT SORT-FILE ON ASCENDING KEY SORT-EQTYPE
                                           SORT-EQPNO
                                           SORT-STATUS
      *                                    SORT-FC-3-6
                                           SORT-RECD-MINS
               INPUT PROCEDURE  7-INPUT-RECORDS
               OUTPUT PROCEDURE 8-WRITE-OUTPUT.

           MOVE 0 TO ACT-KEY.
           CLOSE OUT-FILE.
           OPEN INPUT OUT-FILE.
           ACCEPT HD-ROUTE-DATA.
           DISPLAY HD-ROUTE-DATA.
           MOVE HD-SPOOLER-NUMBER TO OVRPRTF-TOFILE-NUM.
           MOVE "*YES"            TO OVRPRTF-SHARED.
           MOVE HD-NO-OF-COPIES   TO OVRPRTF-COPIES.
           MOVE "MCPRT"           TO OVRPRTF-FILE.
           PERFORM 996-OVERRIDE-PRINT-FILE.
           OPEN OUTPUT PRINT-FILE.

           MOVE "HMMISR20.PUB"   TO HD-FILE-NAME.
           CALL "THDPRT2" USING HD-RET-CODE, HD-FILE-NAME, FNUM,
               HD-ROUTE-DATA, ESC-NAME.

           IF HD-RET-CODE NOT = 0
               MOVE "THDPRT2 ERROR * TR20REPT" TO BU-DISPLAY-MSG
               MOVE "HD-RET-CODE = "           TO BU-DISPLAY-FLD (1)
               MOVE HD-RET-CODE                TO BU-DISPLAY-FLD9 (1)
               PERFORM 998-BLOWUP.

           CALL "TESCSEQ" USING ESC-NAME.
           MOVE CHAR-1636PI     TO COMPRESS-PRINT.
           MOVE CHAR-10PI       TO NORMAL-PRINT.

           MOVE SPACES                     TO PRINTF.
           MOVE DATE-TIME-MIN-DISPLAY      TO PRINTF.
           WRITE PRINTF AFTER ADVANCING NEW-PAGE.
           MOVE DATE-TIME-MAX-DISPLAY      TO PRINTF.
           WRITE PRINTF.
           MOVE PASS-DATE-TIME-MIN-DISPLAY TO PRINTF.
           WRITE PRINTF.
           MOVE PASS-DATE-TIME-MAX-DISPLAY TO PRINTF.
           WRITE PRINTF.
           MOVE USED-DATE-TIME-MIN-DISPLAY TO PRINTF.
           WRITE PRINTF.
           MOVE USED-DATE-TIME-MAX-DISPLAY TO PRINTF.
           WRITE PRINTF.
           MOVE SPACES                     TO PRINTF.
           WRITE PRINTF BEFORE ADVANCING NEW-PAGE.

           IF NOT PAPER-IS-132-COLS
               WRITE PRINTF FROM COMPRESS-PRINT AFTER ADVANCING 0.

           MOVE ZEROES TO TOTAL-SHIFT-DOWN-MINS
                          TOTAL-SHIFT-REPR-MINS
                          TOTAL-SHIFT-RESP-MINS
                          ZONE-TOTAL-SHIFT-DOWN-MINS
                          ZONE-TOTAL-SHIFT-REPR-MINS
                          ZONE-TOTAL-SHIFT-RESP-MINS.

           MOVE 0 TO TOTAL-WO-DOWN-CTR TOTAL-WO-REPR-CTR
               TOTAL-WO-RESP-CTR EQTYPE-CTR ZONE-TOTAL-WO-DOWN-CTR
               ZONE-TOTAL-WO-REPR-CTR ZONE-TOTAL-WO-RESP-CTR
               ZONE-EQTYPE-CTR.

           IF PLANT-IDENT = "129" OR "153" OR "629"
               MOVE SPACES TO VAR-H1
               MOVE "SHIFT W/O REPORT FOR ZONE " TO P153-VAR
           ELSE
           MOVE SPACES TO VAR-H1
           MOVE "SHIFT W/O REPORT" TO H1-VAR.

       6-READ-OUTF-LOOP.
           ADD 1 TO ACT-KEY.
           IF ACT-KEY > SORT-RECS-CTR
               MOVE TOTAL-SHIFT-DOWN-MINS TO D-TOTDN
               MOVE TOTAL-SHIFT-REPR-MINS TO D-TOTRP
               MOVE TOTAL-SHIFT-RESP-MINS TO D-TOTRS
               MOVE EQTYPE-CTR TO D-TOTWO
               ADD TOTAL-SHIFT-DOWN-MINS TO ZONE-TOTAL-SHIFT-DOWN-MINS
               ADD TOTAL-SHIFT-REPR-MINS TO ZONE-TOTAL-SHIFT-REPR-MINS
               ADD TOTAL-SHIFT-RESP-MINS TO ZONE-TOTAL-SHIFT-RESP-MINS
               ADD EQTYPE-CTR TO ZONE-EQTYPE-CTR
               ADD TOTAL-WO-DOWN-CTR TO ZONE-TOTAL-WO-DOWN-CTR
               ADD TOTAL-WO-REPR-CTR TO ZONE-TOTAL-WO-REPR-CTR
               ADD TOTAL-WO-RESP-CTR TO ZONE-TOTAL-WO-RESP-CTR
               MOVE DETAIL-LINE-2 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 2 LINES
               DIVIDE TOTAL-SHIFT-REPR-MINS BY TOTAL-WO-REPR-CTR
                   GIVING TOTAL-AVG-WA ROUNDED
               MOVE TOTAL-AVG-WA TO D-AVGRP
               DIVIDE TOTAL-SHIFT-RESP-MINS BY TOTAL-WO-RESP-CTR
                   GIVING TOTAL-AVG-WA ROUNDED
               MOVE TOTAL-AVG-WA TO D-AVGRS
               MOVE DETAIL-LINE-3 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               MOVE UNDERLINE-LINE TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               MOVE "ZONE " TO D2-NAME
               MOVE ZONE-TOTAL-SHIFT-DOWN-MINS TO D-TOTDN
               MOVE ZONE-TOTAL-SHIFT-REPR-MINS TO D-TOTRP
               MOVE ZONE-TOTAL-SHIFT-RESP-MINS TO D-TOTRS
               MOVE ZONE-EQTYPE-CTR TO D-TOTWO
               MOVE DETAIL-LINE-2 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 3 LINES
               DIVIDE ZONE-TOTAL-SHIFT-REPR-MINS BY
                   ZONE-TOTAL-WO-REPR-CTR
                       GIVING TOTAL-AVG-WA ROUNDED
               MOVE TOTAL-AVG-WA TO D-AVGRP
               DIVIDE ZONE-TOTAL-SHIFT-RESP-MINS BY
                   ZONE-TOTAL-WO-RESP-CTR
                       GIVING TOTAL-AVG-WA ROUNDED
               MOVE TOTAL-AVG-WA TO D-AVGRS
               MOVE DETAIL-LINE-3 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               GO TO 2-EOJ.

           READ OUT-FILE    INVALID KEY GO TO 6-MAIN-EXIT.
           IF OUT-ZONE NOT = SAVE-ZONE
               MOVE OUT-ZONE TO SAVE-ZONE P153-Z
               IF ZONE-READ = "ALL "
                   IF FST-SW = 0
                       MOVE 1 TO FST-SW
                       ADD 1 TO PAGE-CTR
                       MOVE PAGE-CTR TO P-CTR
                       MOVE DATE-SLASH-OUT TO H1-DATE
                       MOVE TIME-HH TO H1-HRS
                       MOVE TIME-MM TO H1-MIN
                       MOVE OUT-EQTYPE TO SAVE-EQTYPE
                       MOVE 0 TO LINE-CTR
                       MOVE HEADER1 TO PRINTF
                       WRITE PRINTF AFTER ADVANCING NEW-PAGE
                       PERFORM 61-GET-EQUIPMENT-DESC THRU 61-GED-EXIT
                       MOVE EQP-EQUIP-NAME TO H5-CTYP
                       MOVE OUT-EQTYPE TO H5-TYPE
                       MOVE HEADER5 TO PRINTF
                       WRITE PRINTF AFTER ADVANCING 2 LINES
                       MOVE HEADER2 TO PRINTF
                       WRITE PRINTF AFTER ADVANCING 2 LINES
                       MOVE HEADER3 TO PRINTF
                       WRITE PRINTF AFTER ADVANCING 1 LINES
                       MOVE HEADER4 TO PRINTF
                       WRITE PRINTF AFTER ADVANCING 1 LINES
                       MOVE 7 TO LINE-CTR
                   ELSE
                   MOVE TOTAL-SHIFT-DOWN-MINS TO D-TOTDN
                   MOVE TOTAL-SHIFT-REPR-MINS TO D-TOTRP
                   MOVE TOTAL-SHIFT-RESP-MINS TO D-TOTRS
                   MOVE EQTYPE-CTR TO D-TOTWO
                   ADD TOTAL-SHIFT-DOWN-MINS TO
                       ZONE-TOTAL-SHIFT-DOWN-MINS
                   ADD TOTAL-SHIFT-REPR-MINS TO
                       ZONE-TOTAL-SHIFT-REPR-MINS
                   ADD TOTAL-SHIFT-RESP-MINS TO
                       ZONE-TOTAL-SHIFT-RESP-MINS
                   ADD EQTYPE-CTR TO ZONE-EQTYPE-CTR
                   ADD TOTAL-WO-DOWN-CTR TO ZONE-TOTAL-WO-DOWN-CTR
                   ADD TOTAL-WO-REPR-CTR TO ZONE-TOTAL-WO-REPR-CTR
                   ADD TOTAL-WO-RESP-CTR TO ZONE-TOTAL-WO-RESP-CTR
                   MOVE DETAIL-LINE-2 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 2 LINES
                   DIVIDE TOTAL-SHIFT-REPR-MINS BY TOTAL-WO-REPR-CTR
                       GIVING TOTAL-AVG-WA ROUNDED
                   MOVE TOTAL-AVG-WA TO D-AVGRP
                   DIVIDE TOTAL-SHIFT-RESP-MINS BY TOTAL-WO-RESP-CTR
                       GIVING TOTAL-AVG-WA ROUNDED
                   MOVE TOTAL-AVG-WA TO D-AVGRS
                   MOVE DETAIL-LINE-3 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE UNDERLINE-LINE TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE "ZONE " TO D2-NAME
                   MOVE ZONE-TOTAL-SHIFT-DOWN-MINS TO D-TOTDN
                   MOVE ZONE-TOTAL-SHIFT-REPR-MINS TO D-TOTRP
                   MOVE ZONE-TOTAL-SHIFT-RESP-MINS TO D-TOTRS
                   MOVE ZONE-EQTYPE-CTR TO D-TOTWO
                   MOVE DETAIL-LINE-2 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 3 LINES
                   DIVIDE ZONE-TOTAL-SHIFT-REPR-MINS BY
                       ZONE-TOTAL-WO-REPR-CTR
                           GIVING TOTAL-AVG-WA ROUNDED
                   MOVE TOTAL-AVG-WA TO D-AVGRP
                   DIVIDE ZONE-TOTAL-SHIFT-RESP-MINS BY
                       ZONE-TOTAL-WO-RESP-CTR
                          GIVING TOTAL-AVG-WA ROUNDED
                   MOVE TOTAL-AVG-WA TO D-AVGRS
                   MOVE DETAIL-LINE-3 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE SPACES TO D2-NAME
                   MOVE 0      TO EQTYPE-CTR ZONE-EQTYPE-CTR
                                  TOTAL-WO-DOWN-CTR
                                  TOTAL-WO-REPR-CTR
                                  TOTAL-WO-RESP-CTR
                                  ZONE-TOTAL-WO-DOWN-CTR
                                  ZONE-TOTAL-WO-REPR-CTR
                                  ZONE-TOTAL-WO-RESP-CTR
                   MOVE ZEROES TO TOTAL-SHIFT-DOWN-MINS
                                  TOTAL-SHIFT-REPR-MINS
                                  TOTAL-SHIFT-RESP-MINS
                                  ZONE-TOTAL-SHIFT-DOWN-MINS
                                  ZONE-TOTAL-SHIFT-REPR-MINS
                                  ZONE-TOTAL-SHIFT-RESP-MINS
                   MOVE OUT-EQTYPE TO SAVE-EQTYPE
                   MOVE 0 TO LINE-CTR
                   ADD 1 TO PAGE-CTR
                   MOVE PAGE-CTR TO P-CTR
                   MOVE DATE-SLASH-OUT TO H1-DATE
                   MOVE TIME-HH TO H1-HRS
                   MOVE TIME-MM TO H1-MIN
                   MOVE HEADER1 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING NEW-PAGE
                   PERFORM 61-GET-EQUIPMENT-DESC THRU
                       61-GED-EXIT
                   MOVE EQP-EQUIP-NAME TO H5-CTYP
                   MOVE OUT-EQTYPE TO H5-TYPE
                   MOVE HEADER5 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 2 LINES
                   MOVE HEADER2 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 2 LINES
                   MOVE HEADER3 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE HEADER4 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE 7 TO LINE-CTR.

           IF OUT-EQTYPE NOT = SAVE-EQTYPE
               IF FST-SW = 0
                   MOVE 1 TO FST-SW
                   ADD 1 TO PAGE-CTR
                   MOVE PAGE-CTR TO P-CTR
                   MOVE DATE-SLASH-OUT TO H1-DATE
                   MOVE TIME-HH TO H1-HRS
                   MOVE TIME-MM TO H1-MIN
                   MOVE OUT-EQTYPE TO SAVE-EQTYPE
                   MOVE 0 TO LINE-CTR
                   MOVE HEADER1 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING NEW-PAGE
                   PERFORM 61-GET-EQUIPMENT-DESC THRU 61-GED-EXIT
                   MOVE EQP-EQUIP-NAME TO H5-CTYP
                   MOVE OUT-EQTYPE TO H5-TYPE
                   MOVE HEADER5 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 2 LINES
                   MOVE HEADER2 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 2 LINES
                   MOVE HEADER3 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE HEADER4 TO PRINTF
                   WRITE PRINTF AFTER ADVANCING 1 LINES
                   MOVE 7 TO LINE-CTR
               ELSE
               MOVE TOTAL-SHIFT-DOWN-MINS TO D-TOTDN
               MOVE TOTAL-SHIFT-REPR-MINS TO D-TOTRP
               MOVE TOTAL-SHIFT-RESP-MINS TO D-TOTRS
               MOVE EQTYPE-CTR TO D-TOTWO
               ADD TOTAL-SHIFT-DOWN-MINS TO ZONE-TOTAL-SHIFT-DOWN-MINS
               ADD TOTAL-SHIFT-REPR-MINS TO ZONE-TOTAL-SHIFT-REPR-MINS
               ADD TOTAL-SHIFT-RESP-MINS TO ZONE-TOTAL-SHIFT-RESP-MINS
               ADD EQTYPE-CTR TO ZONE-EQTYPE-CTR
               ADD TOTAL-WO-DOWN-CTR TO ZONE-TOTAL-WO-DOWN-CTR
               ADD TOTAL-WO-REPR-CTR TO ZONE-TOTAL-WO-REPR-CTR
               ADD TOTAL-WO-RESP-CTR TO ZONE-TOTAL-WO-RESP-CTR
               MOVE DETAIL-LINE-2 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 2 LINES
               ADD 2 TO LINE-CTR
               DIVIDE TOTAL-SHIFT-REPR-MINS BY TOTAL-WO-REPR-CTR
                   GIVING TOTAL-AVG-WA ROUNDED
               MOVE TOTAL-AVG-WA TO D-AVGRP
               DIVIDE TOTAL-SHIFT-RESP-MINS BY TOTAL-WO-RESP-CTR
                   GIVING TOTAL-AVG-WA ROUNDED
               MOVE TOTAL-AVG-WA TO D-AVGRS
               MOVE DETAIL-LINE-3 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               ADD 1 TO LINE-CTR
               MOVE 0 TO EQTYPE-CTR
               MOVE 0 TO TOTAL-WO-DOWN-CTR
               MOVE 0 TO TOTAL-WO-REPR-CTR
               MOVE 0 TO TOTAL-WO-RESP-CTR
               MOVE ZEROES TO TOTAL-SHIFT-DOWN-MINS
                              TOTAL-SHIFT-REPR-MINS
                              TOTAL-SHIFT-RESP-MINS
               MOVE OUT-EQTYPE TO SAVE-EQTYPE
               ADD 5 TO LINE-CTR
               IF LINE-CTR > 59
                   NEXT SENTENCE
               ELSE
               MOVE UNDERLINE-LINE TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               PERFORM 61-GET-EQUIPMENT-DESC THRU 61-GED-EXIT
               MOVE EQP-EQUIP-NAME TO H5-CTYP
               MOVE OUT-EQTYPE TO H5-TYPE
               MOVE HEADER5 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 2 LINES
               MOVE SPACES TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES.

           IF LINE-CTR > 59
               MOVE 0 TO LINE-CTR
               ADD 1 TO PAGE-CTR
               MOVE PAGE-CTR TO P-CTR
               MOVE DATE-SLASH-OUT TO H1-DATE
               MOVE TIME-HH TO H1-HRS
               MOVE TIME-MM TO H1-MIN
               MOVE UNDERLINE-LINE TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               MOVE HEADER1 TO PRINTF
               WRITE PRINTF AFTER ADVANCING NEW-PAGE
               PERFORM 61-GET-EQUIPMENT-DESC THRU 61-GED-EXIT
               MOVE EQP-EQUIP-NAME TO H5-CTYP
               MOVE OUT-EQTYPE TO H5-TYPE
               MOVE HEADER5 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 2 LINES
               MOVE HEADER2 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 2 LINES
               MOVE HEADER3 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               MOVE HEADER4 TO PRINTF
               WRITE PRINTF AFTER ADVANCING 1 LINES
               MOVE 7 TO LINE-CTR.

           ADD 1 TO EQTYPE-CTR.
           MOVE OUT-EQPNO TO D-EQPNO.
           MOVE OUT-WO1-7 TO D-WO1-7.
           MOVE OUT-WO8-10 TO D-WO8-10.
           MOVE OUT-STATUS TO D-ST.
           MOVE OUT-FAILCODE TO D-FAIL.
           MOVE OUT-CRAFT-1 TO D-CRF1.
           MOVE SPACES TO VAR-CRFT-D1.

           IF PLANT-IDENT = "153"
               IF OUT-CRAFT-2 = "MT"
                   MOVE OUT-CRAFT-2 TO D-CRF2
                   MOVE OUT-CRAFT-3 TO D-CRF3
               ELSE
               IF OUT-CRAFT-3 = "MT"
                   MOVE OUT-CRAFT-2 TO D-CRF2
                   MOVE OUT-CRAFT-3 TO D-CRF3
               ELSE
               MOVE OUT-MAN-OR-CRAFT TO VAR-CRFT-D1
           ELSE
           MOVE OUT-CRAFT-2 TO D-CRF2
           MOVE OUT-CRAFT-3 TO D-CRF3.

           MOVE OUT-DN TO D-DN.
           MOVE OUT-OOTIME TO D-OT.

           IF OUT-OO-PREV = "*"
      *        MOVE "PREVIOUS SHIFT" TO D-COMS
               MOVE OUT-OO-PREV TO D-OT-AS
           ELSE
           MOVE SPACES TO D-COMS D-OT-AS.

           MOVE OUT-IPTIME TO D-IT.
           IF OUT-IP-PREV = "*"
      *        MOVE "PREVIOUS SHIFT" TO D-COMS
               MOVE "*" TO D-IT-AS
           ELSE
           MOVE SPACES TO D-COMS D-IT-AS.

           MOVE OUT-CWTIME TO D-CT.
           MOVE OUT-DOWNTIME TO D-DOWNT.

           IF OUT-DOWNTIME > 0
               IF OUT-CT-OVLP = "Y"
                   MOVE 0 TO SUB
                   PERFORM 6-CK-OVERLAP THRU 6-CK-OVERLAP-EXIT
                   ADD OUT-DOWNTIME TO TOTAL-SHIFT-DOWN-MINS
               ELSE
               ADD OUT-DOWNTIME TO TOTAL-SHIFT-DOWN-MINS.

           ADD 1 TO TOTAL-WO-DOWN-CTR.
           MOVE OUT-REPRTIME TO D-REPRT.

           IF OUT-REPRTIME > 0
               ADD OUT-REPRTIME TO TOTAL-SHIFT-REPR-MINS.

           ADD 1 TO TOTAL-WO-REPR-CTR.
           MOVE OUT-RESPTIME TO D-RESPT.

           IF OUT-RESPTIME > 0
               ADD OUT-RESPTIME TO TOTAL-SHIFT-RESP-MINS.
           ADD 1 TO TOTAL-WO-RESP-CTR.

      *    IF OUT-NORESP = "*" MOVE "NO RESPONSE" TO D-COMS.
           MOVE OUT-DESC TO D-COMS.
           MOVE DETAIL-LINE-1 TO PRINTF.
           WRITE PRINTF AFTER ADVANCING 1 LINES.
           ADD 1 TO LINE-CTR.
           GO TO 6-READ-OUTF-LOOP.

       6-MAIN-EXIT.    EXIT.

       6-CK-OVERLAP.
           ADD 1 TO SUB.
           IF SUB > 100 OR ENUM (SUB) = SPACES
               GO TO 6-CK-OVERLAP-EXIT.
           IF OUT-EQPNO = ENUM (SUB)
               MOVE EDOWNT (SUB) TO OUT-DOWNTIME
               MOVE ZEROES TO EDOWNT (SUB)
           ELSE
           GO TO 6-CK-OVERLAP.

       6-CK-OVERLAP-EXIT.    EXIT.

       60-READ-ZONF.
           MOVE SPACES TO ZONF-DATA.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ZFKEY.
           READ ZONE-FILE INTO ZONF-DATA
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF ZF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE "ALL " TO ZONE-READ.

       61-GET-EQUIPMENT-DESC.
           MOVE 0 TO COND-WORD.
           MOVE OUT-EQPNO TO EQPNUM OF EFREC.
           START EQUIPMENT-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 17 TO COND-WORD.

           IF COND-WORD = 17
                MOVE SPACES TO EQUIPMENT-DATA
                GO TO 61-GED-EXIT.

           READ EQUIPMENT-FILE NEXT INTO EQUIPMENT-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF EF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE SPACES TO EQUIPMENT-DATA.

       61-GED-EXIT.    EXIT.

       COPY OVRPFCALL IN COPYLIB.

       998-BLOWUP.
           MOVE "TVWOREV" TO BU-PGM-NAME.
           CALL "TBLOWUP" USING BLOWUP-BASE BU-PGM-NAME STATUS-AREA
                            VIEW-COMAREA DUMMY-KSAM-STAT
                            BU-DISPLAY-MSG BU-DISPLAY-FLDS.

       999-CATREAD.
           MOVE SPACES TO ERROR-BUFFER.
           CALL "CCATREAD" USING CATREAD-PARMS.
           MOVE CATREAD-MSG-TEXT TO ERROR-BUFFER.

       999-CATREAD-EXIT.    EXIT.

       7-INPUT-RECORDS SECTION.
       7-INPUT-RECS.
           MOVE LOW-VALUES TO STATUS-AREA.
           MOVE 0 TO COND-WORD.
           MOVE 1 TO ARG-NO.

           READ WO-LAST-NUM-USED INTO LAST-WO-BUFF
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF WLNU-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 MOVE 1 TO DATE-FLAG-SW.

           MOVE DATE-FLAG-SW TO DATE-FLAG.
           MOVE 1 TO DATE-MODE.
           MOVE DATE-FLAG TO DATE-CODE.
           CALL "TDATECHK" USING DATE-CHECK-AREA.
           MOVE 0 TO COND-WORD.
           MOVE "CLRL" TO ZONE-ARG.
           MOVE SPACES TO SHIFT-STRUCTURE.
           MOVE ZONE-ARG TO SHIFTZONE OF SSFREC.

           START SHIFT-STRUCTURE-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD.
           IF SSF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17
               MOVE 66137 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO PRINTF
               WRITE PRINTF AFTER ADVANCING NEW-PAGE
               GO TO 2-EOJ.

           READ SHIFT-STRUCTURE-FILE NEXT INTO SHIFT-STRUCTURE
               AT END    MOVE 15 TO COND-WORD.
           IF SSF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15
               MOVE 66137 TO CATREAD-MSG-NUMBER
               PERFORM 999-CATREAD THRU 999-CATREAD-EXIT
               MOVE ERROR-BUFFER TO PRINTF
               WRITE PRINTF AFTER ADVANCING NEW-PAGE
               GO TO 2-EOJ.

           ACCEPT CUR-DATE-WA FROM DATE.
           IF CUR-DATE-YY > "70"
               MOVE "19"    TO CUR-DATE-CC
                               GREG-CC
           ELSE
           MOVE "20"        TO CUR-DATE-CC
                               GREG-CC.
           MOVE CUR-DATE-MM TO GREG-MM.
           MOVE CUR-DATE-DD TO GREG-DD.
           MOVE CUR-DATE-YY TO GREG-YY.
           MOVE SPACES      TO JULIAN-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG.
           MOVE JULIAN-DATE-9 TO CUR-JUL-DAY.
           ACCEPT TIME-BUFFER FROM TIME.
           SUBTRACT 55 FROM FRST-SHIFT
           SUBTRACT 55 FROM SCND-SHIFT
           IF THRD-SHIFT-X = "    " MOVE ZEROES TO THRD-SHIFT.
           SUBTRACT 55 FROM THRD-SHIFT.

           IF CODE-VALUE = "2"
               IF TIME-HHMM > FRST-SHIFT AND < SCND-SHIFT
                   SUBTRACT 1 FROM CUR-JUL-DAY GIVING CUR-JUL-DAY-1
                   MOVE CUR-JUL-DAY-1 TO JULIAN-DATE-9
                   MOVE SPACES TO GREG-DATE
                   CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                    DAY-DIGIT, LEAP-YEAR-FLAG
                   MOVE GREG-YY TO DATE-MIN-YY
                   MOVE GREG-MM TO DATE-MIN-MM
                   MOVE GREG-DD TO DATE-MIN-DD
                   ADD 55 SCND-SHIFT GIVING TIME-MIN-HHMM-9
                   MOVE CUR-DATE-YY TO DATE-MAX-YY
                   MOVE CUR-DATE-MM TO DATE-MAX-MM
                   MOVE CUR-DATE-DD TO DATE-MAX-DD
                   ADD 55 FRST-SHIFT GIVING TIME-MAX-HHMM-9
               ELSE
               IF TIME-HHMM < FRST-SHIFT
                   SUBTRACT 1 FROM CUR-JUL-DAY GIVING CUR-JUL-DAY-1
                   MOVE CUR-JUL-DAY-1 TO JULIAN-DATE-9
                   MOVE SPACES TO GREG-DATE
                   CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                    DAY-DIGIT, LEAP-YEAR-FLAG
                   MOVE GREG-YY TO DATE-MIN-YY DATE-MAX-YY
                   MOVE GREG-MM TO DATE-MIN-MM DATE-MAX-MM
                   MOVE GREG-DD TO DATE-MIN-DD DATE-MAX-DD
                   ADD 55 FRST-SHIFT GIVING TIME-MIN-HHMM-9
                   ADD 55 SCND-SHIFT GIVING TIME-MAX-HHMM-9
               ELSE
               MOVE CUR-DATE-YY TO DATE-MIN-YY DATE-MAX-YY
               MOVE CUR-DATE-MM TO DATE-MIN-MM DATE-MAX-MM
               MOVE CUR-DATE-DD TO DATE-MIN-DD DATE-MAX-DD
               ADD 55 FRST-SHIFT GIVING TIME-MIN-HHMM-9
               ADD 55 SCND-SHIFT GIVING TIME-MAX-HHMM-9
           ELSE
           IF TIME-HHMM > FRST-SHIFT AND < SCND-SHIFT
               SUBTRACT 1 FROM CUR-JUL-DAY GIVING CUR-JUL-DAY-1
               MOVE CUR-JUL-DAY-1 TO JULIAN-DATE-9
               MOVE SPACES TO GREG-DATE
               CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                DAY-DIGIT, LEAP-YEAR-FLAG
               MOVE GREG-YY TO DATE-MIN-YY
               MOVE GREG-MM TO DATE-MIN-MM
               MOVE GREG-DD TO DATE-MIN-DD
               ADD 55 THRD-SHIFT GIVING TIME-MIN-HHMM-9
               MOVE CUR-DATE-YY TO DATE-MAX-YY
               MOVE CUR-DATE-MM TO DATE-MAX-MM
               MOVE CUR-DATE-DD TO DATE-MAX-DD
               ADD 55 FRST-SHIFT GIVING TIME-MAX-HHMM-9
           ELSE
           IF TIME-HHMM > SCND-SHIFT AND < THRD-SHIFT
               MOVE CUR-DATE-YY TO DATE-MIN-YY DATE-MAX-YY
               MOVE CUR-DATE-MM TO DATE-MIN-MM DATE-MAX-MM
               MOVE CUR-DATE-DD TO DATE-MIN-DD DATE-MAX-DD
               ADD 55 FRST-SHIFT GIVING TIME-MIN-HHMM-9
               ADD 55 SCND-SHIFT GIVING TIME-MAX-HHMM-9
           ELSE
           MOVE CUR-DATE-YY TO DATE-MIN-YY DATE-MAX-YY
           MOVE CUR-DATE-MM TO DATE-MIN-MM DATE-MAX-MM
           MOVE CUR-DATE-DD TO DATE-MIN-DD DATE-MAX-DD
           ADD 55 SCND-SHIFT GIVING TIME-MIN-HHMM-9
           ADD 55 THRD-SHIFT GIVING TIME-MAX-HHMM-9.
           IF DATE-MIN-YY > "70"
               MOVE "19"       TO DATE-MIN-CC
           ELSE
           MOVE "20"           TO DATE-MIN-CC.
           IF DATE-MAX-YY > "70"
               MOVE "19"       TO DATE-MAX-CC
           ELSE
           MOVE "20"           TO DATE-MAX-CC.

           MOVE DATE-TIME-MIN  TO DATE-TIME-MIN-DISP.
           MOVE DATE-TIME-MAX  TO DATE-TIME-MAX-DISP.
           MOVE STARTIN        TO DATE-TIME-MIN-PASS.
           MOVE ENDIN          TO DATE-TIME-MAX-PASS.

      ******************************************************************
      **   02/06/95    WDR
      **   CHANGED ZONF-FILE TO PASS BEGIN AND END DATE/TIMES.
      **   IF PASSED DATA IS NOT = SPACES:  USE IT INSTEAD
      ******************************************************************

           IF SINMM NOT = SPACES
               MOVE STARTIN    TO DATE-TIME-MIN.

           IF EINMM NOT = SPACES
               MOVE ENDIN      TO DATE-TIME-MAX.

           MOVE DATE-TIME-MIN  TO DATE-TIME-MIN-USED.
           MOVE DATE-TIME-MAX  TO DATE-TIME-MAX-USED.

           DISPLAY "DATE-TIME MINIMUM = " DATE-TIME-MIN-USED.
           DISPLAY "DATE-TIME MAXIMUM = " DATE-TIME-MAX-USED.

           MOVE DATE-TIME-MIN TO DATE-TIME-LABOR-MIN.
           SUBTRACT 1 FROM DT-LAB-MIN-HH.
           MOVE 54 TO DT-LAB-MIN-MI.
           DISPLAY "DATE/TIME LABOR MIN = " DATE-TIME-LABOR-MIN.
      *    PERFORM 71-READ-STATUSES THRU 71-RS-EXIT.

       71-READ-STATUSES.
           ADD 1 TO SUB.
           IF SUB > 4 GO TO 71-RS-EXIT.
           MOVE S-E (SUB) TO STAT-BUFF.
           MOVE 0 TO COND-WORD.
           MOVE STAT-BUFF TO WOSTATUS OF WBFREC.
           START WO-BASIC-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY     MOVE 17 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 17 TO COND-WORD.
           IF COND-WORD = 17 GO TO 71-READ-STATUSES.

       71-RS-LOOP.
           READ WO-BASIC-FILE NEXT INTO WO-BASIC-DATA
               AT END    MOVE 15 TO COND-WORD.
           IF STAT-BUFF NOT = WOSTATUS OF WBFREC
               MOVE 15 TO COND-WORD.
           IF WBF-STATUS NOT = "00" MOVE 15 TO COND-WORD.
           IF COND-WORD = 15 GO TO 71-READ-STATUSES.
           IF PRIORITY = "1 "
               NEXT SENTENCE
           ELSE
           GO TO 71-RS-LOOP.

           IF ZONE-READ = "ALL "
               NEXT SENTENCE
           ELSE
           IF ZONE-READ = ZONE
               NEXT SENTENCE
           ELSE
           GO TO 71-RS-LOOP.

           IF CRAFTSIN = SPACES
               GO TO 71-RS-CONT.

           IF CIN-1 NOT = SPACES
               IF CIN-1 = CRAFTS-REQD-1 OR
                          CRAFTS-REQD-2 OR
                          CRAFTS-REQD-3
                   GO TO 71-RS-CONT.

           IF CIN-2 NOT = SPACES
               IF CIN-2 = CRAFTS-REQD-1 OR
                          CRAFTS-REQD-2 OR
                          CRAFTS-REQD-3
                   GO TO 71-RS-CONT.

           IF CIN-3 NOT = SPACES
               IF CIN-3 = CRAFTS-REQD-1 OR
                          CRAFTS-REQD-2 OR
                          CRAFTS-REQD-3
                   GO TO 71-RS-CONT.
           GO TO 71-RS-LOOP.

       71-RS-CONT.
           MOVE SPACES TO SORTF.
           MOVE ZEROES TO SHIFT-DOWN-MINS
                          SHIFT-REPR-MINS
                          SHIFT-RESP-MINS.
           PERFORM 71-FIND-AND-GET-LABOR-RECS THRU 71-FAGLR-EXIT.
           IF S-E (SUB) = "CW"
               MOVE DATE-TIME-COMP TO DTC-WA
               MOVE FAILURE-CODE   TO SORT-FAILCODE
           ELSE
           IF S-E (SUB) = "IP"
               MOVE DATE-TIME-STRT TO DTC-WA
           ELSE
           MOVE DATE-TIME-RECD TO DTC-WA.
           IF S-E (SUB) = "OO" OR "HM"
               IF DTC-WA > DATE-TIME-MAX
                   GO TO 71-RS-LOOP
               ELSE
               NEXT SENTENCE
           ELSE
           IF S-E (SUB) = "IP"
               IF DTC-WA > DATE-TIME-MAX
                   GO TO 71-RS-LOOP
               ELSE
               NEXT SENTENCE
           ELSE
           IF DTC-WA > DATE-TIME-MIN AND DTC-WA < DATE-TIME-MAX
               NEXT SENTENCE
           ELSE
           GO TO 71-RS-LOOP.
           MOVE DATE-RECD-CC TO GREG-CC.
           MOVE DATE-RECD-YY TO GREG-YY.
           MOVE DATE-RECD-MM TO GREG-MM.
           MOVE DATE-RECD-DD TO GREG-DD.
           MOVE SPACES       TO JULIAN-DATE.
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG
           MOVE JULIAN-DATE-9 TO JUL-DAY-RECD.
           IF DATE-STRT-CN = "        "
               IF DATE-TIME-RECD > DATE-TIME-MIN
                   AND < DATE-TIME-MAX
                   MOVE DATE-RECD-CC TO DATE-STRT-CC GREG-CC
                   MOVE DATE-RECD-YY TO DATE-STRT-YY GREG-YY
                   MOVE DATE-RECD-MM TO DATE-STRT-MM GREG-MM
                   MOVE DATE-RECD-DD TO DATE-STRT-DD GREG-DD
                   MOVE TIME-RECD    TO TIME-STRT
                   CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                    DAY-DIGIT, LEAP-YEAR-FLAG
                   MOVE JULIAN-DATE-9 TO JUL-DAY-STRT
               ELSE
               MOVE DATE-MIN-CC TO DATE-STRT-CC GREG-CC
               MOVE DATE-MIN-YY TO DATE-STRT-YY GREG-YY
               MOVE DATE-MIN-MM TO DATE-STRT-MM GREG-MM
               MOVE DATE-MIN-DD TO DATE-STRT-DD GREG-DD
               MOVE TIME-MIN-HHMM TO TIME-STRT
               MOVE SPACES      TO JULIAN-DATE
               CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                DAY-DIGIT, LEAP-YEAR-FLAG
               MOVE JULIAN-DATE-9 TO JUL-DAY-STRT
           ELSE
           MOVE DATE-STRT-CC TO GREG-CC
           MOVE DATE-STRT-YY TO GREG-YY
           MOVE DATE-STRT-MM TO GREG-MM
           MOVE DATE-STRT-DD TO GREG-DD
           MOVE SPACES       TO JULIAN-DATE
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG
           MOVE JULIAN-DATE-9 TO JUL-DAY-STRT
           IF SORT-IPTIME = SPACES MOVE TIME-STRT TO SORT-IPTIME.
           IF DATE-COMP-CN = "        "
               MOVE DATE-MAX-CC TO DATE-COMP-CC GREG-CC
               MOVE DATE-MAX-YY TO DATE-COMP-YY GREG-YY
               MOVE DATE-MAX-MM TO DATE-COMP-MM GREG-MM
               MOVE DATE-MAX-DD TO DATE-COMP-DD GREG-DD
               MOVE TIME-MAX-HHMM TO TIME-COMP
               MOVE SPACES      TO JULIAN-DATE
               CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                                DAY-DIGIT, LEAP-YEAR-FLAG
               MOVE JULIAN-DATE-9 TO JUL-DAY-COMP
           ELSE
           MOVE DATE-COMP-CC TO GREG-CC
           MOVE DATE-COMP-YY TO GREG-YY
           MOVE DATE-COMP-MM TO GREG-MM
           MOVE DATE-COMP-DD TO GREG-DD
           MOVE SPACES       TO JULIAN-DATE
           CALL "JULGREG" USING GREG-DATE, JULIAN-DATE,
                            DAY-DIGIT, LEAP-YEAR-FLAG
           MOVE JULIAN-DATE-9 TO JUL-DAY-COMP.
           SUBTRACT JUL-DAY-RECD FROM JUL-DAY-COMP
               GIVING JD-DIFF-RECD-COMP.
           SUBTRACT JUL-DAY-RECD FROM CUR-JUL-DAY
               GIVING JD-DIFF-RECD-CURR.
           SUBTRACT JUL-DAY-STRT FROM JUL-DAY-COMP
               GIVING JD-DIFF-STRT-COMP.
           IF JD-DIFF-RECD-COMP > 1
               MOVE TIME-MIN-HHMM TO TIME-RECD-WORK
               MOVE "*" TO SORT-OO-PREV
           ELSE
           IF DATE-TIME-RECD > DATE-TIME-MIN AND < DATE-TIME-MAX
               MOVE TIME-RECD TO TIME-RECD-WORK
           ELSE
           MOVE "*" TO SORT-OO-PREV
           MOVE TIME-MIN-HHMM TO TIME-RECD-WORK.
           IF JD-DIFF-STRT-COMP > 1
               MOVE TIME-MIN-HHMM TO TIME-STRT-WORK
               MOVE "*" TO SORT-IP-PREV
           ELSE
           IF DATE-TIME-STRT > DATE-TIME-MIN AND < DATE-TIME-MAX
               MOVE TIME-STRT TO TIME-STRT-WORK
           ELSE
           IF S-E (SUB) = "OO"
               MOVE TIME-MIN-HHMM TO TIME-STRT-WORK
           ELSE
           MOVE "*" TO SORT-IP-PREV
           MOVE TIME-MIN-HHMM TO TIME-STRT-WORK.
           MULTIPLY TIME-RECD-WORK-HH BY 60 GIVING TRECD-MINS-WA.
           ADD TIME-RECD-WORK-MM TO TRECD-MINS-WA.
           MULTIPLY TIME-STRT-WORK-HH BY 60 GIVING TSTRT-MINS-WA.
           ADD TIME-STRT-WORK-MM TO TSTRT-MINS-WA.
           MULTIPLY TIME-COMP-HH BY 60 GIVING TCOMP-MINS-WA.
           ADD TIME-COMP-MM TO TCOMP-MINS-WA.
           MULTIPLY TIME-MIN-HH BY 60 GIVING TSHFT-STRT-MINS-WA.
           ADD TIME-MIN-MM TO TSHFT-STRT-MINS-WA.
           MULTIPLY TIME-MAX-HH BY 60 GIVING TSHFT-COMP-MINS-WA.
           ADD TIME-MAX-MM TO TSHFT-COMP-MINS-WA.
           MOVE TSHFT-COMP-MINS-WA TO SAVE-TSHFT-COMP-MINS-WA.
           IF TSHFT-COMP-MINS-WA < TSHFT-STRT-MINS-WA
               ADD 1440 TO TSHFT-COMP-MINS-WA.
           IF TRECD-MINS-WA = TSHFT-STRT-MINS-WA
               IF TSTRT-MINS-WA = TSHFT-STRT-MINS-WA
                   IF TRECD-MINS-WA > TCOMP-MINS-WA
                       ADD 1440 TO TCOMP-MINS-WA
                       SUBTRACT TRECD-MINS-WA FROM TCOMP-MINS-WA
                           GIVING SHIFT-RESP-MINS
                       MOVE SHIFT-RESP-MINS TO SHIFT-DOWN-MINS
                       GO TO 71-RS-LOOP-CONT
                   ELSE
                   SUBTRACT TRECD-MINS-WA FROM TCOMP-MINS-WA
                       GIVING SHIFT-RESP-MINS
                   MOVE SHIFT-RESP-MINS TO SHIFT-DOWN-MINS
                   GO TO 71-RS-LOOP-CONT
               ELSE
               NEXT SENTENCE
           ELSE
           IF TCOMP-MINS-WA = SAVE-TSHFT-COMP-MINS-WA
               IF TSTRT-MINS-WA = TSHFT-STRT-MINS-WA
                   IF TRECD-MINS-WA > TCOMP-MINS-WA
                       SUBTRACT TRECD-MINS-WA FROM TSHFT-COMP-MINS-WA
                           GIVING SHIFT-RESP-MINS
                       MOVE SHIFT-RESP-MINS TO SHIFT-DOWN-MINS
                       GO TO 71-RS-LOOP-CONT
                   ELSE
                   SUBTRACT TRECD-MINS-WA FROM TCOMP-MINS-WA
                       GIVING SHIFT-RESP-MINS
                   MOVE SHIFT-RESP-MINS TO SHIFT-DOWN-MINS
                   GO TO 71-RS-LOOP-CONT.
           IF TCOMP-MINS-WA < TSHFT-STRT-MINS-WA
               ADD 1440 TO TCOMP-MINS-WA.
           IF TSTRT-MINS-WA < TSHFT-STRT-MINS-WA
               ADD 1440 TO TSTRT-MINS-WA.
           IF TRECD-MINS-WA < TSHFT-STRT-MINS-WA
              ADD 1440 TO TRECD-MINS-WA.
           SUBTRACT TRECD-MINS-WA FROM TCOMP-MINS-WA
              GIVING SHIFT-DOWN-MINS.
           SUBTRACT TRECD-MINS-WA FROM TSTRT-MINS-WA
              GIVING SHIFT-RESP-MINS.

       71-RS-LOOP-CONT.
           MOVE ZONE TO SORT-ZONE.
           MOVE TYPE-NUM TO SORT-EQTYPE.
           MOVE WO-STATUS TO SORT-STATUS.
           MOVE EQUIP-NUM TO SORT-EQPNO.
           MOVE WO-NUM TO SORT-WO.
           MOVE CRAFTS-REQD-1 TO SORT-CRAFT-1.
           MOVE DESCRIPTION-1 TO SORT-DESC.
           IF PLANT-IDENT = "153"
               IF CRAFTSMEN-3 = "    "
                   IF CRAFTSMEN-2 = "    "
                       IF CRAFTSMEN-1 = "    "
                           NEXT SENTENCE
                       ELSE
                       MOVE CRAFTSMEN-1 TO SORT-MAN-OR-CRAFT
                   ELSE
                   MOVE CRAFTSMEN-2 TO SORT-MAN-OR-CRAFT
               ELSE
               MOVE CRAFTSMEN-3 TO SORT-MAN-OR-CRAFT
           ELSE
           MOVE CRAFTS-REQD-2 TO SORT-CRAFT-2
           MOVE CRAFTS-REQD-3 TO SORT-CRAFT-3.
           MOVE EQUIP-DOWN TO SORT-DN.
           IF WO-STATUS = "OO"
               MOVE TIME-RECD TO SORT-OOTIME
               MOVE "    " TO SORT-IPTIME SORT-CWTIME
           ELSE
           IF WO-STATUS = "IP" OR "HM"
               MOVE TIME-RECD TO SORT-OOTIME
               MOVE "    " TO SORT-CWTIME
           ELSE
           MOVE TIME-RECD TO SORT-OOTIME
           MOVE TIME-COMP TO SORT-CWTIME.
           MOVE TRECD-MINS-WA TO SORT-RECD-MINS.
           MOVE TCOMP-MINS-WA TO SORT-COMP-MINS.
           MOVE SHIFT-DOWN-MINS TO SORT-DOWNTIME.
           MOVE SHIFT-REPR-MINS TO SORT-REPRTIME.
           MOVE SHIFT-RESP-MINS TO SORT-RESPTIME.
           SUBTRACT SHIFT-RESP-MINS FROM SHIFT-DOWN-MINS
               GIVING SHIFT-SMOOTH-MINS.
           IF SORT-REPRTIME > SHIFT-SMOOTH-MINS
               MOVE SHIFT-SMOOTH-MINS TO SORT-REPRTIME.
           RELEASE SORTF.
           ADD 1 TO SORT-RECS-CTR.
           GO TO 71-RS-LOOP.

       71-FIND-AND-GET-LABOR-RECS.
           MOVE 0 TO COND-WORD2.
           MOVE WO-NUM TO WONUM OF WLFREC.
           START WO-LABOR-FILE KEY IS = EXTERNALLY-DESCRIBED-KEY
               INVALID KEY    MOVE 17 TO COND-WORD2.
           IF WLF-STATUS NOT = "00" MOVE 17 TO COND-WORD2.
           IF COND-WORD2 = 17 GO TO 71-FAGLR-EXIT.

       71-FAGLR-LOOP.
           MOVE 0 TO COND-WORD2.
           READ WO-LABOR-FILE NEXT INTO WO-LABOR-DATA
               AT END    MOVE 15 TO COND-WORD2.
           IF WO-NUM NOT = WONUM OF WLFREC
               MOVE 15 TO COND-WORD2.
           IF WLF-STATUS NOT = "00" MOVE 15 TO COND-WORD2.
           IF COND-WORD2 = 15 GO TO 71-FAGLR-EXIT.

           MOVE LBR-COMPL-DATE-CC TO LCD-CC.
           MOVE LBR-COMPL-DATE-YY TO LCD-YY.
           MOVE LBR-COMPL-DATE-MM TO LCD-MM.
           MOVE LBR-COMPL-DATE-DD TO LCD-DD.
           MOVE LBR-COMPL-TIME TO LCD-TIME-HHMM.

           IF LCD-WA > DATE-TIME-MIN AND < DATE-TIME-MAX
               MOVE LBR-START-DATE-CC TO LSD-CC
               MOVE LBR-START-DATE-YY TO LSD-YY
               MOVE LBR-START-DATE-MM TO LSD-MM
               MOVE LBR-START-DATE-DD TO LSD-DD
               MOVE LBR-START-TIME    TO LSD-TIME-HHMM
               IF LSD-WA > DATE-TIME-LABOR-MIN AND < DATE-TIME-MAX
                   IF LSD-TIME-HHMM > DT-LAB-MIN-HHMM
                           AND < TIME-MIN-HHMM
                       MOVE TIME-MIN-HHMM TO LSD-TIME-HHMM
                       ADD 1 TO LSD-TIME-MM
                       PERFORM 711-SET-IPTIME
                       DISPLAY "W/O " LBR-WO-NUM " STARTED EARLY"
                       DISPLAY "SORT IPTIME = " SORT-IPTIME
                   ELSE
                   PERFORM 711-SET-IPTIME
               ELSE
               NEXT SENTENCE
           ELSE
           GO TO 71-FAGLR-LOOP.

           MULTIPLY 60 BY LBR-START-TIME-HH
               GIVING TLABR-STRT-MINS-WA.
           ADD LBR-START-TIME-MM TO TLABR-STRT-MINS-WA.
           MULTIPLY 60 BY LBR-COMPL-TIME-HH
               GIVING TLABR-COMP-MINS-WA.
           ADD LBR-COMPL-TIME-MM TO TLABR-COMP-MINS-WA.
           IF TLABR-STRT-MINS-WA > TLABR-COMP-MINS-WA
               ADD 1440 TO TLABR-COMP-MINS-WA.
           SUBTRACT TLABR-STRT-MINS-WA FROM TLABR-COMP-MINS-WA
               GIVING TLABR-DIFF-MINS-WA.
           ADD TLABR-DIFF-MINS-WA TO SHIFT-REPR-MINS.
           GO TO 71-FAGLR-LOOP.

       711-SET-IPTIME.
           IF SORT-IPTIME = SPACES
               MOVE LSD-TIME-HHMM TO SORT-IPTIME
               MOVE LSD-WA TO DATE-TIME-STRT.
           IF SORT-IPTIME > LSD-TIME-HHMM
               MOVE LSD-TIME-HHMM TO SORT-IPTIME
               MOVE LSD-WA TO DATE-TIME-STRT.

       71-FAGLR-EXIT.    EXIT.

       71-RS-EXIT.    EXIT.

       7-IR-X.    EXIT.

       8-WRITE-OUTPUT SECTION.
       8-WRITE-PARA.
           MOVE 0 TO ACT-KEY.
           MOVE SPACES TO EQUIPMENT-TABLE.
           MOVE SPACES TO SAVE-EQPNO.
           OPEN OUTPUT OUT-FILE.

       8-WO-LOOP.
           RETURN SORT-FILE AT END GO TO 8-WO-EXIT.
           IF SAVE-EQPNO = SPACES
               MOVE SORT-EQPNO     TO SAVE-EQPNO
               ADD 1               TO SUB1
               MOVE SORTF          TO WORKF (SUB1)
           ELSE
           IF SAVE-EQPNO = SORT-EQPNO
               ADD 1               TO SUB1
               MOVE SORTF          TO WORKF (SUB1)
           ELSE
           MOVE 0                  TO SUB1
           MOVE 1                  TO SUB2
           PERFORM 8-PROCESS-TABLE THRU 8-PT-X
           MOVE SPACES             TO WORK-TABLE
           MOVE 1                  TO SUB1
           MOVE SORTF              TO WORKF (SUB1).
           MOVE SORT-EQPNO         TO SAVE-EQPNO
           GO TO 8-WO-LOOP.

       8-PROCESS-TABLE.
           ADD 1 TO SUB1.
           ADD 1 TO SUB2.
           IF SUB2 > 100 OR WORK-ZONE (SUB2) = "    "
               PERFORM 8-WRITE-OUTF
                   VARYING SUB FROM 1 BY 1 UNTIL SUB > 100
               GO TO 8-PT-X.
           IF SUB1 = 1
               MOVE WORK-RECD-MINS (SUB1)      TO SAVE-OOMINS
               MOVE WORK-COMP-MINS (SUB1)      TO SAVE-CWMINS.
           IF WORK-DOWNTIME (SUB1) = 720
               MOVE TSHFT-STRT-MINS-WA         TO SAVE-OOMINS
               MOVE TSHFT-COMP-MINS-WA         TO SAVE-CWMINS
               PERFORM 8-SET-DOWNTIME THRU 8-SD-X
               PERFORM 8-SET-OVLP     THRU 8-SO-X
                   VARYING SUB FROM 1 BY 1 UNTIL SUB > 100
               GO TO 8-PT-X
           ELSE
           IF WORK-DOWNTIME (SUB2) = 720
               MOVE TSHFT-STRT-MINS-WA         TO SAVE-OOMINS
               MOVE TSHFT-COMP-MINS-WA         TO SAVE-CWMINS
               PERFORM 8-SET-DOWNTIME THRU 8-SD-X
               PERFORM 8-SET-OVLP     THRU 8-SO-X
                   VARYING SUB FROM 1 BY 1 UNTIL SUB > 100
               GO TO 8-PT-X
           ELSE
           IF WORK-RECD-MINS (SUB2) = SAVE-OOMINS
               IF WORK-COMP-MINS (SUB2) < SAVE-CWMINS
      *    IF WORK-RECD-MINS (SUB2) = WORK-RECD-MINS (SUB1)
      *        IF WORK-COMP-MINS (SUB2) < WORK-COMP-MINS (SUB1)
                   PERFORM 8-SET-DOWNTIME THRU 8-SD-X
                   MOVE "Y" TO WORK-CT-OVLP (SUB1)
                               WORK-CT-OVLP (SUB2)
               ELSE
               IF WORK-COMP-MINS (SUB2) > SAVE-CWMINS
      *        IF WORK-COMP-MINS (SUB2) > WORK-COMP-MINS (SUB1)
                   MOVE WORK-COMP-MINS (SUB2) TO SAVE-CWMINS
                   PERFORM 8-SET-DOWNTIME THRU 8-SD-X
                   MOVE "Y" TO WORK-CT-OVLP (SUB1)
                               WORK-CT-OVLP (SUB2)
               ELSE
               NEXT SENTENCE
           ELSE
           IF WORK-RECD-MINS (SUB2) < SAVE-CWMINS
               IF SAVE-CWMINS < WORK-COMP-MINS (SUB2)
      *    IF WORK-RECD-MINS (SUB2) < WORK-COMP-MINS (SUB1)
      *        IF WORK-COMP-MINS (SUB1) < WORK-COMP-MINS (SUB2)
                   MOVE WORK-COMP-MINS (SUB2) TO SAVE-CWMINS
                   PERFORM 8-SET-DOWNTIME THRU 8-SD-X
                   MOVE "Y" TO WORK-CT-OVLP (SUB1)
                               WORK-CT-OVLP (SUB2)
               ELSE
               IF SAVE-CWMINS = WORK-COMP-MINS (SUB2)
                   IF WORK-RECD-MINS (SUB2) < SAVE-OOMINS
      *        IF WORK-COMP-MINS (SUB1) = WORK-COMP-MINS (SUB2)
      *            IF WORK-RECD-MINS (SUB2) < WORK-RECD-MINS (SUB1)
                       MOVE WORK-RECD-MINS (SUB2) TO SAVE-OOMINS
                       PERFORM 8-SET-DOWNTIME THRU 8-SD-X
                       MOVE "Y" TO WORK-CT-OVLP (SUB1)
                                   WORK-CT-OVLP (SUB2)
                   ELSE
                   PERFORM 8-SET-DOWNTIME THRU 8-SD-X
                   MOVE "Y" TO WORK-CT-OVLP (SUB1)
                               WORK-CT-OVLP (SUB2)
               ELSE
               IF WORK-COMP-MINS (SUB2) < SAVE-CWMINS
                   PERFORM 8-SET-DOWNTIME THRU 8-SD-X
                   MOVE "Y" TO WORK-CT-OVLP (SUB1)
                               WORK-CT-OVLP (SUB2)
               ELSE
               NEXT SENTENCE
           ELSE
           MOVE WORK-RECD-MINS (SUB2) TO SAVE-OOMINS
           MOVE WORK-COMP-MINS (SUB2) TO SAVE-CWMINS
           MOVE "N" TO WORK-CT-OVLP (SUB2).
           GO TO 8-PROCESS-TABLE.
       8-PT-X.    EXIT.

       8-WRITE-OUTF.
           IF WORK-ZONE (SUB) = "    "
               MOVE 101 TO SUB
           ELSE
           ADD 1 TO ACT-KEY
           MOVE WORKF (SUB) TO OUTF
      *    DISPLAY "OUTF = " OUTF
           WRITE OUTF    INVALID KEY GO TO 8-WOF-X.
       8-WOF-X.    EXIT.

       8-SET-OVLP.
           IF WORK-ZONE (SUB) = "    "
               MOVE 101 TO SUB
           ELSE
           MOVE "Y" TO WORK-CT-OVLP (SUB).
       8-SO-X.    EXIT.

       8-SET-DOWNTIME.
           MOVE 0 TO SUB.
       8-SD-LOOP.
           ADD 1 TO SUB.
           IF SUB > 100
               MOVE 0 TO SUB
               GO TO 8-SD-X.
           SUBTRACT SAVE-OOMINS FROM SAVE-CWMINS GIVING
               EQP-DOWN-MINS.
           IF EQP-DOWN-MINS > 720 MOVE 720 TO EQP-DOWN-MINS.
           IF ENUM (SUB) = SPACES
               MOVE WORK-EQPNO (SUB1) TO ENUM (SUB)
               MOVE EQP-DOWN-MINS     TO EDOWNT (SUB)
               DISPLAY "SET TABLE = " EQP-TAB (SUB)
               GO TO 8-SD-X
           ELSE
           IF ENUM (SUB) = SAVE-EQPNO
               IF EQP-DOWN-MINS < EDOWNT (SUB)
                   GO TO 8-SD-X
               ELSE
               IF EQP-DOWN-MINS > 719
                   GO TO 8-SD-X
               ELSE
               IF WORK-CT-OVLP (SUB1) = "N"
                   ADD EQP-DOWN-MINS TO EDOWNT (SUB)
                   DISPLAY "ADDED TO TABLE = " EQP-TAB (SUB)
                   GO TO 8-SD-X
               ELSE
               MOVE EQP-DOWN-MINS TO EDOWNT (SUB)
               DISPLAY "UPDATED TABLE = " EQP-TAB (SUB)
               GO TO 8-SD-X.
           GO TO 8-SD-LOOP.
       8-SD-X.    EXIT.

       8-WO-EXIT.    EXIT.
