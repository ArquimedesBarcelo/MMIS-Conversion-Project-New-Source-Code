       IDENTIFICATION DIVISION.
       PROGRAM-ID.      TR20REPT.
       ENVIRONMENT DIVISION.
      *REMARKS.    CREATE MMIS END-OF-SHIFT REPORT.
      *
      *   DATE    PROGRAMMER     DESCRIPTION
      *   ----    ----------     -----------
      * 12/21/01  BE GEISER      CHECK PASSED DATE FOR ALL SPACES PRIOR
      *                          TO USING. WAS CAUSING DATA DECIMAL ERROR
      *                          BECAUSE OF HARD-CODED CENTURY.
      *
      * 08/20/02  BE GEISER      INCREASED WORK TABLE SIZE FROM 25 TO 50.
      *
      * 08/30/02  WR FONAGY      INCREASED WORK TABLE SIZE FROM 50 TO 100.
      *
       CONFIGURATION SECTION.
       SOURCE-COMPUTER.   AS400.
       OBJECT-COMPUTER.   AS400.
       COPY SPECIALN OF COPYLIB.

       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT EQUIPMENT-FILE
               ASSIGN TO DATABASE-MCFLMM0201
               ORGANIZATION IS INDEXED
               ACCESS IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS EF-STATUS.

           SELECT OUT-FILE
               ASSIGN TO DATABASE-OUTSHIFM
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ACT-KEY
               FILE STATUS IS OF-STATUS.

           SELECT PRINT-FILE
               ASSIGN TO PRINTER-MCPRT.

           SELECT SHIFT-STRUCTURE-FILE
               ASSIGN TO DATABASE-MCFLMM2501
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY
               FILE STATUS IS SSF-STATUS.

           SELECT SORT-FILE
               ASSIGN TO DISK-SORTFILE.

           SELECT WO-BASIC-FILE
               ASSIGN TO DATABASE-MCFLMM1002
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WBF-STATUS.

           SELECT WO-LABOR-FILE
               ASSIGN TO DATABASE-MCFLMM1301
               ORGANIZATION IS INDEXED
               ACCESS MODE IS DYNAMIC
               RECORD KEY IS EXTERNALLY-DESCRIBED-KEY WITH DUPLICATES
               FILE STATUS IS WLF-STATUS.

           SELECT WO-LAST-NUM-USED
               ASSIGN TO DATABASE-MCFPMM0800
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ARG-NO
               FILE STATUS IS WLNU-STATUS.

           SELECT ZONE-FILE
               ASSIGN TO DATABASE-MCFPMMZONF
               ORGANIZATION IS RELATIVE
               ACCESS MODE IS RANDOM
               RELATIVE KEY IS ZFKEY
               FILE STATUS IS ZF-STATUS.

       DATA DIVISION.
       FILE SECTION.
       FD  EQUIPMENT-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS EFREC.
       01  EFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM0201.

       FD  OUT-FILE
           RECORD CONTAINS 110 CHARACTERS
           DATA RECORD IS OUTF.
       01  OUTF.
           05  OUT-DATA.
               10  OUT-ZONE              PIC X(4).
               10  OUT-EQTYPE            PIC X(8).
               10  OUT-STATUS            PIC XX.
               10  OUT-EQPNO             PIC X(6).
               10  OUT-WO.
                   15  OUT-WO1-7         PIC X(7).
                   15  OUT-WO8-10        PIC XXX.
               10  OUT-CRAFT-1           PIC XX.
               10  OUT-MAN-OR-CRAFT.
                   15  OUT-CRAFT-2       PIC XX.
                   15  OUT-CRAFT-3       PIC XX.
               10  OUT-DN                PIC X.
               10  OUT-OOTIME            PIC X(4).
               10  OUT-IPTIME            PIC X(4).
               10  OUT-CWTIME            PIC X(4).
               10  OUT-DOWNTIME          PIC 9(4).
               10  OUT-REPRTIME          PIC 9(4).
               10  OUT-RESPTIME          PIC 9(4).
               10  OUT-OO-PREV           PIC X.
               10  OUT-IP-PREV           PIC X.
               10  OUT-NORESP            PIC X.
               10  OUT-DESC              PIC X(30).
               10  OUT-FAILCODE          PIC X(6).
               10  OUT-RECD-MINS         PIC 9(4).
               10  OUT-COMP-MINS         PIC 9(4).
           05  OUT-CT-OVLP               PIC X.
           05  FILLER                    PIC X.

       FD  PRINT-FILE
           RECORD CONTAINS 132 CHARACTERS
           DATA RECORD IS PRINTF.
       01  PRINTF                        PIC X(132).

       FD  SHIFT-STRUCTURE-FILE
           LABEL RECORDS ARE STANDARD
           DATA RECORD IS SSFREC.
       01  SSFREC.
           COPY DDS-ALL-FORMATS OF MCFLMM2501.

       SD  SORT-FILE
           RECORD CONTAINS 108 CHARACTERS
           DATA RECORD IS SORTF.
       01  SORTF.
           05  SORT-KEY.
               10  SORT-ZONE             PIC X(4).
               10  SORT-EQTYPE           PIC X(8).
           05  SORT-STATUS               PIC XX.
           05  SORT-EQPNO                PIC X(6).
           05  SORT-WO                   PIC X(10).
           05  SORT-CRAFT-1              PIC XX.
