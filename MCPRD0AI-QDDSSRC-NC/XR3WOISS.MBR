      ***************************************************************
      * FILE NAME : XR3WOISS
      * FILE TYPE : PRINTER FILE
      *
      * PROGRAM   : TR3WOISS
      *
      * PURPOSE   : WORK ORDER UPDATE AUDIT REPORT
      *
      * CREATED   : APR 5, 2005
      * AUTHOR    : DAN RAUCH - EXLTECH, INC
      ***************************************************************
      * SPECIAL NOTES: CREATED PER REQUEST# 2005-05365
      ***************************************************************
     A                                      INDARA
     A          R HEAD01
     A                                      SKIPB(1)
     A            PRTPGM        10A        1
     A            HCMPNY        30A       47
     A                                   115'   Page:'
     A            HPAGE          5  0    124EDTCDE(Z)
      ************************
     A          R HEAD02
     A                                      SKIPB(2)
     A                                     1'RunDate:'
     A            HRDATE        10A       10
     A                                    45'WorkOrder Update Audit Report'
     A                                   115'RunTime:'
     A            HRTIME         8A      124
      ************************
     A          R HEAD03
     A                                      SKIPB(3)
     A                                    47'Sequence#:'
     A            HSEQNO         5S 0     59EDTCDE(Z)
      ************************
     A          R HEAD04
     A                                      SPACEB(3)
     A                                     1'WorkOrder#  '
     A                                       UNDERLINE
     A                                    15'Part Nbr'
     A                                       UNDERLINE
     A                                    25'Item#'
     A                                       UNDERLINE
     A                                    32'IssueQty'
     A                                       UNDERLINE
     A                                    42'Unit Cost       '
     A                                       UNDERLINE
     A                                    60'UoM'
     A                                       UNDERLINE
     A                                    65'Clock#'
     A                                       UNDERLINE
     A                                    74'CstCtr'
     A                                       UNDERLINE
     A                                    84'Status Message                   +
     A                                                    '
     A                                       UNDERLINE
      ***************************************************************
      * Detail Line Format DETAIL
      ***************************************************************
     A          R DETAIL
     A                                      SPACEB(1)
     A            DLWO          12A        1
     A            DLPART         8A       15
     A            DLITEM         4A       25
     A            DLQTY          8A       32
     A            DLUNCS        16A       42
     A            DLUOM          2A       60
     A            DLCLKC         4A       66
     A            DLCSTC         4A       75
     A            DLMSSG        45A       84
      ************************
      * header/trailer format
      ***************************************************************
     A          R HTLINE
     A                                      SPACEB(2)
     A            HTDATA       132A        1
      ***************************************************************
      * TOTAL LINE FORMAT
      ***************************************************************
     A          R TOTAL1
     A                                      SPACEB(2)
     A                                     1'Total Records Processed ....'
     A            TLTOT          5S 0     30EDTCDE(Z)
      ***************************************************************
      * End of Report Banner - Format EOR
      ***************************************************************
     A          R EOR
     A                                      SPACEB(3)
     A                                     2'*** End  of  Report ***'
      ***************************************************************
      *                       END  OF  SOURCE
      ***************************************************************
