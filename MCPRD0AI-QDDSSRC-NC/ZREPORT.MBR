     A  99        MESSAGELN1    79   M      OVRDTA
     A          R R3M
     A                                      PUTOVR
     A  98                                  INVITE
     A                                 10 27'MR3 REPORT BEING CREATED -'
     A                                 11 27'TRY AGAIN IN A FEW MINUTES'
     A            COMMANDLN1    79A  B 24  1OVRDTA
     A  99        MESSAGELN1    79   M      OVRDTA
     A          R ROUTE
     A                                      PUTOVR
     A                                      CF03
     A                                  1 23'*****  ROUTING DATA FOR REPORT  **-
     A                                      ***'
     A                                  4  9'-----------------------------------
     A                                      -------------------------------'
     A                                  5  9':   NAME OF PERSON TO ROUTE REPORT'
     A                                  5 44'TO:'
     A                                  5 73':'
     A                                  6  9':'
     A                                  6 73':'
     A                                  7  9':   DEPARTMENT TO ROUTE REPORT TO:'
     A                                  7 73':'
     A                                  8  9':'
     A                                  8 73':'
     A                                  9  9':   DEVICE NUMBER OF PRINTER ON WH-
     A                                      ICH TO'
     A                                  9 73':'
     A                                 10  9':   PRINT REPORT (NOT SPOOLER NUMB-
     A                                      ER):'
     A                                 10 73':'
     A                                 11  9':   (DEFAULT IS SYSTEM LINE PRINTE-
     A                                      R)'
     A                                 11 73':'
     A                                 12  9':'
     A                                 12 73':'
     A                                 13  9':   ENTER "X" FOR 132 COLUMN PAPER'
     A                                 13 73':'
     A                                 14  9':   (DEFAULT IS 80 COLUMN PAPER)'
     A                                 14 73':'
     A                                 15  9'-----------------------------------
     A                                      -------------------------------'
     A            NAME          15A  B  5 56DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
