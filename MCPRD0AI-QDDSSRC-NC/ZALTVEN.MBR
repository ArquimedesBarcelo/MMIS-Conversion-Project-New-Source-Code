     A          R FALTMENU
     A*%%TS  SD  19950811  131537  A229282     REL-V3R1M0  5763-PW1
     A                                      CF01
     A                                      CF02
     A                                      CF03
     A                                      CF04
     A                                      CF05
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                      PUTOVR
     A                                  1 20'VENDOR CODE ALTERNATE KEY MENU'
     A                                  3  1'This program allows you to add or'
     A                                  3 35'delete alternate keys for vendor c-
     A                                      odes.'
     A                                  4  1'For example, you may wish the name'
     A                                  4 36'BARCO1 to stand for vendor code'
     A                                  5  1'0801056000.'
     A                                  7  1'The ability to see a cross-referen-
     A                                      ce listing between alternate keys a-
     A                                      nd'
     A                                  8  1'vendor codes has been provided.'
     A                                 10  1'The alternate key can be used in t-
     A                                      he Vendor Inquiry (Q6A) to bring up-
     A                                       the'
     A                                 11  1'actual vendor code data.'
     A                                 13  1'Choose one of the following functi-
     A                                      ons:'
     A                                 15 18'f1   TO ADD ALTERNATE KEY'
     A                                 17 18'f2   TO DELETE ALTERNATE KEY'
     A                                 19 18'f7   FOR VENDOR/ALTERNATE CROSS-RE-
     A                                      FERENCE LIST'
     A                                 21 18'f8   FOR VENDOR INQUIRY'
     A            COMMANDLN1    79A  B 24  1DFTVAL('f1-ADD ALT f2-DELETE ALT f7-
     A                                      -CROSS REF f8-VENDOR INQUIRY f3-END-
     A                                       PROGRAM')
     A                                      DSPATR(PR)
     A  98                                  OVRDTA
     A  99        MESSAGELN1    79   M
     A  99                                  OVRDTA
     A          R FALTLST
