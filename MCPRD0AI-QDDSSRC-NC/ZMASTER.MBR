     A                                      CF01
     A                                  1 24'----------------------------------'
     A                                  2 24'. C O P Y    S U B S Y S T E M S .'
     A                                  3 24'----------------------------------'
     A                                  5  8'-----------------------------------
     A                                      -------------------------------'
     A                                  6  8':COPY OLD TYPE NUMBER'
     A                                  6 39'TO NEW TYPE NUMBER'
     A                                  6 67'     :'
     A                                  7  8':'
     A                                  7 72':'
     A                                  8  8':KEY IN 4 DIGIT SUBSYSTEM(S) FOR (-
     A                                      1) OR (2) - KEY IN "A" FOR (3):'
     A                                  9  8'-----------------------------------
     A                                      -------------------------------'
     A                                 12  3'(1) ONE LEVEL     OLD'
     A                                 12 33'COPIES NEXT LEVEL OF SUBSYSTEMS ..-
     A                                      ............'
     A                                 13 26'TO     FOR EXAMPLE : 5100 MEANS CO-
     A                                      PY 5110  5140  5170'
     A                                 14 21'NEW'
     A                                 14 63'5120  5150  5180'
     A                                 15 12'(Defaults to OLD)'
     A                                 15 63'5130  5160  5190'
     A                                 17  3'(2) LOWER LEVELS  OLD'
     A                                 17 33'COPIES ALL LOWER LEVEL SUBSYSTEMS'
     A                                 17 67'............'
     A                                 18 26'TO     FOR EXAMPLE : 5100 MEANS CO-
     A                                      PY ALL ENTRIES THAT'
     A                                 19 21'NEW'
     A                                 19 47'BRANCH FROM 5100'
     A                                 20 12'(Defaults to OLD)'
     A                                 22  3'(3) ALL LEVELS'
     A                                 22 33'COPIES ALL SUBSYSTEMS ............-
     A                                      ............'
     A            TYPE1          8A  B  6 30DSPATR(UL)
