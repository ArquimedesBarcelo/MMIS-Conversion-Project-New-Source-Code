     A*%%EC
     A                                      DSPSIZ(24 80 *DS3)
     A                                      CHGINPDFT
     A                                      PRINT
     A                                      INDARA
     A                                      CA03(03 'END PROGRAM')
     A          R FOLDWODL
     A                                      PUTOVR
     A  98                                  INVITE
     A                                  3 12'ENTER THE DATE YOU WISH TO DELETE -
     A                                      WORK ORDERS PRIOR TO AND'
     A                                  4 18'SELECT WHICH TYPE(S) OF WORK ORDER-
     A                                      S TO DELETE'
     A            WODATE         6A  B  6 26DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  01                                  DSPATR(RI)
     A  01                                  DSPATR(PC)
     A                                  6 34'(FORMAT IS YYMMDD)'
     A            VWO            1A  B  8 31DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  04                                  DSPATR(RI)
     A  04                                  DSPATR(PC)
     A                                      VALUES('N' 'Y')
     A                                  8 33'VERBAL  (Y/N)?'
     A            PWO            1A  B  9 31DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  05                                  DSPATR(RI)
     A  05                                  DSPATR(PC)
     A                                      VALUES('N' 'Y')
     A                                  9 33'PLANNED (Y/N)?'
     A                                 10 33'SUFFIXED WO"S TOO (Y/N)?'
     A            SWO            1A  B 10 31DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  06                                  DSPATR(RI)
     A  06                                  DSPATR(PC)
     A                                      VALUES('N' 'Y')
     A                                 12 33'DO YOU WANT A PRINTOUT OF WO"S '
     A                                 13 35'TO BE DELETED (Y/N)?'
     A            WWO            1A  B 12 31DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  07                                  DSPATR(RI)
     A  07                                  DSPATR(PC)
     A                                      VALUES('N' 'Y')
     A                                 15 23'OPTIONAL RESTRICTIONS TO DELETE BY-
     A                                      :'
     A                                 17 34'ZONE'
     A            WOZONE         4A  B 17 39DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  02                                  DSPATR(RI)
     A  02                                  DSPATR(PC)
     A                                 18 26'EQUIP NUMBER'
     A            EQPNUM         6A  B 18 39DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  03                                  DSPATR(RI)
     A  03                                  DSPATR(PC)
     A                                 19 26'  W/O STATUS'
     A            STATUS         2A  B 19 39DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  04                                  DSPATR(RI)
     A  04                                  DSPATR(PC)
     A                                 22 25'PRESS "F3" TO EXIT PROGRAM'
     A            COMMANDLN     79A  O 24  1OVRDTA
     A  99        MESSAGELN     79   M      OVRDTA
     A          R FOLDWOD2
     A                                      PUTOVR
     A  98                                  INVITE
     A                                  8 13'THERE ARE '
     A                                  8 31'WORK ORDERS THAT ARE DELETEABLE'
     A            WOCTR          6A  B  8 24DSPATR(PR)
     A                                      OVRDTA
     A                                  9 13'CONTINUE WITH THE DELETE - Y/N?'
     A            DELSW          1A  B  9 46DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  01                                  DSPATR(RI)
     A  01                                  DSPATR(PC)
     A                                 13  5'If you want to view a list of the -
     A                                      work orders that will be deleted pr-
     A                                      ior '
     A                                 14  5'to the actual deletion, press the -
     A                                      F3 key now and the listing should p-
     A                                      rint.'
     A                                 15  5'If you want the delete to process,-
     A                                       change the continue flag to a "Y"'
     A                                 16  5'and press enter.'
     A                                 19 25'PRESS "F3" TO EXIT PROGRAM'
     A            COMMANDLN     79A  O 24  1OVRDTA
     A  99        MESSAGELN     79   M      OVRDTA
