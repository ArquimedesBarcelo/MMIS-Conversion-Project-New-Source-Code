     A***************************************************************
     A* FILE NAME : ZDVIAWDW
     A* FILE TYPE : DISPLAY
     A*
     A* PROGRAM   : DISPLAY FILE FOR PGM CPOVIAWDW
     A* PURPOSE   : VIA PROMPT SELECTION WINDOW
     A*
     A* CREATED   : 08/12/2003
     A* AUTHOR    : DAN RAUCH - EXLTECH, INC
     A***************************************************************
     A* SPECIAL NOTES:
     A***************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      PRINT
     A                                      INDARA
     A*******************
     A          R SFL01                     SFL
     A            SFSEL          1A  B  2  2
     A            SFDESC        20A  O  2  4
     A            SFCODE         3A  H
     A*******************
     A          R CTL01                     SFLCTL(SFL01)
     A                                      CF12
     A                                      OVERLAY
     A  71                                  SFLDSP
     A N70                                  SFLDSPCTL
     A  70                                  SFLCLR
     A                                      SFLSIZ(0024)
     A                                      SFLPAG(0012)
     A  72                                  SFLEND
     A                                      WINDOW(6 47 14 24)
     A                                      WDWBORDER((*COLOR BLU))
     A                                      WDWBORDER((*DSPATR RI))
     A                                      WDWBORDER((*CHAR '        '))
     A                                      USRRSTDSP
     A                                      WDWTITLE((*TEXT &TITLE1) *LEFT)
     A                                      WDWTITLE((*TEXT &TITLE2) *LEFT *BOT-
     A                                      TOM)
     A            TITLE1        25A  P
     A            TITLE2        25A  P
     A*===============================================================
     A* DUMMY FMT TO PREVENT ERASING THE CURRENT SCREEN WHEN THE
     A* WINDOW IS DISPLAYED - ASSUME NOT LEGAL IN A WINDOW FMT
     A*===============================================================
     A          R H01
     A                                      ASSUME
     A                                      OVERLAY
     A                                      KEEP
     A                                  3  2' '
