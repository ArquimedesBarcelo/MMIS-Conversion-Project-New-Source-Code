     A*****************************************************************
     A** FILE NAME  :  TARIBA100D
     A**
     A** DESCRIPTION:  DISPLAY FILE TO UPDATE PROCESS/JOBS/DATAQ PARMS
     A**               (MCFPAB1100 MCFPAB1200)
     A**
     A** AUTHOR     :  DAN RAUCH - EXLTECH, INC
     A** CREATED    :  12-16-02
     A**
     A*****************************************************************
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      CHGINPDFT(HI UL)
     A                                      CF03
     A**===============================================================
     A**=== HEADING LINE
     A**===============================================================
     A          R H01
     A            HDDATE        13A  O  1  2
     A                                  1 29'Update Process/Jobs'
     A                                  1 65'Time:'
     A            HDTIME         8A  O  1 71
     A**===============================================================
     A**=== PROCESSES SUBFILE
     A**===============================================================
     A          R SFL01                     SFL
     A  86                                  SFLNXTCHG
     A            SEL            1A  B  7 21ALIAS(SELECT_FLD)
     A            PROCESS       10A  O  7 28ALIAS(PROCESS_NAME)
     A            JOB           10A  O  7 42ALIAS(JOB_NAME)
     A  40                                  COLOR(WHT)
     A            CALLFLAG       1A  O  7 58ALIAS(JOB_CALL_FLAG)
     A  41                                  COLOR(WHT)
     A**===============================================================
     A**=== PROCESSES CONTROL RECORD
     A**===============================================================
     A          R CTL01                     SFLCTL(SFL01)
     A*%%TS  SD  20040714  150011  Z010830     REL-V5R2M0  5722-WDS
     A                                      SFLSIZ(9999)
     A                                      SFLPAG(0014)
     A                                      CF06
     A                                      CF10
     A                                      OVERLAY
     A  85                                  SFLDSP
     A  84                                  SFLCLR
     A                                      SFLDSPCTL
     A  83                                  SFLEND(*MORE)
     A            CRRN           4S 0H      SFLRCDNBR(CURSOR *TOP)
     A            CREC          10A  H
     A            CFLD          10A  H
     A                                  3 14'List of Processes - Select(X) to U-
     A                                      pdate'
     A                                  4 40'(D) to Delete'
     A                                  6 20'Sel'
     A                                      DSPATR(UL)
     A                                  6 27'Process Name'
     A                                      DSPATR(UL)
     A                                  6 42'Job Name  '
     A                                      DSPATR(UL)
     A                                  6 54'CallFlag'
     A                                      DSPATR(UL)
     A**===============================================================
     A**=== maint screen
     A**===============================================================
     A          R S02
     A*%%TS  SD  20030304  124209  Z010830     REL-V5R2M0  5722-WDS
     A                                      CF12
     A                                      OVERLAY
     A                                  6  4'Process Name:'
     A            PROCESS       10A  B  6 18ALIAS(PROCESS_NAME)
     A  50                                  DSPATR(RI)
     A  50                                  COLOR(RED)
     A                                  6 33'Process is Active:'
     A            ACTIVEFL       1A  B  6 52ALIAS(ACTIVE_FLAG)
     A  51                                  DSPATR(PC)
     A  51                                  DSPATR(RI)
     A  51                                  COLOR(RED)
     A                                  6 54'(Y/N)'
     A                                  8  4'JobName:'
     A            JOBNAME       10A  B  8 13ALIAS(JOB_NAME)
     A  52                                  DSPATR(PC)
     A  52                                  DSPATR(RI)
     A  52                                  COLOR(RED)
     A                                  8 28'JobDesc:'
     A            JOBDESC       10A  B  8 37ALIAS(JOB_DESC)
     A  53                                  DSPATR(PC)
     A  53                                  DSPATR(RI)
     A  53                                  COLOR(RED)
     A                                  8 53'JobProg:'
     A            JOBPROG       10A  B  8 62ALIAS(JOB_PROGRAM)
     A  54                                  DSPATR(PC)
     A  54                                  DSPATR(RI)
     A  54                                  COLOR(RED)
     A                                 10  4'Job CallFlag:'
     A                                      DSPATR(HI)
     A            JOBCALL        1A  B 10 18ALIAS(JOB_CALL_FLAG)
     A  56                                  DSPATR(PC)
     A  56                                  DSPATR(RI)
     A  56                                  COLOR(RED)
     A                                 10 28'JobType:'
     A            JOBTYPE        1A  B 10 37ALIAS(JOB_TYPE)
     A  55                                  DSPATR(PC)
     A  55                                  DSPATR(RI)
     A  55                                  COLOR(RED)
     A                                 10 39'(I/B = Interactive/Batch)'
     A                                 11 28'Interactive is CALLED/Batch is SUB-
     A                                      MITTED'
     A                                      DSPATR(HI)
     A                                 13  4'**********************************-
     A                                      ***********************************-
     A                                      *****'
     A                                      DSPATR(RI)
     A                                 14  4'*'
     A                                      DSPATR(RI)
     A                                 14 77'*'
     A                                      DSPATR(RI)
     A                                 15  4'*'
     A                                      DSPATR(RI)
     A                                 15  6'The JobCall Flag determines whethe-
     A                                      r the job runs or not. To disable  '
     A                                 15 77'*'
     A                                      DSPATR(RI)
     A                                 16  4'*'
     A                                      DSPATR(RI)
     A                                 16  6'a job and prevent it from running,-
     A                                       enter N.''                        -
     A                                       '
     A                                 16 77'*'
     A                                      DSPATR(RI)
     A                                 17  4'*'
     A                                      DSPATR(RI)
     A                                 17 77'*'
     A                                      DSPATR(RI)
     A                                 18  4'**********************************-
     A                                      ***********************************-
     A                                      *****'
     A                                      DSPATR(RI)
     A**===============================================================
     A**=== PROCESSES MESSAGE LINE - SFL
     A**===============================================================
     A          R B01
     A                                      OVERLAY
     A            MSSG          78A  O 22  2
     A  99                                  DSPATR(RI)
     A  99                                  COLOR(RED)
     A                                 23  2'F3-Exit   F10-DataQ   F6-Add'
     A                                      COLOR(BLU)
     A**===============================================================
     A**=== PROCESSES MESSAGE LINE - S02
     A**===============================================================
     A          R B02
     A                                            OVERLAY
     A                                 23  2'F3-Exit   F12-Cancel'
     A                                      COLOR(BLU)
     A            MSSG          78   O 22  2
     A  99                                  DSPATR(RI)
     A  99                                  COLOR(RED)
