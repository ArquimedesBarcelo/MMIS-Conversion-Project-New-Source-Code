      ***************************************************************
      * FILE NAME : XARBEXCP2
      * FILE TYPE : PRINTER FILE
      *
      * PROGRAM   : TARBEXCP2
      *
      * PURPOSE   : CATALOG SOURCING EXCEPTION REPORT
      *
      * CREATED   : 12/16/2003
      * AUTHOR    : DAN RAUCH - EXLTECH, LLC
      ***************************************************************
      * SPECIAL NOTES:
      ***************************************************************
     A                                      INDARA
     A          R HEAD01
     A                                      SKIPB(1)
     A            HDPROG        10A        1
     A                                    20'Plant:'
     A            HDPLNT        20A       27
     A                                    65'THE GOODYEAR TIRE & RUBBER COMPANY'
     A                                   115'   Page:'
     A            HDPAGE         5  0    124EDTCDE(Z)
      ************************
     A          R HEAD02
     A                                      SKIPB(2)
     A                                     1'RunDate:'
     A            HDRDAT        10A       10
     A                                    65'Catalog Sourcing Exception Report'
     A                                   115'RunTime:'
     A            HDRTIM         8A      124
      ************************
     A          R HEAD03
     A                                      SKIPB(6)
     A                                    16'CorpCode'
     A                                      UNDERLINE
     A                                    26'Manufacturer Name             '
     A                                      UNDERLINE
     A                                    58'Manufacturer Part Nbr'
     A                                      UNDERLINE
     A                                    81'Preferred '
     A                                      UNDERLINE
     A                                    95'Type'
     A                                      UNDERLINE
      ***************************************************************
      * Detail Line Format for ARIBABUYER CATALOG DATA
      ***************************************************************
     A          R DETAIL1
     A                                      SPACEB(1)
     A                                     1'         CSIS: '
     A            DL1CC          8A       16
     A            DL1NAME       30A       26
     A            DL1PART       20A       58
     A            DL1SEL         1A       85
     A            DL1TYPE        1A       96
     A****
     A          R DETAIL2
     A                                      SPACEB(1)
     A                                     1'ARIBA CATALOG: '
     A            DL2CC          8A       16
     A            DL2NAME       30A       26
     A            DL2PART       30A       58
     A                                      SPACEA(1)
      ***************************************************************
      * TOTAL LINE FORMAT
      ***************************************************************
     A          R TOTAL1
     A                                      SPACEB(1)
     A                                     1'DMANPART Records READ .......'
     A            TLREAD         7S 0     31EDTCDE(1)
     A                                      SPACEA(1)
     A                                     1'DMANPART Records PRINTED ....'
     A            TLPRNT         7S 0     31EDTCDE(1)
      ***************************************************************
      * WRITE A BLANK LINE
      ***************************************************************
     A          R BLANK1
     A                                      SPACEB(1)
     A                                     1' '
      ***************************************************************
      * End of Report Banner - Format EOR
      ***************************************************************
     A          R EOR
     A                                      SPACEB(2)
     A                                     2'*** End  of  Report ***'
      ***************************************************************
      *                       END  OF  SOURCE
      ***************************************************************
