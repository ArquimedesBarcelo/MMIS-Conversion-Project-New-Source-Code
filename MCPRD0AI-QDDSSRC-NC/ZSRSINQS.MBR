     A                                      DSPATR(HI)
     A                                      DSPATR(BL)
     A                                      OVRDTA
     A            COMMANDLN1    79A  B 24  1DFTVAL('f1-RECEIVER f2-FREIGHT f4-R-
     A                                      CVR CORRECTIONS f6-SWITCH DATABASES-
     A                                       f7-CLEAR f3-END')
     A                                      DSPATR(PR)
