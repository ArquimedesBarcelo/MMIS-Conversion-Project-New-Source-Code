     A                                      CF03
     A                                      CF04
     A                                      CF05
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                  1 14'REQUISITION INQUIRY/APPROVAL HELP'
     A                                  1 48'SCREEN'
     A                                  1 61'3 OF 6'
     A                                  4  1'EXCLUDE UNAPPROVED'
     A                                  4 27'-  Excludes all reqs not yet appro-
     A                                      ved from the'
     A                                  5 30'inquiry.  This leaves only those i-
     A                                      n purchasing'
     A                                  6 30'or on a PO.'
     A                                  8  1'EXCLUDE IN PURCHASING     -  Exclu-
     A                                      des all reqs in purchasing.  Leaves-
     A                                       unapproved'
     A                                  9 30'or on a PO.'
     A                                 11  1'EXCLUDE ON PO'
     A                                 11 27'-  Excludes all reqs on a PO.  Lea-
     A                                      ves only unapproved'
     A                                 12 30'or in purchasing.'
     A                                 14  1'EXCLUDE REQS YOU APPROVED -  Norma-
     A                                      lly used by approvers.  Approvers'
     A                                 14 69'want to see'
     A                                 15 30'only those reqs they need to appro-
     A                                      ve.  A req may'
     A                                 16 30'be in an unapproved state, but alr-
     A                                      eady approved'
     A                                 17 30'by that person.  This lets him avo-
     A                                      id looking at'
     A                                 18 30'those reqs he has already approved-
     A                                      .'
     A            COMMANDLN1    79A  B 24  1DFTVAL('F1-PREV F2-NEXT            -
     A                                                                         -
     A                                                       ')
     A                                      DSPATR(PR)
     A  98                                  OVRDTA
     A  99        MESSAGELN1    79   M
