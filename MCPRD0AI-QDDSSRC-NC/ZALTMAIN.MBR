     A                                  1 22'ADD AN ALTERNATE KEY'
     A                                  5  1'Type the alternate key and the cor-
     A                                      porate code for that alternate key.-
     A                                        The'
     A                                  6  1'corporate code must exist in the s-
     A                                      tores database.  The alternate key'
     A                                  6 70'must'
     A                                  7  1'not already exist.'
     A                                 10 17'ALTERNATE KEY    CORP CODE'
     A            ALTKEY        12A  B 11 18DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  01                                  DSPATR(RI)
     A  01                                  DSPATR(PC)
     A            CODE           7A  B 11 35DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  02                                  DSPATR(RI)
     A  02                                  DSPATR(PC)
     A            COMMANDLN1    79A  B 24  1DFTVAL('f7-EXIT f3-END PROGRAM     -
     A                                                                         -
     A                                                       ')
     A                                      DSPATR(PR)
     A  98                                  OVRDTA
     A  99        MESSAGELN1    79   M
     A  99                                  OVRDTA
     A          R FALTDEL
     A                                      PUTOVR
     A                                      CF01
     A                                      CF02
     A                                      CF03
     A                                      CF04
     A                                      CF05
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                  1 18'DELETE AN ALTERNATE KEY'
     A                                  4  9'Type the alternate key to delete a-
     A                                      nd press "enter":'
     A            ALTKEY        12A  B  6 10DSPATR(UL)
     A                                      OVRDTA
     A                                      OVRATR
     A  01                                  DSPATR(RI)
     A  01                                  DSPATR(PC)
     A            DUMMYCD        7A  B  9  9DSPATR(PR)
     A                                      OVRDTA
     A            COMMANDLN1    79A  B 24  1DFTVAL('f7-EXIT f3-END PROGRAM     -
     A                                                                         -
     A                                                       ')
     A                                      DSPATR(PR)
     A  98                                  OVRDTA
     A  99        MESSAGELN1    79   M
