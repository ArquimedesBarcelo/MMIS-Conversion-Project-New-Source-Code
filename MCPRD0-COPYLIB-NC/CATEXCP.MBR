      **************************************************************
      ****  ARIBA CATALOG EXCEPTION FILE LAYOUT - MCFPAB1600
      **************************************************************
       01  BUF-CATEXCP.
      *--------------------------
      *-- PO & REQ DATA
      *--------------------------
           03  CATEXCP-REQ-NO               PIC X(12)  VALUE SPACES.
           03  CATEXCP-CORP-CODE            PIC X(10)  VALUE SPACES.
           03  CATEXCP-PO-PLANT             PIC X(04)  VALUE SPACES.
           03  CATEXCP-USER-ID              PIC X(08)  VALUE SPACES.
           03  CATEXCP-REQ-QTY              PIC S9(8)V9(4) VALUE ZEROS.
           03  CATEXCP-REQ-QTY-UM           PIC X(02)  VALUE SPACES.
      *----------------------------------------------------------------
      *-- PREFERRED ITEM DATA - LOWEST PRICE
      *-- WHAT SHOULD'VE BEEN ORDERED
      *----------------------------------------------------------------
           03  CATEXCP-PRF-MANF-NAME        PIC X(50)  VALUE SPACES.
           03  CATEXCP-PRF-MANF-PART        PIC X(50)  VALUE SPACES.
           03  CATEXCP-PRF-VENDOR-ID        PIC X(10)  VALUE SPACES.
           03  CATEXCP-PRF-VENDOR-PART      PIC X(50)  VALUE SPACES.
           03  CATEXCP-PRF-VENDOR-AUXID     PIC X(50)  VALUE SPACES.
           03  CATEXCP-PRF-VENDOR-PRICE
                                 PIC S9(11)V9(4) COMP-3 VALUE ZEROS.
           03  CATEXCP-PRF-VENDOR-CURR-CD   PIC X(02)  VALUE SPACES.
      *----------------------------------------------------------------
      *-- EXCEPTION ITEM DATA - OTHER THAN THE LOWEST PRICE
      *-- WHAT ACTUALLY WAS ORDERED
      *----------------------------------------------------------------
           03  CATEXCP-EXP-MANF-NAME        PIC X(50)  VALUE SPACES.
           03  CATEXCP-EXP-MANF-PART        PIC X(50)  VALUE SPACES.
           03  CATEXCP-EXP-VENDOR-ID        PIC X(10)  VALUE SPACES.
           03  CATEXCP-EXP-VENDOR-PART      PIC X(50)  VALUE SPACES.
           03  CATEXCP-EXP-VENDOR-AUXID     PIC X(50)  VALUE SPACES.
           03  CATEXCP-EXP-VENDOR-PRICE
                                 PIC S9(11)V9(4) COMP-3 VALUE ZEROS.
           03  CATEXCP-EXP-VENDOR-CURR-CD   PIC X(02)  VALUE SPACES.
      *--------------------------
      *-- MISCELLANEOUS ITEM
      *--------------------------
           03  CATEXCP-QTY-ORDERED          PIC S9(8)V9(4) VALUE ZEROS.
           03  CATEXCP-REASON-CD            PIC X(04)  VALUE SPACES.
           03  CATEXCP-REASON-TEXT          PIC X(80)  VALUE SPACES.
           03  CATEXCP-DATETIME-STAMP       PIC X(14)  VALUE SPACES.
