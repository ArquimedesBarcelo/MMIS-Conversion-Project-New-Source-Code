      *****************************************************************
      **  COBOL COPY MBR FOR ARIBA CATALOG FILE    -  MCFPAB2000
      *****************************************************************
       01  BUF-DARIBCAT.
           03  ARIBACAT-CORP-CODE       PIC X(10)     VALUE SPACE.
           03  ARIBACAT-MANUFACT-NAME   PIC X(50)     VALUE SPACE.
           03  ARIBACAT-MANUFACT-PARTNO PIC X(50)     VALUE SPACE.
           03  ARIBACAT-VENDOR-CODE     PIC X(10)     VALUE SPACE.
           03  ARIBACAT-VENDOR-PARTNO   PIC X(50)     VALUE SPACE.
           03  ARIBACAT-VENDOR-AUXID    PIC X(50)     VALUE SPACE.
           03  ARIBACAT-VENDOR-PRICE  PIC S9(11)V9999 COMP-3 VALUE +0.
           03  ARIBACAT-CONVER-PRICE  PIC S9(11)V9999 COMP-3 VALUE +0.
           03  ARIBACAT-EMPTY-PRICE   PIC S9(11)V9999 COMP-3 VALUE +0.
           03  ARIBACAT-VENDOR-UM       PIC X(02)     VALUE SPACE.
           03  ARIBACAT-STOREROOM-UM    PIC X(02)     VALUE SPACE.
           03  ARIBACAT-QTY-UM          PIC X(02)     VALUE SPACE.
           03  ARIBACAT-CURR-CODE       PIC X(02)     VALUE SPACE.
           03  ARIBACAT-HOME-CURR-CODE  PIC X(02)     VALUE SPACE.
           03  ARIBACAT-PREF-FLAG       PIC X(01)     VALUE SPACE.
           03  ARIBACAT-OVRD-FLAG       PIC X(01)     VALUE SPACE.
           03  ARIBACAT-REASON-CODE     PIC X(04)     VALUE SPACE.
           03  ARIBACAT-DATE-TIME-STMP  PIC X(14)     VALUE SPACE.
           03  FILLER                   PIC X(04)     VALUE SPACE.
